use flake

# Nx runs 3 tasks at once by default, which leaves most of a workstation idle. Half the cores, at least 3.
# Local only: CI does not load direnv and keeps the default on its 4-core runners.
nx_parallel=$(( $(getconf _NPROCESSORS_ONLN) / 2 ))
export NX_PARALLEL=$(( nx_parallel > 3 ? nx_parallel : 3 ))
unset nx_parallel
