    {
      "type": "entry",
      "pack": "revenge-of-the-runelords",
      "slug": "feat:dreamers-calling",
      "foundry": "Compendium.pf2e.classfeatures.Item.HnUzQqmAphx9nXDt",
      "leftOut": {
        "reason": "no-kind-data",
        "detail": ""
