        "page": 44
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cheliax is your home, but Asmodeus is not your god. Though other faiths are tolerated by House Thrune, they're not exactly encouraged—so you, and those like you, are well practiced in keeping your true beliefs as secret as possible."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Intelligence",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Wisdom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Occultism skill and the Lore skill associated with the deity or other belief system you follow. You gain the "
          },
          {
            "type": "ref",
            "id": "4516c9da-3155-5ae4-9a11-3b7b8d927234"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:occultism",
        "rank": "trained"
      },
      {
