          {
            "type": "text",
            "text": "Charisma",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Devil Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "9d07cbf8-95d1-5bad-9bc6-5f1b73aaacde"
