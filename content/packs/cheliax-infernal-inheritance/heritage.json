    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your body proves that shadow can't exist without light. Perhaps your eyes glow brighter or your veins occasionally pulse with light. You emit dim light within 5 feet of you. You can activate or suppress this ability with a Sustain action. Additionally, you can force fragments of your shadow to glow and even partially solidify, allowing you to cast "
          },
          {
            "type": "ref",
            "id": "b0b84836-b7a0-59ca-9379-6efdfb022f9e"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "6dee4f5d-f584-5402-af2a-d3738ec685b3"
          },
          {
            "type": "text",
            "text": " as occult innate cantrips. Cantrips are heightened to a spell rank equal to half your level rounded up."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:bright-fetchling",
        "toggleable": true
      }
    ],
    "externalIds": {
