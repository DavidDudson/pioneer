          {
            "type": "check",
            "statistic": "flat",
            "dc": 3
          },
          {
            "type": "text",
            "text": " instead of DC 5, and your flat check to target undetected creatures is "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 9
          },
          {
            "type": "text",
            "text": " instead of DC 11."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["perception"],
        "type": "circumstance",
