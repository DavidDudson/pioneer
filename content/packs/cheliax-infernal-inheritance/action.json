  {
    "id": "502bd72a-2497-57be-b2d1-8d07205ff0bd",
    "pack": "cheliax-infernal-inheritance",
    "kind": "action",
    "slug": "action:shadowbound-shadow-form",
    "name": "(Shadowbound) Shadow Form",
    "rarity": "common",
    "traits": ["concentrate", "polymorph", "shadow"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A shadowbound creature can assume a shadowy form. In this state, the creature gains the incorporeal trait. It has resistance 10 to all damage (except force, ghost touch, spirit, or vitality; double resistance vs. non-magical), is immune to precision damage, and can't use any actions with the attack or manipulate trait. It has a fly Speed of 15 feet and can slip through tiny cracks. The shadowbound creature can Dismiss this effect to become solid again, but if it does so in an area of bright light, it's "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 1"
          },
          {
            "type": "text",
            "text": " for 1 round."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:shadow-form",
        "toggleable": true
      },
      {
        "key": "FlatModifier",
        "selectors": ["fly-speed"],
        "type": "untyped",
        "value": 15,
        "predicate": ["option:shadow-form"]
      },
      {
        "key": "ActorTraits",
        "add": ["incorporeal"],
        "predicate": ["option:shadow-form"]
      },
      {
        "key": "Immunity",
        "type": ["precision"],
        "predicate": ["option:shadow-form"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.AcLI8InNjZrgj0Ii"
    },
    "data": {
      "cost": "three",
      "category": "offensive"
    }
