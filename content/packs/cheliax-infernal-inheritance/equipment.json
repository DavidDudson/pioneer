          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're submerged in water or another liquid"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You rapidly surface, rising 60 feet at the end of each of your turns. Once you reach the liquid's surface, you can't dive or sink for the next 10 minutes, and a creature that attempts to pull you beneath the surface must first succeed at a "
          },
          {
            "type": "check",
            "statistic": "skill:athletics",
            "dc": 17
          },
          {
            "type": "text",
            "text": " check."
