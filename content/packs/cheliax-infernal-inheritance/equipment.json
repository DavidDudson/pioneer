  {
    "id": "cd49aabe-857c-5a45-aee5-10a54b021712",
    "pack": "cheliax-infernal-inheritance",
    "kind": "equipment",
    "slug": "equipment:limitless-power",
    "name": "Limitless Power",
    "level": 24,
    "rarity": "rare",
    "traits": ["artifact", "contract", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each of these "
          },
          {
            "type": "text",
            "text": "bargained contracts",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is unique, matching the contracted's idea of unlimited power. When you gain this contract, select one weapon in your possession, a common divine cantrip, and one common divine spell of each spell rank except 10th. The weapon becomes a +4 greater striking weapon. Once per day, from any distance, when you Activate this contract or Strike with the selected weapon, the devil who holds your bargained contract can call upon their divine right as a free action to have the spell or Strike target you or have its area centered on you instead of its intended targets."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Unholy Demand",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per week"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You call upon a right of self-determination article in your contract. The contract casts manifestation (spell attack modifier +30, DC 40). Your contractor is immediately made aware of which spell you are duplicating."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Unleash Power",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " to "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The contract casts one of the selected spells (spell attack modifier +30, DC 40). The contract can cast each non-cantrip spell only once per day. You use the same number of actions for this activation as the selected spell normally takes."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Destruction",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The contract bursts into flame if the devil who signed it is slain and a celestial of equal or higher level declares it void."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.yDhHyuSrKudYuVNk"
    },
    "data": {
      "bulk": "negligible",
      "activations": [
        {
          "slug": "unholy-demand",
          "name": "Unholy Demand",
          "frequency": {
            "max": 1,
            "per": "week"
          }
        }
