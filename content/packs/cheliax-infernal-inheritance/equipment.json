      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This bracelet resembles a string of pearls filled with swirling air, making you more buoyant. While wearing the bracelet, you gain a +1 item bonus to Athletics checks to Swim."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Float",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
