[
  {
    "id": "bf8ddeba-a3df-51b6-84bb-ad353f7ea246",
    "pack": "cheliax-infernal-inheritance",
    "kind": "equipment",
    "slug": "equipment:accursed-fame",
    "name": "Accursed Fame",
    "level": 16,
    "rarity": "rare",
    "traits": ["contract", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Infernal tongues spread word of your great deeds. Creatures that would have an initial attitude toward you other than hostile have their attitude improved by one step. Once per day, from any distance, the devil who holds your bargained contract can cite a defamation clause, rendering you unable to speak for 1 hour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Entreat Crowd",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, emotion, magical, manipulate, mental, subtle)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You invoke a due diligence stipulation in your contract. Attempt a Diplomacy check to make a Request of the creature with the highest Will DC within 100 feet who isn't your ally; the GM might have you make a Request of the most influential creature instead. The result applies to all creatures within 100 feet that can understand you."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.K56D9h1Wrm6Ej2bY"
