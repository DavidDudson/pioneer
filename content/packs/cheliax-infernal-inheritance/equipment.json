  {
    "id": "2b7c6ed5-b530-5d57-aafa-2fcc80568ede",
    "pack": "cheliax-infernal-inheritance",
    "kind": "equipment",
    "slug": "equipment:lily-pad-platform",
    "name": "Lily Pad Platform",
    "level": 6,
    "rarity": "common",
    "traits": ["magical", "wood"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Popular among smugglers and other sailors of ill repute, this unassuming palm-sized wooden lily pad or lotus leaf expands on command, forming a floating platform."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Expand",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You place the lily pad platform on the surface of a body of water at least 60 feet deep. It instantly unfolds into a flat platform that fills a "
          },
          {
            "type": "template",
            "shape": "burst",
            "size": 20
          },
          {
            "type": "text",
            "text": " or the entire body of water, whichever is smaller. Any creatures or items in the area are lifted on top of it, and it's anchored in place, unmoved by the current. You can use a single action with the auditory trait to instantly return the lily pad platform to its original size, dropping any items or creatures on it into the water. This happens automatically if the total Bulk of items and creatures on the lily pad platform exceeds 100 Bulk."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Plunge",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, auditory)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The lily pad platform is expanded"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The lily pad platform wraps around everything on top of it and plunges 60 feet beneath the surface for 1 hour, after which it returns to the surface. While submerged, items take no damage from the water, and creatures can breathe normally but are engulfed (Escape)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.L29VpwwfdMdpHVYP"
    },
