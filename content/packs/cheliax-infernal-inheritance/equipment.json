  {
    "id": "7a54c787-7b4e-5508-a5ad-21f98f71cfed",
    "pack": "cheliax-infernal-inheritance",
    "kind": "equipment",
    "slug": "equipment:embedded-eye",
    "name": "Embedded Eye",
    "level": 3,
    "rarity": "common",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This small metal ring, originally a construct's eye, has been repurposed to interface with living beings."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Automaton's Sight",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You hold the embedded eye against the skin of your forehead or elsewhere on your face and it embeds itself in place, linking telepathically with your mind. For the next hour, you gain a +1 status bonus to saving throws against visual effects and to checks you make to disbelieve illusions. At the end of the duration, the eye is no longer embedded in your skin."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.CkKplUCM4oraOLRJ"
