  {
    "id": "4ca2c8d0-9ac3-5ec4-b1fb-89a5ee942a27",
    "pack": "cheliax-infernal-inheritance",
    "kind": "equipment",
    "slug": "equipment:illicit-knowledge",
    "name": "Illicit Knowledge",
    "level": 7,
    "rarity": "rare",
    "traits": ["contract", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "cheliax-infernal-inheritance"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Devils have learned much in their eternal lives, and you have access to some of their secrets. You gain the Additional Lore feat for Devil Lore, and during your daily preparations, you become trained in two Lore skills of your choice. Since these effects are temporary, you can't use them as prerequisites. Once per day, from any distance, the devil who holds your bargained contract can invoke an evidence concealment clause as a single action with the concentrate trait, leaving you "
          },
          {
            "type": "ref",
            "id": "9e1dad43-36fe-5629-923f-2df63c12d90f",
            "label": "Stupefied 2"
          },
          {
            "type": "text",
            "text": " for 1 hour; you can't reduce the value of this condition by any means."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Delve Infernal Records",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You cite your contract's discovery of evidence clause. The contract casts "
          },
          {
            "type": "ref",
            "id": "22b62dab-5ef5-5d09-8c09-2f7bcfc88be1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
