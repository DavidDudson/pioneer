            "type": "ref",
            "id": "ad3bed02-6064-56d1-949c-7f5b8355cee7"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "b0b84836-b7a0-59ca-9379-6efdfb022f9e"
          },
          {
            "type": "text",
            "text": ". The "
