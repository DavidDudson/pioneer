  {
    "id": "2726e245-0c65-599f-855a-3077f9bacf65",
    "pack": "book-of-the-dead",
    "kind": "equipment",
    "slug": "equipment:ladys-chalice",
    "name": "Lady's Chalice",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["divine", "good"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This silver chalice bears the symbol of Pharasma, a swirling cloud that transforms into a flight of whippoorwills that encircle the top. The chalice can be activated in one of two ways, though only once per day total."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The chalice fills with a single vial's worth of "
          },
          {
            "type": "ref",
            "id": "69117d38-92e5-5416-a51f-8dddf680e9d7"
          },
          {
            "type": "text",
            "text": ". The water loses its potency after 1 day if poured into any container other than a font specifically sanctified by a cleric of Pharasma. It similarly loses its potency 1 day after being removed from such a font."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Strike"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The "
          },
          {
            "type": "text",
            "text": "Lady's Chalice",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is full of a vial's worth of "
          },
          {
            "type": "text",
            "text": "holy water",
            "marks": ["emphasis"]
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The chalice splashes a spiral of "
          },
          {
            "type": "text",
            "text": "holy water",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " into an adjacent space. This is a simple thrown weapon with a range of 5 feet. Unlike an alchemical bomb, it doesn't add the manipulate trait to the attack made with it. If it hits, it deals 2d6 spirit damage and 2 spirit splash damage (including to you, if you're evil)."
          }
        ]
      }
    ],
    "rules": [],
