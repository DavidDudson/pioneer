  {
    "id": "d2d92746-8265-588d-8143-2a39838b3611",
    "pack": "book-of-the-dead",
    "kind": "equipment",
    "slug": "equipment:grim-ring",
    "name": "Grim Ring",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["detection", "divine", "invested"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This golden ring is sculpted with the visage of a grinning skull on the side. While wearing the ring, you can attempt to detect the presence of undead creatures as an exploration activity. This reveals the presence or absence of undead in the area, but it doesn't pinpoint their locations. This ring can't detect undead whose appearance is masked by any illusion spell that is 2nd level or higher. If an undead is hiding or disguised, the GM rolls a secret Perception check for you against the undead's Stealth or Deception DC, as appropriate, with a +2 item bonus to your check."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " envision (vitality)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain the "
          },
          {
            "type": "ref",
            "id": "fa3d4a94-c2f9-519b-b0a3-82d2612e188b"
          },
          {
            "type": "text",
            "text": " condition from an undead creature"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Reduce the value of the drained condition you gain by 1, and the undead that caused the condition takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "damageType": "vitality"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.xdpP0y4EfRf0ALl8"
    },
