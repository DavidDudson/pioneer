  {
    "id": "2398ff95-5a02-5962-89b8-dd746ee5db88",
    "pack": "book-of-the-dead",
    "kind": "weapon",
    "slug": "weapon:bottled-sunlight-greater",
    "name": "Bottled Sunlight (Greater)",
    "level": 12,
    "rarity": "common",
    "traits": ["alchemical", "bomb", "consumable", "fire", "light", "splash", "vitality"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This mirrored bottle contains various chemicals dissolved in two immiscible solvents. Shaking the bottle induces chemical reactions that cause it to glow. For 1 hour, the bottle sheds bright light in a 20-foot radius (and dim light to the next 40 feet)."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "During this hour, it can be thrown like a bomb. This requires a single action to Activate with a Strike, like other bombs, and deals the damage below. If it's not thrown within an hour of the first activation, it defuses harmlessly and is consumed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The bomb deals 3d4 vitality damage and 3 vitality splash damage, as well as 3d4 additional fire damage. As normal, vitality damage harms only undead and other creatures with void healing. Undead with a particular vulnerability to sunlight (such as vampires or wraiths) take the maximum amount of vitality damage from bottled sunlight ("
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "12",
                "damageType": "vitality"
              }
            ]
          },
          {
            "type": "text",
            "text": " instead of 3d4). For any ability that depends on the number of weapon dice bottled sunlight has, count only the vitality damage dice"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.AH0u9DDvs4napvdh"
    },
