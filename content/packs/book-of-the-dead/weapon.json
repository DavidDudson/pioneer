  {
    "id": "31da8f46-1560-52d0-ba6c-0117f98ef7eb",
    "pack": "book-of-the-dead",
    "kind": "weapon",
    "slug": "weapon:celestial-peachwood-sword",
    "name": "Celestial Peachwood Sword",
    "level": 17,
    "rarity": "rare",
    "traits": ["agile", "finesse", "good", "holy", "magical", "versatile-s", "vitality"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "From blade to pommel, this sword is carved from a branch of the now-extinct celestial peach tree. The blade of this"
          },
          {
            "type": "text",
            "text": "+3 greater striking ",
            "marks": ["emphasis"]
          },
          {
            "type": "ref",
            "id": "a72b2447-9c26-5cbc-8e32-faf70da03909"
          },
          {
            "type": "text",
            "text": " ",
            "marks": ["emphasis"]
          },
          {
            "type": "ref",
            "id": "1c942139-39ff-5ab6-bccc-88a68a1ec2e6"
          },
          {
            "type": "text",
            "text": " shortsword",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " has ancient runes that can permanently destroy the most powerful undead - if you are willing to pay the price."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An undead creature of 12th level or lower that takes damage from a Strike with the sword takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d6",
                "damageType": "vitality"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 35,
            "basic": true
          },
          {
            "type": "text",
            "text": "). This damage is separate from the Strike itself and isn't included in any effect based on the Strike's damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You critically hit an undead creature with the celestial peachwood sword"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 35
          },
          {
            "type": "text",
            "text": " or be destroyed. If the undead fails its saving throw and is destroyed, you suffer a backlash, taking "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "void"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage per level of the destroyed undead."
          }
        ]
      }
    ],
    "rules": [],
