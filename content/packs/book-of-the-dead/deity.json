    "kind": "deity",
    "slug": "deity:set",
    "name": "Set",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Set is the most reviled of all the Ancient Osirian pantheon. He is the encroaching desert, the invader, the sandstorm destroying everything in its path, as well as the dead who rise from their graves."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Edicts",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Bring chaos to society, murder those who stand in your way, defeat your foes with personal strength and cunning"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Anathema",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Refuse to fight your own battles, destroy a soul instead of turning it to undeath"
          }
        ]
      }
    ],
