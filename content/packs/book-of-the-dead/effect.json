[
  {
    "id": "3935c7d0-75d8-5480-888a-3fccd0ba9acd",
    "pack": "book-of-the-dead",
    "kind": "effect",
    "slug": "effect:effect-bone-swarm",
    "name": "Effect: Bone Swarm",
    "level": 1,
    "rarity": "common",
    "traits": ["polymorph"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You become Huge, gain the swarm trait, and gain a fly Speed of 40 feet. As a swarm, you have the following characteristics."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You are immune to the "
                },
                {
                  "type": "ref",
                  "id": "cab530ff-ca20-5f0a-8a5e-b9fdb322b146"
                },
                {
                  "type": "text",
                  "text": ", "
                },
                {
                  "type": "ref",
                  "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
                },
                {
                  "type": "text",
                  "text": ", and "
                },
                {
                  "type": "ref",
                  "id": "b374c4c9-d230-5167-8878-38e08932a071"
                },
                {
                  "type": "text",
                  "text": " conditions."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You have weakness 5 to area and splash damage."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You can occupy the same space as other creatures and must do so to use your damaging ability."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As a 2-action activity, you can deal "
                },
                {
                  "type": "damage",
                  "instances": [
                    {
                      "formula": "10d6",
                      "damageType": "bludgeoning"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " damage to all creatures sharing your space ("
                },
                {
                  "type": "check",
                  "statistic": "save:reflex",
                  "basic": true
                },
                {
                  "type": "text",
                  "text": " save with a DC equal to your class DC or spell DC, whichever is higher)."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You can't speak, Cast Spells, use manipulate actions requiring your hands, Activate magic items, or make any Strikes with your normal body."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You don't gain the swarm mind ability, so you are still affected normally by mental effects. You also retain the benefits of skeleton feats that don't require communication or the use of hands."
                }
              ]
            }
          ]
        ]
      }
    ],
    "rules": [
      {
        "key": "Weakness",
        "type": ["area-damage", "splash-damage"],
        "value": 5
      },
      {
        "key": "CreatureSize",
        "value": "huge"
      },
      {
        "key": "Immunity",
        "type": ["grabbed", "prone", "restrained"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feat-effects.Item.r4kb2zDepFeczMsl"
    },
    "data": {
      "category": "feat",
      "duration": {
        "type": "time",
        "count": 1,
        "unit": "minute",
        "expiry": "turn-start"
      }
    }
  },
