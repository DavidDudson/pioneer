    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Darkvision:",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain darkvision if you don't already have it."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Greater Disease and Poison Protection:",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your bonus against disease and poison increases to +2. You gain poison resistance equal to half your level."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Paralysis and Sleep Protection:",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain a +1 circumstance bonus to saving throws (or any other defense) against effects that would make you "
          },
          {
            "type": "ref",
            "id": "7802f1d9-5ced-5b9b-8a08-98ec0adb9947"
          },
          {
            "type": "text",
            "text": " or have the sleep trait."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Sense",
        "sense": "67979b6a-4b24-5be5-b7ea-94783c497bcb"
      },
      {
        "key": "FlatModifier",
