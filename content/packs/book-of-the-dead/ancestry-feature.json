  {
    "id": "14cb4178-cbed-5b93-b769-9486852996c7",
    "pack": "book-of-the-dead",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:revulsion",
    "name": "Revulsion",
    "level": 0,
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can't voluntarily come within 10 feet of brandished garlic or a religious symbol of a non-evil deity. A creature must Interact to brandish garlic or a religious symbol for 1 round (similar to Raising a Shield). If you involuntarily come within 10 feet of an object of your revulsion, you gain the "
          },
          {
            "type": "ref",
            "id": "f7fea8f9-c457-5b9f-9283-f567fa557184"
          },
          {
            "type": "text",
            "text": " condition, running from the subject of your revulsion until you end an action beyond 10 feet of it. After 1 round of being exposed to the subject of your revulsion, you can attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 25
          },
          {
            "type": "text",
            "text": " save as a single action, which has the concentrate trait. On a success, you overcome your revulsions for 1d6 rounds, or 1 hour on a critical success."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.dkZ8RxdQFJrdxwQo"
    },
    "data": {}
  },
  {
    "id": "274c7839-3f90-5891-a453-88d53f67d99a",
    "pack": "book-of-the-dead",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:sunlight",
    "name": "Sunlight",
    "level": 0,
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If exposed to direct sunlight, you immediately become "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": ". The slowed value increases by 1 each time you end your turn in sunlight. If you lose all your actions in this way, you are destroyed. Due to your supernatural aversion to light, you don't cast shadows or show a reflection in mirrors."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.bHUrm79wJCcI7L3A"
    },
    "data": {}
  }
]
