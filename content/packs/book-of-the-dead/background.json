            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Charisma",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free ability boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Diplomacy skill and the Lore skill for your home settlement. You gain the "
          },
          {
            "type": "ref",
            "id": "24926aff-a7ca-50ec-af8c-cb872fbfd882",
            "label": "No Cause for Alarm"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
