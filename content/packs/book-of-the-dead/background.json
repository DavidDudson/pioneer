    "kind": "background",
    "slug": "background:scion-of-slayers",
    "name": "Scion of Slayers",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You were born into a lineage of undead slayers. No mere occupation, in your family slaying is a mantle of almost mystic responsibility passed from parent to child. Over the generations, this single-minded focus has begun to manifest in uncanny ways during combat."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two ability boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Strength",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Intelligence",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free ability boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Athletics skill and the Undead Lore skill. You can cast "
          },
          {
            "type": "ref",
            "id": "ad3bed02-6064-56d1-949c-7f5b8355cee7"
          },
          {
            "type": "text",
            "text": " as an innate divine cantrip. You can use Intelligence as your spellcasting ability for this innate spell."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:ath",
        "rank": "trained"
      }
