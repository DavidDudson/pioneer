          {
            "type": "text",
            "text": "Strength",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free ability boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Stealth skill and the Underworld Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "ab6adadd-c9c7-5a67-8aea-bd1d7c8bfd5f"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
