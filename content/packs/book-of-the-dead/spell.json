        "miles": 1
      },
      "duration": {
        "type": "time",
        "count": 1,
        "unit": "minute",
        "sustained": true
      },
      "traditions": [],
      "damage": []
    }
  },
  {
    "id": "1dda6d0a-215d-546b-b171-3310f207e480",
    "pack": "book-of-the-dead",
    "kind": "spell",
    "slug": "spell:hallowed-ground",
    "name": "Hallowed Ground",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["concentrate", "focus", "good", "holy", "manipulate", "vitality"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "One small space becomes inhospitable to undead as you fill it with life-infused benevolent magic. Each undead creature in the area takes 1d6 vitality damage and 1d4 spirit damage when you Cast the Spell, with a basic Fortitude save. After that, undead creatures have weakness 1 to vitality damage and your necromancy spells while in the area."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This spell also automatically attempts to counteract any attempt to raise undead in the area (if either the undead would appear in the area or the effect's caster or creator is in it)."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you Cast this Spell again, any previous "
          },
          {
            "type": "text",
            "text": "hallowed ground",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " you had cast ends."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "ebbf9345-4d60-5d07-a17e-a6ffb1d1adb9"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The vitality damage increases by 1d6, spirit damage increases by 1d4, and weakness increases by 1."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.4bFxUA59xeq6Snhw"
    },
