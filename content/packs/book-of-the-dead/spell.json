[
  {
    "id": "eec0684a-c62a-53be-97e7-e3615421268b",
    "pack": "book-of-the-dead",
    "kind": "spell",
    "slug": "spell:eyes-of-the-dead",
    "name": "Eyes of the Dead",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["concentrate", "focus", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You enter a magical trance that allows you to perceive through the senses of the target creature. You attempt Perception checks using your own Perception, but you have any special senses the target has, such as low-light vision or darkvision. The spell doesn't grant any special method of communication with the target. For the duration of the trance, your own senses are muted, though you can still communicate. This lack of awareness makes you "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": ". You can't take actions with the attack or move traits, nor can you cast spells."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (6th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The range increases to 100 miles and the duration to sustained up to 10 minutes. You can communicate telepathically with the target for the duration of the trance, though the target is under no compulsion to follow commands if it wasn't already."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.DLFupJuCfzyLCQcO"
    },
    "data": {
      "rank": 3,
      "time": {
