  {
    "id": "57e1d9b5-d24b-52bc-a828-e8c262c4def5",
    "pack": "book-of-the-dead",
    "kind": "consumable",
    "slug": "consumable:life-salt",
    "name": "Life Salt",
    "level": 5,
    "rarity": "common",
    "traits": ["consumable", "divine", "vitality"],
    "sources": [
      {
        "kind": "book",
        "book": "book-of-the-dead"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Strike"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This crystal vial contains salts blessed by channeling life-giving energies into waters purified by holy fire. You can activate this vial by throwing it as a Strike. It's a simple thrown ranged weapon with a range increment of 10 feet. Unlike an alchemical bomb, it doesn't add the manipulate trait to the attack made with it. On a hit against an undead, "
          },
          {
            "type": "text",
            "text": "life salt",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " deals 1 persistent vitality damage, and the undead must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 20
          },
          {
            "type": "text",
            "text": " or be unable to attack you as long as it continues taking the persistent vitality damage. If you use a hostile action against any undead, this second effect ends, and the undead can attack you normally."
          }
        ]
      }
    ],
    "rules": [],
