      {
        "kind": "book",
        "book": "mwangi-expanse",
        "page": 123,
        "aon": "https://2e.aonprd.com/Actions.aspx?ID=733"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are hit with an unarmed strike or a strike with a non-reach melee weapon."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You break off quills in your attacker's flesh. You deal "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "ceil(@level/2)d8",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the triggering creature ("
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " save using your class DC or spell DC, whichever is higher.) On a critical failure, the creature also takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d4+ceil(@level/2)-1",
                "damageType": "bleed"
              }
            ]
          },
          {
            "type": "text",
            "text": " as your quills hook into its flesh. At 3rd level, and every 2 levels thereafter, this damage increases by 1d8 and the persistent piercing damage increases by 1."
          }
        ]
      }
    ],
