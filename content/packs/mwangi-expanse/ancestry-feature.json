    "traits": ["conrasu"],
    "sources": [
      {
        "kind": "book",
        "book": "mwangi-expanse"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A conrasu can enter a meditative, healing state as a 10-minute activity when exposed to direct sunlight, in which case they recover "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "(max(1,(ceil(@level/2))))d8"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points. At 3rd level, and every 2 levels thereafter, this healing increases by 1d8."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Once a conrasu has recovered Hit Points in this way, they are temporarily immune to further uses of Sunlight Healing for 1 day."
          }
        ]
      }
