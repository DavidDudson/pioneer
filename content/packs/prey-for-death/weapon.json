              {
                "formula": "6d6",
                "damageType": "force"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 43,
            "basic": true
          },
          {
            "type": "text",
            "text": " save); those who critically fail this save are knocked "
