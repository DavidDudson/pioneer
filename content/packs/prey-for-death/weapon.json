            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " against the ground or another solid adjacent surface, causing an explosion of molten metal and force to radiate outward in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 20
          },
          {
            "type": "text",
            "text": ". All creatures in this area take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d6",
                "damageType": "fire"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and "
          },
          {
