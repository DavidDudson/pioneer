    "kind": "spell",
    "slug": "spell:achaekeks-clutch",
    "name": "Achaekek's Clutch",
    "level": 4,
    "rarity": "rare",
    "traits": ["concentrate", "curse", "death", "focus", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "prey-for-death"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You mark the holy symbol of Achaekek in a visible location on the target's body."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is marked by Achaekek's symbol. For 1 minute, the first time per round that the target gains "
          },
          {
            "type": "ref",
            "id": "03f09f32-a6d0-56f8-995b-b80986c1e1dc",
            "label": "Persistent Bleed Damage"
          },
          {
            "type": "text",
            "text": ", they immediately take that amount of slashing damage as the mantis claws grow off the symbol and rake them."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, but the curse has an unlimited duration."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the DC on the target's flat check to remove persistent bleed damage increases to 20 (15 with particularly effective assistance)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
