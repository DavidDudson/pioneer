  {
    "id": "f09aaa6d-97bb-52ab-84b1-dba67c40472d",
    "pack": "prey-for-death",
    "kind": "spell",
    "slug": "spell:bone-flense",
    "name": "Bone Flense",
    "level": 3,
    "rarity": "rare",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "prey-for-death"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The target weapon becomes imbued with Achaekek's power and glows softly with crimson light akin to that shed by a candle. When a creature with a skeleton or exoskeleton takes damage from a Strike delivered by this weapon, the creature's bones nearest to the wound instantly sprout jagged, razor-sharp spurs that flense the muscle and flesh from inside out. The creature takes an additional 1d6 persistent bleed damage from the Strike. You can use the "
          },
          {
            "type": "ref",
            "id": "4ef517cb-0ad7-5af4-a943-875a590ce35e"
          },
          {
            "type": "text",
            "text": " reaction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "fa3eeb37-0979-5a10-b265-acc25d05791f"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "722b1e33-0fd0-564c-85e7-c8f28b6ad665"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The persistent bleed damage increases by 1d6. The damage from Erupting Spurs increases by 4d6."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.V4IpjSlefultlOuY"
