  {
    "id": "fb1cc6ee-3f9a-5b70-9cea-600d185b7f0c",
    "pack": "prey-for-death",
    "kind": "spell",
    "slug": "spell:mantiss-grasp",
    "name": "Mantis's Grasp",
    "level": 4,
    "rarity": "rare",
    "traits": ["concentrate", "force", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "prey-for-death"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You cause red, ghostly mantis arms to sprout from a nearby surface and crush a creature, dealing 8d6 force damage and attempting to pin the target in place. The effects are determined by the creature's Reflex save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes full damage and is "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": " for 1 round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes double damage and is immobilized for 1 minute. At the end of each of its turns, the target can attempt to "
          },
          {
            "type": "ref",
            "id": "2ae74030-e87a-55ee-955c-fb9870392d44"
          },
          {
            "type": "text",
            "text": ". The Escape DC is equal to your spell DC."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (7th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You can target up to 5 creatures."
          }
        ]
      }
