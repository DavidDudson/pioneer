    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Made from the finest plates of monstrous insect chitin, this "
          },
          {
            "type": "text",
            "text": "+2 greater resilient mantis shell",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " offers superior protection from Mediogalti's hot weather while also allowing the wearer to blend into almost any situation and strike with hidden blades. While wearing this armor, you are protected from extreme heat and severe heat effects. "
          },
          {
            "type": "text",
            "text": "Vernai shell",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " armor includes two extradimensional spaces built into each of the armor's gloves, granting the wearer two places to store items. Each glove can hold one item of 1 Bulk or less. While an item is stored in one of the two gloves, there is nothing to indicate that an item is being held inside it."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Store Item",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " At least one of the "
          },
          {
            "type": "text",
            "text": "Vernai shell's",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " two extradimensional spaces is empty"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " One item you're holding with a Bulk of 1 or less vanishes into one of the armor's extradimensional spaces."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Retrieve Item",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " An item is stored in at least one of the "
          },
          {
            "type": "text",
            "text": "Vernai shell's",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " extradimensional spaces, and you have a free hand"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " One item of your choice in either extradimensional space appears in your hand. You can't Retrieve Item again for 1 minute."
          }
        ]
      }
