    "slug": "action:forced-pact",
    "name": "Forced Pact",
    "rarity": "common",
    "traits": ["concentrate"],
    "sources": [
      {
        "kind": "book",
        "book": "rival-academies",
        "page": 47,
        "aon": "https://2e.aonprd.com/Actions.aspx?ID=3061"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You force a temporary pact on both yourself and another creature you can see within 60 feet. Choose attack, move, manipulate, or concentrate. The target must attempt a Will saving throw."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " If you or the target uses an action with the chosen trait within the next minute, they take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d6",
                "damageType": "mental"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage, and this pact ends for both of you."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, except your target takes the damage if either of you uses an action with the chosen trait."
          }
        ]
      }
    ],
