        "coins": {
          "gp": 15
        }
      },
      "bulk": "negligible",
      "usage": {
        "type": "worn",
        "slot": "eyeglasses"
      }
    }
  },
  {
    "id": "13a2ae6f-a173-5419-82cb-f10264885092",
