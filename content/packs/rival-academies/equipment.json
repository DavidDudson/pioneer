      "price": {
        "coins": {
          "gp": 50
        }
      },
      "bulk": "light",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "b82a0460-bb54-551b-b206-54839b9c8b76",
    "pack": "rival-academies",
    "kind": "equipment",
    "slug": "equipment:pranksters-perpetual-pieplate",
    "name": "Prankster's Perpetual Pieplate",
    "level": 1,
    "rarity": "rare",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "rival-academies",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3577",
        "page": 105
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Although the simple pies that fill this glass plate every minute are edible, they don't last long enough to sate hunger or provide any real nutritive value. Instead, they can be magically guided at targets, unleashed harmlessly by even the most uncoordinated child."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Project Pastry",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You magically hurl the pie at a creature within 30 feet. Unless the target succeeds at a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 15
          },
          {
            "type": "text",
            "text": " save, they're splattered with a harmless but tasty mess, which remains until it is wiped away with an Interact action or is otherwise cleaned off (like if the target is submerged in water). After a minute, the mess disappears, and the pieplate refills with another kind of pie."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.dzwHxy09Xql3kIPd"
