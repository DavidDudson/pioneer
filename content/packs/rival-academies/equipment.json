      "price": {
        "coins": {
          "gp": 500
        }
      },
      "bulk": 5,
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "16547e83-539f-5876-adb7-ff4174aca84b",
    "pack": "rival-academies",
    "kind": "equipment",
    "slug": "equipment:zarothrasks-contract",
    "name": "Zarothrask's Contract",
    "level": 9,
    "rarity": "rare",
    "traits": ["contract", "invested", "occult"],
    "sources": [
      {
        "kind": "book",
        "book": "rival-academies",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3578",
        "page": 106
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You've bargained for power with a gongorinan, but in return, you must avoid furthering demonic goals. You gain a +2 item bonus to Athletics checks to "
          },
          {
            "type": "ref",
            "id": "ef57a555-f9e9-53cc-b09b-b7432156cbf1"
          },
          {
            "type": "text",
            "text": " manufactured items and to "
          },
          {
            "type": "ref",
            "id": "380d34f1-f6f6-5820-b9dd-c01ee4e19fd5"
          },
          {
            "type": "text",
            "text": ". Once per day, the gongorinan can warp your body with animal features; you must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 25
          },
          {
            "type": "text",
            "text": " save or become "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": ". When you recover from the sickened condition, your features revert to normal. The gongorinan will usually do this if you sin or aid a demon, even unintentionally."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Gongorinan's Emergence",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, mental, morph, occult, unholy)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Stony tentacles burst out of your body, lashing at foes. Creatures in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 10
          },
          {
            "type": "text",
            "text": " take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d6",
                "damageType": "bludgeoning"
              },
              {
                "formula": "2d6",
                "damageType": "mental"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 25,
            "basic": true
          },
          {
            "type": "text",
            "text": " save); on a failure, the creature also becomes "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": " (sickened 2 on a critical failure) as parts of their anatomy temporarily warp into animal features. When a creature recovers from the sickened condition, its features revert to normal."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:athletics"],
        "type": "item",
        "value": 2,
        "predicate": [
          {
            "or": ["action:grapple", "action:disarm"]
          }
        ]
