        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3055"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This red crystal is cut in the shape of a five-pointed star. An eastern star aeon stone must be activated to provide a benefit. The resonant power grants you a +1 item bonus to Diplomacy checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Absorb Language",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You touch a creature who spoke a common language in your presence within the previous minute. The eastern star aeon stone becomes infused with this language, granting you the ability to understand, speak, and write that language. This activation persists until you activate it again."
          }
        ]
      }
    ],
    "rules": [
