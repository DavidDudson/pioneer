  {
    "id": "8c6439e8-973c-5419-a26b-65ae7cefc536",
    "pack": "the-dead-gods-hand",
    "kind": "equipment",
    "slug": "equipment:heart-of-sarnax",
    "name": "Heart of Sarnax",
    "level": 6,
    "rarity": "unique",
    "traits": ["arcane", "artifact"],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand",
        "page": 144,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5222"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This fist-sized ruby would be close to priceless even if it weren't a magical artifact. So large and heavy for a ruby that most merchants would take it for a fake anyway, the Heart of Sarnax pulses like a heartbeat whenever the wielder speaks aloud the name \"Sarnax.\""
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Two Hearts as One",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You hold forth the Heart of Sarnax, targeting a living creature within 60 feet, then give the huge ruby a firm squeeze. The Heart of Sarnax begins pounding in your grip, like a heart racing in panic or exertion, and the targeted creature feels their own heart speed up to match. Choose one of the following effects to apply to the targeted creature."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bestow Vim",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target creature becomes "
          },
          {
            "type": "ref",
            "id": "6517bbf2-8085-534b-be6a-187d52739fa0"
          },
          {
            "type": "text",
            "text": ", and it can use the extra action to Stride, Strike, or attempt an Athletics check that resolves as a single action. Any Strikes made during this action are not affected by the creature's current multiple attack penalty, and any Athletics checks made during this action gain a +2 item bonus. If the creature uses the action to Stride, it gains a +10-foot item bonus to its Speed. This effect lasts for 1 minute, after which the target creature becomes "
          },
          {
            "type": "ref",
            "id": "5e3582c3-701c-5169-9c69-4221096722c2"
          },
          {
            "type": "text",
            "text": " for 1 hour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Crush Heart",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (death) The target creature feels its heart pounding harder, and then suddenly feels it stop as its life essence is crushed. The creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "7d6",
                "damageType": "spirit"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 20
          },
          {
            "type": "text",
            "text": " save. A creature reduced to 0 HP by this damage is slain."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes no damage, but is "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " until the end of its next turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes half damage and is off-guard until the end of its next turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes full damage, is off-guard until the end of its next turn, and is "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": " for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes double damage and is "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 3"
          },
          {
            "type": "text",
            "text": ". When it recovers from being stunned, it is "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 2"
          },
          {
            "type": "text",
            "text": " for 1 minute."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Destruction",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " By transforming the Heart of Sarnax into a ruby version of Sarnax and then destroying the construct, the Heart of Sarnax shatters into valuable but non-magical fragments."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.jOR6jSXqgEXc1Src"
    },
    "data": {
      "bulk": 3,
      "activations": [
        {
          "slug": "two-hearts-as-one",
          "name": "Two Hearts as One",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "18f7db3d-6389-56f8-b40a-f0df9a6d82a9",
    "pack": "the-dead-gods-hand",
    "kind": "equipment",
    "slug": "equipment:lookouts-spyglass",
    "name": "Lookout's Spyglass",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand",
        "page": 143,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5218"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This brass and wood spyglass is typically decorated with etchings of distant landscapes seen on the horizon of a vast body of water. When the spyglass is extended for use, the etchings of distant-appearing horizons appear to grow closer. A "
          },
          {
            "type": "text",
            "text": "lookout's spyglass",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " can be used as a typical spyglass to see eight times farther than normal, but it also has the following activation."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Seek Significance",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 minute (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You spend a minute observing your surroundings in all directions through the lookout's spyglass, taking in the features of the terrain while the spyglass sharpens your senses of observation. Once you complete the activation, the next time within the next hour that you roll Perception for initiative, you gain a +1 item bonus on the roll if you're still carrying the lookout's spyglass on your person."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.amPRfrE5PROymWtp"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 35
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "seek-significance",
          "name": "Seek Significance",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "usage": {
        "type": "held",
        "hands": "two"
      }
    }
  },
  {
    "id": "a3bc3bb7-403b-5d80-90b2-2c737fea6700",
    "pack": "the-dead-gods-hand",
    "kind": "equipment",
    "slug": "equipment:mantle-of-far-horizons",
    "name": "Mantle of Far Horizons",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand",
        "page": 143,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5219"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The mantle of far horizons helps to bring comfort and a sense of security while traveling, filling you with confidence and bolstering your energy during long journeys. In areas where you can see the horizon, you gain a +1 item bonus to Survival checks made to Sense Direction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Gaze upon the Horizon",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You raise the mantle's hood to augment your ability to see over large distances or through adverse weather. For the next hour, or until you lower your hood (whichever comes first), you gain a +1 item bonus to Perception checks made to observe things more than 500 feet away, or while in weather-related conditions that penalize your Perception checks (such as fog or precipitation)."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Listen to the World",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You lower the mantle's hood to focus on the world's natural sounds rather than other distractions. For the next minute, or until you raise the mantle's hood (whichever comes first), you gain a +1 item bonus to saving throws against auditory effects."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "item",
        "value": 1,
        "predicate": ["action:sense-direction"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.A6ah2uq7xhTvMo3b"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 60
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "gaze-upon-the-horizon",
