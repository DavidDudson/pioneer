  {
    "id": "85834e2a-8034-56ab-8240-08aab611bc19",
    "pack": "the-dead-gods-hand",
    "kind": "equipment",
    "slug": "equipment:deravons-helm",
    "name": "Deravon's Helm",
    "level": 4,
    "rarity": "unique",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand",
        "page": 143,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5217"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Deravon's helm",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is crafted with crown-like embellishments to give it an unmistakable air of authority. Crafted of gold with silver filigree incorporating images of swords, jewels, and most of all, the Eye of Aroden (from which the tines of the crown extend), Deravon's helm is much lighter than would be expected. Downward swooping guards adorn the sides of the helm while leaving the face fully visible. It grants you a +1 item bonus to Intimidation checks made to Demoralize."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Bow Before Aroden",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (auditory, concentrate, linguistic, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You issue a command to a humanoid within 30 feet to bow down before Aroden's glory. The targeted creature must make a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 18
          },
          {
            "type": "text",
            "text": " save to resist being compelled to drop "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": " as its first action on their next turn (on a critical failure, the target must spend all three actions on its next turn remaining prone). If the target is a human, they take a –1 status penalty to the save."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:intimidation"],
        "type": "item",
        "value": 1,
        "predicate": ["action:demoralize"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.lrqWKtJrjb55iHtw"
    },
