        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Arcana skill and in the Academia Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "2e7a3f2a-4cb5-59ab-a713-07b8f1076bae"
          },
          {
            "type": "text",
