[
  {
    "id": "7e476546-9aa9-5133-80e7-d7718d0661c1",
    "pack": "the-dead-gods-hand",
    "kind": "background",
    "slug": "background:absalom-street-preacher",
    "name": "Absalom Street Preacher",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When one considers the role of the priest in religion, it's easy to assume all who serve a god do so from the shelter of a cathedral or temple. Not so in your case. You grew up among those of exceptional faith who served under no roof, and for some time, you have been following in their footsteps by bringing the word of your god or philosophy to passersby in the streets. Absalom is a hotbed of competing faiths, and there are always new ears to preach to. At the same time, you've grown particularly intrigued by the dwindling faith and old teachings of Aroden, the god who created Absalom in the first place. What secrets hidden by his followers long ago might still await discovery in the city's hidden places?"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Constitution",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Wisdom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Religion skill and in the Aroden Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "0a4badf5-290b-5ba6-946a-aded360069eb"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:religion",
        "rank": "trained"
      },
      {
        "key": "Proficiency",
        "selector": "skill:lore:aroden",
        "rank": "trained"
      },
      {
        "key": "GrantItem",
        "item": "0a4badf5-290b-5ba6-946a-aded360069eb"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.backgrounds.Item.UC1jVssliK30AoCQ"
    },
    "data": {
      "boosts": [
        ["con", "int"],
        ["cha", "con", "dex", "int", "str", "wis"]
      ]
    }
