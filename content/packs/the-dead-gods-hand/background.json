  {
    "id": "6dac7765-d764-53ff-9d96-18d1f7f76313",
    "pack": "the-dead-gods-hand",
    "kind": "background",
    "slug": "background:ambitious-knave",
    "name": "Ambitious Knave",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "the-dead-gods-hand"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You want more than anything to become a member of Absalom's high society, no matter what you have to do to make it happen. Whether you feel guilt for those you're forced to step over (or on) in your scramble to stand among the city's movers and shakers or whether you take pleasure in watching others fall short of the goals you and they are both pursuing, your ultimate ambition is to become famous. Your fellow party members are a rare exception to the disdain with which you regard others, although even then, you know you're the one who really matters in the end."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Charisma",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Thievery skill and in the Absalom Lore skill. You gain the Dirty Trick skill feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:thievery",
        "rank": "trained"
      },
      {
        "key": "Proficiency",
        "selector": "skill:lore:absalom",
        "rank": "trained"
      },
      {
        "key": "GrantItem",
        "item": "88af3edf-2b57-5a2f-9a0d-4e7f540fc2ef"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.backgrounds.Item.h9PNw7A5tRrjp4JE"
    },
    "data": {
      "boosts": [
        ["cha", "dex"],
        ["cha", "con", "dex", "int", "str", "wis"]
      ]
    }
