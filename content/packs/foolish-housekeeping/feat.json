[
  {
    "id": "0ea3a95c-7eb8-5775-8c05-815015e29ed2",
    "pack": "foolish-housekeeping",
    "kind": "feat",
    "slug": "feat:a-little-bird-told-me",
    "name": "A Little Bird Told Me...",
    "level": 8,
    "rarity": "common",
    "traits": ["archetype", "concentrate", "manipulate", "polymorph"],
    "sources": [
      {
        "kind": "book",
        "book": "foolish-housekeeping",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7602"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You transform into a small bird, such as a finch or a sparrow, allowing you to eavesdrop on others and gain information you wouldn't otherwise be able to acquire. You become Tiny, gain the animal trait, and you can't make Strikes. You can Dismiss the effect to return to your normal shape, and you resume your normal shape automatically if you're reduced to 0 Hit Points."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain the following statistics and abilities:"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "AC = 20 + your level. Ignore your armor's check penalty and Speed reduction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fly speed 25 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weakness 5 to physical damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Low-light vision and imprecise scent 30 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Acrobatics and Stealth modifiers of +10, unless your own is higher; Athletics modifier –4."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
