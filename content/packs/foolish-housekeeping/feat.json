    "name": "Verbose Distraction",
    "level": 6,
    "rarity": "common",
    "traits": ["archetype", "auditory"],
    "sources": [
      {
        "kind": "book",
        "book": "foolish-housekeeping",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7600"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are the target of a physical melee attack."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You talk so much it can be distracting to your enemies and you're often quick to remind your enemies that you're just a little guy! You don't need to be targeted! You don't need to be the focus of their frustrations! Have they tried writing to their mom or talking to a local priest of Desna? Ow!"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain a +2 circumstance bonus to your AC against the triggering attack."
          }
        ]
      }
    ],
