  {
    "id": "95cb4fb9-73a2-5fa2-a31b-73be722f5d3d",
    "pack": "foolish-housekeeping",
    "kind": "feat",
    "slug": "feat:muckraking",
    "name": "Muckraking",
    "level": 16,
    "rarity": "common",
    "traits": ["archetype", "auditory", "concentrate", "emotion", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "foolish-housekeeping",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7605"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "It seems like your knowledge has come in handy after all and you have your enemy at your feet. Pulling out your fan mail, you read your fans' scathing remarks about your enemy to their face, letting them feel just how much everyone hates them and everything that they've done. They hate the way that they walk, they hate the way that they talk."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your enemy takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d10",
                "damageType": "mental"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage, with a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " save. On a critical failure, they're "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " until the beginning of your next turn and lose all reactions, except to cry, loudly."
          }
        ]
      }
    ],
    "rules": [],
