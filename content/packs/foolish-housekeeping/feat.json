  {
    "id": "35e158cb-1e91-5a69-bb43-35bbcc6fbf19",
    "pack": "foolish-housekeeping",
    "kind": "feat",
    "slug": "feat:define-report",
    "name": "Define “Report”",
    "level": 10,
    "rarity": "common",
    "traits": ["archetype", "fortune"],
    "sources": [
      {
        "kind": "book",
        "book": "foolish-housekeeping"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Look, getting caught in a lie is a normal part of venture-gossip life. Sometimes you have to give a sheepish smile and apologize for what you've done. When you fail a Deception check, reroll with your Diplomacy modifier. On a success, there are no hard feelings and the other person's attitude condition doesn't worsen. On a critical success, you can attempt the Deception again with no consequences."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.0lHhrYVe4VXbdSkh"
    },
