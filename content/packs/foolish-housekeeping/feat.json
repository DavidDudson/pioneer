    "slug": "feat:hey-over-here",
    "name": "Hey! Over Here!",
    "level": 6,
    "rarity": "common",
    "traits": ["archetype", "auditory"],
    "sources": [
      {
        "kind": "book",
        "book": "foolish-housekeeping",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7601"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " An ally within 30 feet rolls a saving throw against an auditory effect."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hey! Don't listen to that! That's bad sounds! Listen to me! Would you like to hear about how the high priest of the Abadaran church in Absalom's Petals District is having an affair with an Urgathoan cleric? Yeah, I'm thinking about calling the article \"Boney Money!\""
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your targeted ally treats the result of their saving throw as one degree of success better. Once an ally has been targeted by this effect, they're immune for 24 hours."
          }
        ]
      }
    ],
    "rules": [],
