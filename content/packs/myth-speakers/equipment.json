  {
    "id": "65926cec-d7f8-5f77-9fa1-aec6108c71c4",
    "pack": "myth-speakers",
    "kind": "equipment",
    "slug": "equipment:vortex-pouch",
    "name": "Vortex Pouch",
    "level": 6,
    "rarity": "rare",
    "traits": ["air", "magical", "mythic"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When empty, the "
          },
          {
            "type": "text",
            "text": "vortex pouch",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
