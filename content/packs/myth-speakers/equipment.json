    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Slivers of boar tusk are sewn into this leather cap, creating a scaled helmet that channels dozens of boars' ferocity into the wearer."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Boar's Last Stand",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (auditory, concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your turn begins"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You have a doomed or wounded value of 1 or higher"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You unleash a fearsome roar. 1 creature of your choice within 30 feet must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 16
          },
          {
            "type": "text",
            "text": " save or become "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 1"
          },
          {
            "type": "text",
            "text": " ("
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 2"
          },
          {
            "type": "text",
            "text": " on a critical failure). Increase this DC by the sum of your "
          },
          {
            "type": "ref",
            "id": "cd164d22-2d8e-5fd2-b8b2-03e1360df1e7"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "6c4e09a7-469d-5668-8c1b-92f87de94d27"
          },
          {
            "type": "text",
            "text": " values (maximum DC 20). You then gain 5 temporary Hit Points that last 1 minute."
          }
        ]
      }
    ],
