  {
    "id": "a7bbcea9-f827-5ac9-a49f-e7f991f77ced",
    "pack": "myth-speakers",
    "kind": "spell",
    "slug": "spell:gift-of-the-anemos",
    "name": "Gift of the Anemos",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["air", "animist", "aura", "focus"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2522",
        "page": 83
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your apparition envelops you in gusting winds that can speed your steps or buffet your foes. When an enemy in the aura critically fails a Strike against you, they must succeed at a Reflex save or become "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " until the end of your next turn. When you cast or sustain this spell, you can either Step, "
          },
          {
            "type": "ref",
            "id": "082b982f-3ed4-5d9c-9722-9ab10198523a"
          },
          {
            "type": "text",
            "text": " a creature in the aura using your spell attack modifier in place of your Athletics modifier, or jump 10 feet in any direction (you must land on solid ground, or else you fall)."
          }
        ]
      }
    ],
