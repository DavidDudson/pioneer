    "slug": "spell:crown-of-prophets",
    "name": "Crown of Prophets",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["animist", "focus", "morph"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2521",
        "page": 83
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Serpents sprout from your head, equally ready to bite your foes or offer you counsel. You gain a fangs unarmed attack that deals 1d6 piercing damage and has the agile, finesse, and versatile poison traits. The first time you Cast or Sustain this spell each round, you can perform one of the following as a free action."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Serpentine Advice",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The snakes compete to offer you counsel. You gain the "
          },
          {
            "type": "ref",
            "id": "ea6c8962-0fc5-5db6-8fbd-0ad99296eae2"
          },
          {
            "type": "text",
            "text": " feat until the end of your turn, then you "
          },
          {
            "type": "ref",
            "id": "3c873e49-a1c4-53b5-9694-66b860d94d43"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Toxic Prophecy",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (poison)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature within 15 feet damaged you since the end of your last turn"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The snakes spit toxic curses at the required creature, dealing 2d4 poison damage (basic Fortitude save)."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "9e2fc63f-fa5b-5de9-847e-431d16b97254"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The poison damage dealt by Toxic Prophecy increases by 1d4."
          }
        ]
      }
    ],
