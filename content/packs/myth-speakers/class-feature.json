[
  {
    "id": "a30534e5-78af-5ef0-be37-d283567144ee",
    "pack": "myth-speakers",
    "kind": "class-feature",
    "slug": "class-feature:plunderer-of-the-hives-riches",
    "name": "Plunderer of the Hive's Riches",
    "level": 7,
    "rarity": "common",
    "traits": ["exemplar"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You take what's yours, even if an army should stand in your way. You gain the "
          },
          {
            "type": "ref",
            "id": "d52c641b-03fd-5652-8dd8-3ff51291144e"
          },
          {
            "type": "text",
            "text": " feat, with your choice of either poison or sonic damage. When you critically succeed at a Strike, the taste of honey fills your mouth as you plunder part of your foe's vitality for yourself, gaining temporary Hit Points equal to half the creature's level that last for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you Spark Transcendence, a mass of buzzing insects fill the air around you, granting you "
          },
          {
            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1",
            "label": "Concealment"
          },
          {
            "type": "text",
            "text": " until the beginning of your next turn. You can't use this concealment to "
          },
          {
            "type": "ref",
            "id": "5a86b7d0-fc0e-52a6-9b0d-fb58ed15233d"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "7e4e48de-b626-5513-9518-73261c58b5f4"
          },
          {
            "type": "text",
            "text": ", as normal for concealment when your position is still obvious."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:epithet-critical-specialization",
        "toggleable": true,
        "priority": 51,
        "display": {
          "label": "Use epithet critical specialization effect"
        }
      },
      {
        "key": "CriticalSpecialization",
        "predicate": ["option:epithet-critical-specialization"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.classfeatures.Item.YL3yActlXBpXrSBl"
    },
    "data": {
      "tags": ["exemplar-dominion-epithet"]
    }
  },
