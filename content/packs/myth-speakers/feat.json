      "action": {
        "cost": "free",
        "trigger": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "You regain Hit Points while you are Unconscious."
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "9272f262-644a-55ef-880a-ae132341bf93",
