        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8007"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You regain Hit Points while you are "
          },
          {
            "type": "ref",
            "id": "e1a78dad-4887-518e-9120-e58b7009ebfd"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you escape death, you return to life with retributive fire that burns those who harmed you. You expend 1 Mythic Point, return to consciousness, Stand, and regain additional Hit Points equal to your level. You then erupt in flames, dealing fire damage equal to twice your level ("
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2*@level",
                "damageType": "fire"
              }
            ]
          },
          {
            "type": "text",
            "text": ") to adjacent foes, with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": {
              "against": "class-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " save against your class DC. Foes that critically fail the save are also pushed 5 feet away from you."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.lNIHXCQ0Zc2gY5OH"
    },
