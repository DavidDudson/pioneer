  {
    "id": "57abe990-6fd6-5c86-878a-7a7d545c5b2e",
    "pack": "myth-speakers",
    "kind": "action",
    "slug": "action:unravel-the-future",
    "name": "Unravel the Future",
    "rarity": "common",
    "traits": ["fortune", "transcendence"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You pluck a single thread from your ikon, which ties itself in three loops about your wrist, where it remains for the next minute. If you fail an attack roll or skill check, and a +1 status bonus would change your failure into a success or your success into a critical success, you gain a +1 status bonus to this check retroactively, changing the outcome appropriately as the thread pulls you to the future you desire. The thread then falls from your wrist. You can have only one thread in existence at a time."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.TIIM35m8aDUEU4gF"
