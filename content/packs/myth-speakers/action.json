[
  {
    "id": "59c06e2b-ef0d-5778-848b-fb465733d55e",
    "pack": "myth-speakers",
    "kind": "action",
    "slug": "action:brandish-the-gorgons-gaze",
    "name": "Brandish the Gorgon's Gaze",
    "rarity": "common",
    "traits": ["earth", "transcendence", "visual"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You Raise your "
          },
          {
            "type": "ref",
            "id": "6304f0b8-2e47-5e8d-a5bb-a3b3d4caaf18"
          },
          {
            "type": "text",
            "text": ", though it seems to lose some of its usual luster in favor of the dull sheen of stone. If you "
          },
          {
            "type": "ref",
            "id": "4333cbb5-7f4c-5c8e-bbad-afa6b6f2043b"
          },
          {
            "type": "text",
            "text": " a melee attack with the mirrored aegis before the beginning of your next turn, the gorgon's eyes upon it flash at the triggering creature, who must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-dc"
            },
            "options": ["inflicts:slowed"]
          },
          {
            "type": "text",
            "text": " save against your class DC. On a failure, they are "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": " for 1 minute as their body partially petrifies. Regardless of the outcome, that creature is temporarily immune to this effect for 24 hours."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.5VbPhxZYfagIqE1z"
    },
    "data": {
      "cost": "one",
      "category": "offensive"
    }
  },
  {
    "id": "26151845-7145-5379-b2dc-93985324e6c2",
    "pack": "myth-speakers",
    "kind": "action",
    "slug": "action:makes-me-stronger",
    "name": "Makes Me Stronger",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You take damage from your heroic weakness and are not reduced to fewer than 1 Hit Point by the damage"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You make a show of powering through your weakness, be it by flexing your muscles, issuing a challenging roar, laughing off the pain, or simply acting as if the damage doesn't worry you in the slightest. Your spells gain a status bonus to damage against the triggering creature equal to twice their rank; this lasts until the next time you use this reaction. In addition, the creature that damaged you with your heroic weakness must attempt a Will save against your class or spellcasting DC, whichever is higher, to avoid becoming "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 1"
          },
          {
            "type": "text",
            "text": " ("
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 2"
          },
          {
            "type": "text",
            "text": " on a critical failure)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.k3Dbgb8iS73atDqB"
    },
    "data": {
      "cost": "reaction",
      "category": "defensive",
      "trigger": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You take damage from your heroic weakness and are not reduced to fewer than 1 Hit Point by the damage"
            }
          ]
        }
      ]
    }
