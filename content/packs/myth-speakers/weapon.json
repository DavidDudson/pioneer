  {
    "id": "1b56577b-9e47-5587-8a17-e36ed476793e",
    "pack": "myth-speakers",
    "kind": "weapon",
    "slug": "weapon:protectors-final-gift",
    "name": "Protector's Final Gift",
    "level": 5,
    "rarity": "rare",
    "traits": ["deadly-d8", "disarm", "finesse", "poison"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Within hives of giant bees, some become protectors of their hive and etch runes onto their stingers via dance. Upon such a bee's death, its stinger can be removed from its body and used as "
          },
          {
            "type": "text",
            "text": "+1 striking rapier",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", though a hilt often needs to be attached for skilled swordsmanship. The imbued magic allows the stinger to slowly renew a small bit of its venom supply. The wielder can gather this and deliver it during a Strike. The victim is made to see prophetic flashes of their future as it courses through their system."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Apiprophecy Sting",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The "
          },
          {
            "type": "text",
            "text": "protector's final gift",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " secrets apiprophecy venom, which coats the blade and affects the next creature successfully struck with the blade within the next minute."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Apiprophecy Venom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (poison)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Saving Throw",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 20
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
