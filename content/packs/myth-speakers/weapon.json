  {
    "id": "51af844d-64fc-5aab-9ebe-acdaafcce5fd",
    "pack": "myth-speakers",
    "kind": "weapon",
    "slug": "weapon:hydra-spear",
    "name": "Hydra Spear",
    "level": 8,
    "rarity": "unique",
    "traits": ["magical", "reach"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 striking longspear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " of polished white bone features a tip of layered reptilian scales, compressed to form a sharp edge. Akki crafted this spear herself after she and her allies tangled with a hydra plaguing the marshes outside Aelyosos. She pressed the scales of the creature down into a spearpoint mostly through sheer stubbornness, granting it a unique ability."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Hydra Swipe",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The spearhead unravels and elongates into a group of snake heads. Make up to three melee Strikes with the "
          },
          {
            "type": "text",
            "text": "Hydra Spear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", each at a different creature within 20 feet. These attacks do not count toward your multiple attack penalty until all attacks have been resolved."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.DA3hZ45tpmBuPkKZ"
