  {
    "id": "524bc3a7-0c35-55a2-af0b-634dc196bf13",
    "pack": "myth-speakers",
    "kind": "weapon",
    "slug": "weapon:hydra-head-club",
    "name": "Hydra Head Club",
    "level": 6,
    "rarity": "rare",
    "traits": ["magical", "modular", "thrown-10"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This spine and skull of a slain hydra has been picked clean by a carrion bird and crafted into this "
          },
          {
            "type": "text",
            "text": "+1 striking club",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". In addition to its normal traits, the "
          },
          {
            "type": "text",
            "text": "hydra head club",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " also has the modular P trait, as it can be manipulated to cause the jaws to spring open. Even in death, its head twitches independently. The creature's famed regenerative powers are still present, despite the creature's death; if damaged, the "
          },
          {
            "type": "text",
            "text": "hydra head club",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " repairs itself at the rate of 1 Hit Point per minute, unless it has been completed destroyed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Reactive Snap",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (attack)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You attempt a Strike as a Reaction"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The "
          },
          {
            "type": "text",
            "text": "hydra head club",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " snaps with a momentary burst of its former glory. Your Strike attempt deals an additional 1d6 damage. If your Strike misses, the activation does not count against the "
          },
          {
            "type": "text",
            "text": "hydra head club's",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " activation frequency."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You must supply a skull and spine of a hydra when crafting this weapon."
          }
        ]
      }
    ],
    "rules": [
