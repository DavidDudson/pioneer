  {
    "id": "e6a7df96-0a64-535e-a7a2-3f71dd45f8dd",
    "pack": "myth-speakers",
    "kind": "weapon",
    "slug": "weapon:preordained-spear",
    "name": "Preordained Spear",
    "level": 9,
    "rarity": "rare",
    "traits": ["magical", "monk", "mythic", "thrown-20"],
    "sources": [
      {
        "kind": "book",
        "book": "myth-speakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 striking spear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " seems to know when its wielder is about to die. Its wooden body bears countless carvings, leaving it thinner than most spears. While you are "
          },
          {
            "type": "ref",
            "id": "cd164d22-2d8e-5fd2-b8b2-03e1360df1e7"
          },
          {
            "type": "text",
            "text": ", a "
          },
          {
            "type": "text",
            "text": "preordained spear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " glows with a faint red light that gives you a haunted look and sheds dim light within 5 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Delay Doom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your name is not on the spear, and you have the doomed condition"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your name appears on the shaft of the "
          },
          {
            "type": "text",
            "text": "preordained spear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". Your doomed value decreases by 1, and you regain 1 Mythic Point. Your name fades from the spear the next time you make your daily preparations."
          }
        ]
      }
    ],
