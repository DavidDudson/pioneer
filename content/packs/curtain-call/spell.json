  {
    "id": "22bca9d1-35d5-5b13-8837-febc0367f271",
    "pack": "curtain-call",
    "kind": "spell",
    "slug": "spell:musical-shift",
    "name": "Musical Shift",
    "level": 8,
    "rarity": "rare",
    "traits": ["auditory", "concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "With a quick series of wrist flicks, music fills the air. While the music can be heard as if it were performed normally at a distance, creatures in the spell's area become affected in more significant ways. When you cast musical shift, select a key signature (to affect enemies) and a time signature (to affect allies) from the options below; all creatures within the area are affected as indicated. You can change the key signature or time signature as part of the action you take when you Sustain the spell."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Flat",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (key signature) Whenever an enemy critically fails at a Strike, saving throw, or skill check, they fall "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": " in addition to other effects from the critical failure."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Natural",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (key signature) Enemies take a –2 status penalty to attack rolls."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sharp",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (key signature) Whenever an enemy takes piercing or slashing damage, they also take 2d6 persistent bleed damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Double",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (time signature) You and your allies become "
          },
          {
            "type": "ref",
            "id": "6517bbf2-8085-534b-be6a-187d52739fa0"
          },
          {
            "type": "text",
            "text": " and can use the extra action each round only for "
          },
          {
            "type": "ref",
            "id": "1a0bed3d-5eb7-554f-ad07-4c8630afd0c8"
          },
          {
            "type": "text",
            "text": ", Stand, Step, or Stride actions."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Quadruple",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (time signature) You and your allies gain a +2 status bonus to attack rolls."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Triple",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (time signature) You and your allies gain a +2 status bonus to Armor Class and Reflex saving throws."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "513051db-adea-54e0-9cb2-e07ea8d782dd"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.3ZxaIw1FOOocJboH"
    },
    "data": {
      "rank": 8,
