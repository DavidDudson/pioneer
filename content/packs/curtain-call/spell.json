        "type": "time",
        "count": 1,
        "unit": "minute",
        "sustained": true
      },
      "traditions": ["divine", "occult"],
      "damage": []
    }
  },
  {
    "id": "227ed2c9-0e60-542f-bd46-b1f9a4e18333",
    "pack": "curtain-call",
    "kind": "spell",
    "slug": "spell:reflected-beauty",
    "name": "Reflected Beauty",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["concentrate", "illusion", "manipulate", "visual"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you cast reflected beauty, choose a willing creature that's the same size as you and that you can see within 30 feet. The spell then disguises you with a realistic illusion, as if via "
          },
          {
            "type": "ref",
            "id": "adcc4c8f-05ae-5440-83d0-9e88ad22209b"
          },
          {
            "type": "text",
            "text": " heightened to 3rd rank, but includes tactile and olfactory sensation in addition to visual and voice. The appearance of the illusion that disguises you includes any changes to sex characteristics or other aspects needed to match the target creature's heart's desire, allowing you to interact with them as the person they could be. If you're ever more than 30 feet from the subject you're reflecting, "
          },
          {
            "type": "text",
            "text": "reflected beauty",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " immediately ends. You can Dismiss this spell."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.ghIoycTH6gxxAw3w"
    },
    "data": {
      "rank": 4,
      "time": {
        "type": "actions",
        "cost": "two"
      },
      "duration": {
        "type": "time",
        "count": 1,
        "unit": "hour"
      },
      "traditions": ["divine", "occult"],
      "damage": []
    }
  },
  {
    "id": "6bf6b6a5-c82a-5a0e-80b0-0376c8523952",
    "pack": "curtain-call",
    "kind": "spell",
    "slug": "spell:take-your-places",
    "name": "Take Your Places",
    "level": 8,
    "rarity": "rare",
    "traits": ["auditory", "concentrate", "linguistic", "manipulate", "teleportation"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The scene would play out exactly as you envisioned it, if only the actors would respect their blocking. You instantly transport the targeted creatures and any items they're wearing and holding from their current space to an unoccupied space within range. You don't need to be able to see the destinations as long as you've been there in the past and know its relative location and distance from each target. Creatures affected by take your places are then temporarily immune to this spell for 1 minute."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.bfdiKEZQLVvslcDi"
    },
    "data": {
      "rank": 8,
      "time": {
        "type": "actions",
        "cost": "two"
      },
      "range": {
        "type": "feet",
        "feet": 60
      },
      "targets": {
        "any": [
          {
            "count": 4,
            "upTo": true,
            "of": "creature",
            "qualifiers": ["willing"]
          }
        ]
      },
      "traditions": ["arcane", "occult"],
      "damage": []
    }
  },
  {
    "id": "95907aae-72dc-5f12-a4d9-f4ca3b789e76",
    "pack": "curtain-call",
    "kind": "spell",
    "slug": "spell:vibrant-vibrato",
    "name": "Vibrant Vibrato",
    "level": 7,
    "rarity": "rare",
    "traits": ["auditory", "aura", "concentrate", "manipulate", "sonic"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your voice trills in perfect vibrato. When casting the spell, you can make the area any radius you choose, up to 40 feet. The reverberations of your voice continue to shimmer and hang in the air as long as you Sustain the spell but can't be heard at all outside of the area. A creature must attempt a Will save if it's within the area when you Cast the Spell or as soon as it enters the area while the spell is in effect. Once a creature has attempted the save, it uses the same result for that casting of vibrant vibrato."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "5d10",
                "damageType": "sonic",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage at the end of their turn as long as they remain within the aura's area of effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, but if the creature leaves the area, or if you move far enough from the creature that they're no longer in the area, the creature hears a shattering sound and takes 5d10 sonic damage and is "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 1"
          },
          {
            "type": "text",
            "text": ". The creature is then "
          },
          {
            "type": "ref",
            "id": "4271da2e-7225-5aa7-9807-c499d8af6a5a"
          },
          {
            "type": "text",
            "text": " for the rest of the spell's duration."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the creature takes double the sonic damage and is "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 3"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage on a failed save increases by 1d10."
          }
        ]
      }
    ],
