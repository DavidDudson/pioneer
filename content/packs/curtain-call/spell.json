[
  {
    "id": "846dacf3-54b1-5703-af1f-9c2e5a7156d7",
    "pack": "curtain-call",
    "kind": "spell",
    "slug": "spell:missed-cue",
    "name": "Missed Cue",
    "level": 6,
    "rarity": "rare",
    "traits": ["concentrate", "emotion", "fear", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You make the spell's target believe they had something incredibly important to say but forgot to say it, and now they've missed their opportunity. Sensations of overwhelming panic akin to stage fright flood the target's mind, causing them to suffer excruciating mental anguish and take 12d6 mental damage. The target might even become filled with the conviction that they've doomed themselves by missing their cue. The target must attempt a Will save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The conviction of a missed cue is only a fleeting notion that passes quickly without any effect on the target."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes half damage and is "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes full damage and becomes "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 2"
          },
          {
            "type": "text",
            "text": ". In addition, the target is "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": " for as long as they remain frightened."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes double damage and becomes "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 3"
          },
          {
            "type": "text",
            "text": ". In addition, the target is slowed 1 for as long as they remain frightened."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases by 2d6."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.oCdcZ8EqoC1K0Drq"
    },
    "data": {
