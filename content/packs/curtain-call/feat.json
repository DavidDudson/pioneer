        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Celebrity or Gladiator Dedication"
            }
          ]
        }
      ],
      "action": {
        "cost": "reaction",
        "trigger": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "You're reduced to 0 Hit Points"
              }
            ]
          }
        ],
        "frequency": {
          "max": 1,
          "per": "day"
        }
      }
    }
  },
  {
    "id": "64136333-fab4-59d4-94aa-de5e0449c4f7",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:more-real-than-real",
    "name": "More Real Than Real",
