  {
    "id": "99629f0e-d88f-5ef3-850d-12f109100ea4",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:operatic-adventurer",
    "name": "Operatic Adventurer",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["archetype", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your training has focused you for the opera, and it certainly shows. You become master in Performance, and at 15th level your skill in Performance increases to Legendary. You also become expert in Theater Lore or become master in Theater Lore if you were already expert. When you're on a stage, in an arena, or otherwise at the focus of a crowd there to see you perform, your eagerness to begin grants a +3 circumstance bonus to initiative rolls if you roll Acrobatics, Intimidation, or Performance for initiative."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["initiative"],
        "type": "circumstance",
        "value": 3,
        "predicate": [
          {
            "or": ["option:acrobatics", "option:intimidation", "option:performance"]
          },
          {
            "or": ["terrain:arena", "terrain:stage", "terrain:crowd"]
          }
        ]
      }
    ],
