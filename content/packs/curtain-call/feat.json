          "content": [
            {
              "type": "text",
              "text": "Dandy Dedication; master in Deception"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "869a7dd4-283a-5e8b-ba66-e709d6a30b03",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:primadonna",
    "name": "Primadonna",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["archetype", "auditory", "visual"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The spotlight should always be on you and you alone. Attempt a "
          },
          {
            "type": "check",
            "statistic": "skill:performance"
          },
          {
            "type": "text",
            "text": " check against the Will DCs of all enemies within "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 30
          },
          {
            "type": "text",
            "text": " who can see or hear you. On a success, the targets focus on you and gain a +1 circumstance bonus to hit you, but they're "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " to all creatures other than yourself. On a critical success, the effect lasts for 3 rounds."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.pBP8KL1yPU3W1Kmh"
    },
    "data": {
