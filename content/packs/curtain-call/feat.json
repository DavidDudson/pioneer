  {
    "id": "de4abe7c-0d93-5fb6-888c-cb44e5f078d2",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:play-to-the-crowd-dandy",
    "name": "Play to the Crowd (Dandy)",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["archetype", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have a knack for knowing just how to manipulate groups by saying exactly what needs to be said. When you "
          },
          {
            "type": "ref",
            "id": "1ee7b671-dd18-5950-a4db-fbd4f8dae832"
          },
          {
            "type": "text",
            "text": " in a public area in front of a crowd, you can gauge the reactions of the crowd as you speak to know how your Lie is working, and Lie loses its secret trait. You gain the "
          },
          {
            "type": "ref",
            "id": "8da7a62e-1f34-5d0d-90fb-e3d039679496"
          },
          {
            "type": "text",
            "text": " reaction."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "GrantItem",
        "item": "8da7a62e-1f34-5d0d-90fb-e3d039679496"
      }
    ],
    "externalIds": {
