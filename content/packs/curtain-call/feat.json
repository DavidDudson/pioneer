  {
    "id": "ac062472-3a8e-5035-9c94-a8a12eda3796",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:its-not-over",
    "name": "It's Not Over",
    "level": 14,
    "rarity": "uncommon",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're reduced to 0 Hit Points"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In the world of drama, the finale of any performance doesn't have to be the end, and for you, this now extends to life itself. When damage reduces you to 0 Hit Points, you can use this reaction to suddenly spring back into action. Instead of gaining the dying condition and falling "
          },
          {
            "type": "ref",
            "id": "e1a78dad-4887-518e-9120-e58b7009ebfd"
          },
          {
            "type": "text",
            "text": ", you regain a number of Hit Points equal to "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10+@level+@attr.con"
              }
            ],
            "healing": true,
            "label": "10 + your level + your Constitution modifier"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.37l9SEvS7X1jHtpD"
    },
