  {
    "id": "816bc475-4941-5fe3-9b7f-8f0abc45a9fc",
    "pack": "curtain-call",
    "kind": "feat",
    "slug": "feat:gladiators-roar",
    "name": "Gladiator's Roar",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["archetype", "emotion", "fear", "mental", "sonic"],
    "sources": [
      {
        "kind": "book",
        "book": "curtain-call"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can project your voice into a high-pitched screech that damages your foes. Your roar can be heard twice as far as normal, and creatures within a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 15
          },
          {
            "type": "text",
            "text": " take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d10",
                "damageType": "sonic"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-or-spell-dc"
            }
          },
          {
            "type": "text",
            "text": " save against your class DC or spell DC, whichever is higher. If your Gladiator's Roar triggers Play to the Crowd, you gain a +2 status bonus to your Performance check to do so."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes half damage and becomes "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes full damage and becomes "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 2"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes double damage, becomes "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 3"
          },
          {
            "type": "text",
            "text": ", and is "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [],
