          {
            "type": "ref",
            "id": "f7dde84e-f48a-5bd2-8a3b-54c8757a4e87"
          },
          {
            "type": "text",
            "text": " spells and effects that are musical in nature. In addition, you gain the "
          },
          {
            "type": "ref",
            "id": "316108cc-88e7-5fe9-a3de-31ce43f175a3"
          },
          {
            "type": "text",
            "text": " action."
          }
        ]
      }
    ],
