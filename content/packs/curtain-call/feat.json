    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your ear for harmony has enhanced your ability with musical magic. You can use Performance to "
          },
          {
            "type": "ref",
            "id": "9122d740-ef57-5922-bc21-92179b61d03a"
          },
          {
            "type": "text",
            "text": " or "
