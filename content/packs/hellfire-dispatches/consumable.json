            "statistic": "save:fortitude",
            "dc": 24,
            "outcomes": {
              "criticalSuccess": [
                {
                  "type": "text",
                  "text": "The creature is unaffected."
                }
              ],
              "success": [
                {
                  "type": "text",
                  "text": "The creature takes half damage."
                }
              ],
              "failure": [
                {
                  "type": "text",
                  "text": "The creature takes full damage and is pushed 10 feet in the determined direction."
                }
              ],
              "criticalFailure": [
                {
                  "type": "text",
                  "text": "The creature takes double damage, is pushed 15 feet in the determined direction, and is drenched with water, taking a –1 circumstance penalty to saving throws against electricity effects for 1 minute."
