        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=413"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These tall, pointed boots are made from soft, supple black or green leather and are decorated with trim and buckles of gold. When worn, the boots allow you to move more nimbly, granting you a +2 item bonus to Acrobatics checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Until the end of your turn, you ignore difficult terrain when moving on the ground. If you're wearing a Cloak of Elvenkind, you also gain a +5-foot status bonus to your land Speed until the end of your turn, and greater boots of elvenkind constantly grant the effects of "
          },
          {
            "type": "ref",
            "id": "2e8fa114-9eeb-5deb-850d-60eded1b2255"
          },
          {
            "type": "text",
            "text": " (DC 30) in forest environments."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect: Boots of Elvenkind"
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:acrobatics"],
        "type": "item",
        "value": 2
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.8NgA4PFFXZPZ9SSg"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 1250
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "boots-of-elvenkind-greater",
          "name": "Boots of Elvenkind (Greater)",
          "frequency": {
            "max": 1,
            "per": "hour"
          }
        }
      ],
      "usage": {
        "type": "worn",
