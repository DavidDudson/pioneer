  {
    "id": "a4888e83-a05d-5ee5-b6d4-765b3c2089e6",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:cloak-of-elvenkind-greater",
    "name": "Cloak of Elvenkind (Greater)",
    "level": 12,
    "rarity": "common",
    "traits": ["illusion", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=424"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This cloak is deep green with a voluminous hood, embroidered with gold trim and symbols significant in elven culture. The cloak allows you to cast the "
          },
          {
            "type": "ref",
            "id": "8ad0ebfc-593b-5631-b93e-122a74cb8574"
          },
          {
            "type": "text",
            "text": " cantrip as an arcane innate spell."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you adjust the cloak's clasp (an Interact action), the cloak transforms to match the environment around you and muffles your sounds, granting you a +2 item bonus to Stealth checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect: Cloak of Elvenkind (Greater)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You draw the hood up and gain the effects of a 4th-rank "
          },
          {
            "type": "ref",
            "id": "e8221b18-c4c7-5d99-a604-a3cf119d41b1"
          },
          {
            "type": "text",
            "text": ", with the spell's normal duration or until you pull the hood back down, whichever comes first."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you're also wearing Boots of Elvenkind, you can activate this ability twice per day, and it allows you to Sneak in forest environments even when creatures are currently observing you."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.ZelCRLDI6M5IfjAI"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 1750
