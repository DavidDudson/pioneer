  {
    "id": "3909d9ea-f7a7-5f33-a7b2-b376b76e0316",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:cassock-of-devotion",
    "name": "Cassock of Devotion",
    "level": 11,
    "rarity": "common",
    "traits": ["divine", "focused", "invested"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=420"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each "
          },
          {
            "type": "text",
            "text": "cassock of devotion",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " depicts scenes related to the domains of a certain deity. It serves as a religious symbol of that deity, and it doesn't need to be wielded to provide that benefit. You gain a +2 item bonus to Religion checks and a +1 item bonus to the divine skill of the deity to whom the cassock is dedicated."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain 1 Focus Point, which you can spend only to cast a cleric domain spell for a domain belonging to the deity the cassock is dedicated to. If you don't spend this Focus Point by the end of this turn, it is lost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are a cleric who worships the deity tied to the cassock."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:religion"],
        "type": "item",
        "value": 2
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.62vH66XLehPiRwwo"
    },
