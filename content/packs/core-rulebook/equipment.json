  {
    "id": "7344aac6-d509-5b37-aee3-2a03ebf8c31d",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:belt-of-giant-strength",
    "name": "Belt of Giant Strength",
    "level": 17,
    "rarity": "common",
    "traits": ["apex", "invested"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=398"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This thick leather belt is decorated with a buckle carved from glittering quartz in the shape of a fist. You gain a +3 item bonus to Athletics checks and a +2 circumstance bonus to Athletics checks to lift a heavy object, Escape, and Force Open."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you invest the belt, you either increase your Strength score by 2 or increase it to 18, whichever would give you a higher score."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are targeted by a thrown rock attack, or a rock would fall on you"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Attempt an Athletics check to grab the triggering rock. Use the Athletics DC of the creature throwing the rock, the DC of the hazard or other effect, or DC 35 if no other DC is applicable. You must have a free hand to catch the rock, but you can Release anything you're holding in a hand as part of this reaction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You safely catch the rock, take no damage, and are now holding the rock."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You take half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You take full damage."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:athletics"],
        "type": "item",
        "value": 3
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:athletics"],
        "type": "circumstance",
        "value": 2,
        "predicate": [
          {
            "or": ["action:lift-heavy-object", "action:escape", "action:force-open"]
          }
        ],
        "display": {
          "label": "Belt of Giant Strength (lift heavy objects, Escape, Force Open)"
        }
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.7utuH8VJjKEzKtNw"
    },
    "data": {
      "price": {
