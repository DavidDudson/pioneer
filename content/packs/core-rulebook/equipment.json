[
  {
    "id": "9e4552af-36c9-5d9b-b161-121a15956337",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:anklets-of-alacrity",
    "name": "Anklets of Alacrity",
    "level": 17,
    "rarity": "common",
    "traits": ["apex", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=397"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These gem-studded golden anklets give you a +3 item bonus to Acrobatics checks. When you invest the anklets, you either increase your Dexterity score by 2 or increase it to 18, whichever would give you a higher score."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You click the anklets together, gaining a +20-foot status bonus to all your Speeds and the effects of "
          },
          {
            "type": "ref",
            "id": "62b9b05e-2f86-5c8b-bc12-2500cd4d9959"
          },
          {
            "type": "text",
            "text": " for the next 10 minutes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect: Anklets of Alacrity"
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:acrobatics"],
        "type": "item",
        "value": 3
      }
    ],
