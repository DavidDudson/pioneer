        "value": 3,
        "predicate": [
          "action:craft",
          {
            "or": ["option:snare", "option:trap"]
          }
        ],
        "display": {
          "label": "Ring of Maniacal Devices (Craft snares and traps)"
        }
      },
      {
        "key": "FlatModifier",
