  {
    "id": "b138ba55-bdf9-599a-9b61-d5380776a4fa",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:rod-of-wonder",
    "name": "Rod of Wonder",
    "level": 8,
    "rarity": "rare",
    "traits": ["chaotic", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=265"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This peculiar rod is strange and unpredictable. Each time it is activated, it produces one of a variety of effects at random."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " command, Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Choose a creature within 60 feet and roll d% on the table below to determine the rod's effect. If an entry lists only a spell name, the rod casts that spell at its lowest level. You make any decisions for a spell cast by the rod unless otherwise indicated, except that it must target the creature you chose, or the creature you chose must be the center of the spell's area, if it has an area but no targets. If the spell's range is less than 60 feet, increase the range to 60 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Any spell DC required is DC 27, and any spell attack roll required is 1d20+17. If the rod casts a spell on you, you don't get a saving throw or other defense against it."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Once activated, the rod can't be activated again for 1d4 hours."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Roll on the Rod of Wonder table to determine the outcome."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.6wVWwpL9pYr3yQtt"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 465
        }
      },
      "bulk": "light",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "8aa38d45-9d93-589a-aa21-6dc99035237a",
    "pack": "core-rulebook",
    "kind": "equipment",
    "slug": "equipment:slippers-of-spider-climbing",
    "name": "Slippers of Spider Climbing",
    "level": 7,
    "rarity": "common",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=465"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These soft slippers are made of fine gray silk. If the slippers are left unattended for a while, they tend to attract spiders that nest inside."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " command"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Tiny, hairlike tendrils extend from the slippers' soles, allowing you to walk on vertical surfaces or even to move upside down along ceilings."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "For 1 minute, you gain a 20-foot climb Speed and you don't need to use your hands to Climb. However, the slippers require decent traction for you to walk on a wall, so they provide no benefit when you're moving across greased, icy, or oiled surfaces."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect: Slippers of Spider Climbing"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.skBa6D1uxb0b2USn"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 325
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "slippers-of-spider-climbing",
          "name": "Slippers of Spider Climbing",
          "frequency": {
            "max": 1,
            "per": "hour"
          }
        }
      ],
      "usage": {
        "type": "worn",
        "slot": "shoes"
      }
    }
  },
