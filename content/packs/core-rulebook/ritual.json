        "feet": 10
      },
      "cost": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "reagents to construct the magical prison worth a total value of 800 gp × the target's level"
            }
          ]
        }
      ],
      "primary": {
        "skills": ["skill:arcana", "skill:occultism"],
        "proficiency": "legendary"
      },
      "secondary": {
