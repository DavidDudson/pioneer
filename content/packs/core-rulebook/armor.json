  {
    "id": "3d5b4d40-e584-5b3f-83b4-6a3934c1bc6e",
    "pack": "core-rulebook",
    "kind": "armor",
    "slug": "armor:celestial-armor",
    "name": "Celestial Armor",
    "level": 13,
    "rarity": "common",
    "traits": ["divine", "flexible", "good", "invested", "noisy"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=149"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This suit of +2 resilient chain mail is made of fine white links of a strange and slightly translucent pale metal, and the sleeves and skirt are fashioned into smaller trails that resemble feathers. Unlike normal chain mail, celestial armor has no Speed reduction, its armor check penalty is 0, and its Bulk is 1."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain a +1 circumstance bonus to AC and saving throws against fiends. You appear radiant while you wear the armor, giving you a +2 item bonus to Diplomacy checks against all creatures except fiends."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you are not good, you are "
          },
          {
            "type": "ref",
            "id": "fa3d4a94-c2f9-519b-b0a3-82d2612e188b",
            "label": "Drained 2"
          },
          {
            "type": "text",
            "text": " while wearing "
          },
          {
            "type": "text",
            "text": "celestial armor",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". You can't recover from this condition while wearing the armor."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " command"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The armor sprouts glowing wings that grant you a fly Speed of 30 feet. The wings shed bright light in a 40-foot radius (and dim light to the next 40 feet). The wings fade away after 10 minutes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "cbe3d144-da06-542b-82a1-8fe11364bb4a"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are good."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["ac", "saving-throw"],
        "type": "circumstance",
        "value": 1,
        "predicate": ["origin:trait:fiend"]
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:diplomacy"],
        "type": "item",
        "value": 2,
        "predicate": [
          {
            "not": "target:trait:fiend"
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.2uHcTZ40oZ62R9gy"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 2500
        }
      },
