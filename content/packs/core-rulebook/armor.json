  {
    "id": "ef36635f-54cd-505f-b679-2f17a2f725fd",
    "pack": "core-rulebook",
    "kind": "armor",
    "slug": "armor:demon-armor",
    "name": "Demon Armor",
    "level": 13,
    "rarity": "common",
    "traits": ["bulwark", "divine", "evil", "invested"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=150"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Crafted from black iron, this crude suit of +2 resilient full plate is designed to make you look like a horned demon, with your face peering out of the screaming maw of the beast."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "While wearing the armor, you can attack with the helmet's horns. They are a martial melee weapon with the effects of a "
          },
          {
            "type": "text",
            "text": "+2 weapon potency rune",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". They deal 2d8 piercing damage and have the deadly d12 trait. On a critical hit with the horns, the target must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 30
          },
          {
            "type": "text",
            "text": " against the Abyssal plague disease. The horns can't be etched with any runes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you aren't evil, you're "
          },
          {
            "type": "ref",
            "id": "fa3d4a94-c2f9-519b-b0a3-82d2612e188b",
            "label": "Drained 2"
          },
          {
            "type": "text",
            "text": " and can't recover from this condition while wearing "
          },
          {
            "type": "text",
            "text": "demon armor",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " Command"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You cast "
          },
          {
            "type": "ref",
            "id": "e25a3eab-3b7d-56fd-90e2-98d892fdc8fd"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are evil; supply one casting of "
          },
          {
            "type": "text",
            "text": "dimension door",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.hYBZK1kaGPeR85CH"
    },
