  {
    "id": "0c42c9cf-d26c-5cb4-b51f-a4e57701b4c1",
    "pack": "core-rulebook",
    "kind": "armor",
    "slug": "armor:robe-of-the-archmagi",
    "name": "Robe of the Archmagi",
    "level": 15,
    "rarity": "uncommon",
    "traits": ["comfort"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Embroidered with fine silver thread in ornate arcane patterns, these robes come in one of three colors depending on their attuned alignment. Good robes are gold, neutral robes are light blue, and evil robes are red. An evil or good robe gains the appropriate trait. The robes benefit only characters who can cast arcane spells and whose alignment on the good-evil axis matches that of the robe. If your alignment does not match that of the robe, or you are not an arcane spellcaster, you are instead "
          },
          {
            "type": "ref",
            "id": "9e1dad43-36fe-5629-923f-2df63c12d90f",
            "label": "Stupefied 2"
          },
          {
            "type": "text",
            "text": " while wearing a "
          },
          {
            "type": "text",
            "text": "robe of the archmagi",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". This condition can't be removed in any way until you remove the robe."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The robes are "
          },
          {
            "type": "text",
            "text": "+2 greater resilient explorer's clothing",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", and they grant a +1 circumstance bonus to saving throws against arcane spells and resistance 5 to damage from arcane spells."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " command"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You attempt a saving throw against an arcane spell, but you haven't rolled yet"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You automatically succeed at your save against the triggering arcane spell."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are an arcane spellcaster."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["saving-throw"],
        "type": "circumstance",
        "value": 1,
        "predicate": ["item:trait:arcane", "item:type:spell", "self:caster:tradition:arcane"],
        "display": {
          "label": "Robe of the Archmagi (vs. Arcane Spells)"
        }
      },
      {
        "key": "AdjustModifier",
        "selectors": ["saving-throw"],
        "slug": "resilient",
        "suppress": true,
        "predicate": [
          {
            "not": "self:caster:tradition:arcane"
          }
        ]
      },
      {
        "key": "AdjustModifier",
        "selectors": ["ac"],
        "slug": "explorers-clothing",
        "suppress": true,
        "predicate": [
          {
            "not": "self:caster:tradition:arcane"
          }
        ]
      },
      {
        "key": "GrantItem",
        "item": "9e1dad43-36fe-5629-923f-2df63c12d90f",
        "value": 2,
        "predicate": [
          {
            "not": "self:caster:tradition:arcane"
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.Wkh5rQx3IqInEKdT"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 6500
        }
      },
      "bulk": 1,
      "activations": [
        {
          "slug": "robe-of-the-archmagi",
