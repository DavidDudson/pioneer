    "name": "Hero's Defiance",
    "level": 19,
    "rarity": "common",
    "traits": ["champion"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=394"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can defy fate and continue fighting as long as you have divine energy. You gain the "
          },
          {
            "type": "ref",
            "id": "0790892e-5c64-5b5b-82ee-899a09ccf6da"
          },
          {
            "type": "text",
            "text": " devotion spell."
          }
        ]
      }
    ],
    "rules": [],
