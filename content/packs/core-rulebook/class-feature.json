[
  {
    "id": "33b4b6bb-7c49-5065-b675-76ed92d0e4c2",
    "pack": "core-rulebook",
    "kind": "class-feature",
    "slug": "class-feature:bomber",
    "name": "Bomber",
    "level": 1,
    "rarity": "common",
    "traits": ["alchemist"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/ResearchFields.aspx?ID=1"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You specialize in explosions and other violent alchemical reactions. You start with the formulas for two common 1st-level alchemical bombs, in addition to your other formulas."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your research field adds a number of formulas to your formula book; these are your signature items. When using a batch of Infused Reagents to create your signature items using "
          },
          {
            "type": "ref",
            "id": "941d4a1c-a6b7-5123-b992-fe1d82e8bc52"
          },
          {
            "type": "text",
            "text": ", you create three items instead of two. Each time you gain a level, you can swap one of your signature items with another formula in your formula book. This new signature item must be on your research field's list of possible signature items."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When throwing an alchemical bomb with the splash trait, you can deal splash damage to only your primary target instead of the usual splash area."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "content": [
          {
            "type": "ref",
            "id": "9086046b-62e1-505a-94ca-d60c04b53861",
            "label": "Field Discovery"
          },
          {
            "type": "text",
            "text": "Level 5"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When using Advanced Alchemy to make bombs during your daily preparations, you can use a batch of reagents to create any three bombs instead of just two of the same bomb."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "content": [
          {
            "type": "text",
            "text": "Perpetual InfusionsLevel 7"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have learned how to create perpetual alchemical infusions that can provide a near-infinite supply of certain simple items. You gain the ability to create two 1st-level alchemical items using "
          },
          {
            "type": "ref",
            "id": "ef01dc12-d06f-5f19-a1f3-097f23cd75a9"
          },
          {
            "type": "text",
            "text": " without spending a batch of infused reagents. The items you can select depend on your research field and must be in your formula book."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each time you gain a level, you can swap any number of your perpetual infusions with other eligible infusions."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two 1st-level bombs."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "content": [
          {
            "type": "text",
            "text": "Perpetual PotencyLevel 11"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your perpetual infusions improve, allowing you to use Quick Alchemy to create more powerful items with no cost. The items you can select depend on your research field and must be in your formula book."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The moderate versions of the bombs you chose for perpetual infusions."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "content": [
          {
            "type": "ref",
            "id": "538b2444-4cc7-5bd7-8ff6-149ffd5112e2",
            "label": "Greater Field Discovery"
          },
          {
            "type": "text",
            "text": "Level 13"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can increase the splash on your bombs to damage creatures within 10 feet, or 15 feet if you have "
          },
          {
            "type": "ref",
            "id": "3e128ba5-8a6b-56f7-9b38-c294a7e3b652"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "content": [
          {
            "type": "text",
            "text": "Perpetual PerfectionLevel 17"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have perfected your perpetual infusions, allowing you to use Quick Alchemy to create even more powerful items at no cost. The items you can select depend on your research field and must be in your formula book."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The greater versions of the bombs you chose for perpetual infusions."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Note",
        "selectors": ["strike-damage"],
        "title": "Bomber",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "You can deal splash damage to only your primary target instead of the usual splash area."
              }
            ]
          }
        ],
        "predicate": ["option:alchemical", "option:bomb", "option:splash"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.classfeatures.Item.7JbiaZ8bxODM5mzS"
    },
    "data": {
      "tags": ["alchemist-research-field"]
    }
  },
