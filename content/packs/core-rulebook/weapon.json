      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This staff of magically hardened wood is topped with a silver sculpture depicting magical runic symbols. When used as a weapon, a "
          },
          {
            "type": "text",
            "text": "staff of power",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is a "
          },
          {
            "type": "text",
            "text": "+2 greater striking staff",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Voluntarily destroying a "
          },
          {
            "type": "text",
            "text": "staff of power",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " unleashes an incredible blast of energy. When wielding the staff, you can Interact to break it. This releases a "
          },
          {
            "type": "template",
            "shape": "burst",
            "size": 30
          },
          {
            "type": "text",
            "text": " magical explosion centered on the staff. This deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d8",
                "damageType": "force"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage per charge remaining in the staff ("
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 40,
            "basic": true
          },
          {
            "type": "text",
            "text": "). You automatically critically fail your save. A creature reduced to 0 Hit Points by this damage dies instantly; this is a death effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Cast a Spell"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
