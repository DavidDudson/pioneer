  {
    "id": "4933f860-22c5-552b-9575-7702f262fe75",
    "pack": "core-rulebook",
    "kind": "weapon",
    "slug": "weapon:oathbow",
    "name": "Oathbow",
    "level": 11,
    "rarity": "common",
    "traits": ["deadly-d10", "magical", "propulsive", "volley-30"],
    "sources": [
      {
        "kind": "book",
        "book": "core-rulebook",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=392"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Constructed of a flexible, white wood and with ornate, twisting designs carved into its surface, this +2 striking composite longbow appears to have been made by elves. Sometimes when you loose an arrow, its whistling in flight sounds like a voice whispering in Elven, wishing for the swift defeat of your enemies."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " command"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You swear an oath to destroy one creature you can see. For the next 7 days or until that creature is slain, your attacks with the bow against that creature deal 1d6 additional damage, and you gain a +2 circumstance bonus to Survival checks to Track that creature."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your critical hits against the target gain the bow's critical specialization effect; if they would already do so, they instead increase the DC of the Athletics check to Escape when critically hit to DC 20."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "After you activate the bow, you can't activate it again for 7 days. If you kill the creature you've sworn an oath against, the oath ends and you need to wait only 10 minutes before you can activate it again."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "domain": "all",
        "option": "target:oathbow",
        "toggleable": true,
        "display": {
          "label": "Target is Oathbow's sworn target"
        }
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["target:oathbow"],
        "display": {
          "label": "Oathbow (tracking Oathbow's sworn target)"
        }
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.bheWnrBqMphBRUmn"
    },
    "data": {
      "price": {
