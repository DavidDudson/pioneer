  {
    "id": "2261a1fe-1025-5a08-b561-a263cf9fed4d",
    "pack": "troubles-in-grayce",
    "kind": "equipment",
    "slug": "equipment:lucky-copper",
    "name": "Lucky Copper",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["fortune", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These coins—copper, silver, or gold depending on their potency—were not minted for circulation. Rather, friendly fey helped to create them as wards against the abilities of some gremlins, namely pugwampis. The coins are said to protect the bearer against misfortunes of all stripes, though, not merely those of gremlins and have come to be seen as good luck charms the world over. Each coin, regardless of the metal used to mint it, has a canine face on both sides; on one side, the face's mouth is open in a wide smile, while the other shows the face snarling."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Guarded Fortune",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (fortune, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You fail a skill check due to a misfortune effect"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Flip the coin. If it lands on the smiling face, reroll the triggering check; since this activation has the fortune effect, any misfortune effect is canceled out for this check. You must use the new result, even if it's worse. If it lands on the snarling face, nothing happens. Either way, you're temporarily immune to Guarded Fortune for 1 hour."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Any checks made to craft this item while under a misfortune effect are automatic critical failures."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.awtacA9swoKxH8fY"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 30
        }
      },
      "bulk": "negligible",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
