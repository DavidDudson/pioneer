            "instances": [
              {
                "formula": "1d8",
                "damageType": "poison"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
