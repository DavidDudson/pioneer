[
  {
    "id": "ce326d78-4315-555a-8504-3462ec7135cb",
    "pack": "troubles-in-grayce",
    "kind": "equipment",
    "slug": "equipment:floppy-rag-doll",
    "name": "Floppy Rag Doll",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce",
        "page": 117,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4942"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This simple doll is made with scraps of cloth tied or sewn together into a basic humanoid shape, but its appearance belies its strange power over the actions of others. The head and limbs of the doll constantly droop and sway slightly, never able to remain in one position for very long. Whoever holds a "
          },
          {
            "type": "text",
            "text": "floppy rag doll",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " can feel it squirming in their grasp."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Loose Limbs",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate, visual)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You brandish the "
          },
          {
            "type": "text",
            "text": "floppy rag doll",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " at a creature within 30 feet who can see you and shake it about. The creature's own limbs begin moving wildly in a similar fashion, and they must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 19,
            "options": ["inflicts:clumsy"],
            "outcomes": {
              "criticalSuccess": [{ "type": "text", "text": "The target is unaffected." }],
              "success": [{ "type": "text", "text": "The target can't use reactions until the end your turn." }],
              "failure": [
                { "type": "text", "text": "The target is " },
                { "type": "ref", "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8", "label": "Clumsy 1" },
                { "type": "text", "text": " and can't use reactions until the beginning of your next turn." }
              ],
              "criticalFailure": [
                { "type": "text", "text": "As failure, but " },
                { "type": "ref", "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8", "label": "Clumsy 2" }
              ]
            }
          },
          {
            "type": "text",
            "text": " saving throw."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target can't use reactions until the end your turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is "
          },
          {
            "type": "ref",
            "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8",
            "label": "Clumsy 1"
          },
          {
            "type": "text",
            "text": " and can't use reactions until the beginning of your next turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but "
          },
          {
            "type": "ref",
            "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8",
            "label": "Clumsy 2"
          }
        ]
      }
