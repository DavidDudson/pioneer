    "traits": ["consumable", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4947"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A humanoid shape has been cut out of a single sheet of colored paper with a face and clothes drawn on. The face looks slightly worried, as if the doll knows what it was made for. You hold up the paper doll in two hands and rip it half, focusing your thoughts on a creature within 20 feet that you can see. That creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "3d6",
                "damageType": "slashing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 18,
            "basic": true
          },
          {
            "type": "text",
            "text": " save) as the tears of the paper doll are mimicked on its body."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.zoW4lVigBoxl73Eg"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 11
        }
      },
      "bulk": "negligible",
      "category": "other",
      "usage": {
        "type": "held",
        "hands": "two"
      }
    }
  }
]
