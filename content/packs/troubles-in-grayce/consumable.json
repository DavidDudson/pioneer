          "gp": 20
        }
      },
      "bulk": "negligible",
      "category": "talisman",
      "usage": {
        "type": "affixed",
        "to": "armor"
      }
    }
  },
  {
    "id": "963ff022-99c8-5494-9ff1-893a214b1ecf",
    "pack": "troubles-in-grayce",
    "kind": "consumable",
    "slug": "consumable:hagbane-biscuit",
    "name": "Hagbane Biscuit",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["alchemical", "consumable", "processed"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5192"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This gingerbread biscuit is stamped in the shape of a menacing witch, her features decorated with anise and fennel seeds. When you eat the biscuit, its sharp spices warm your body for 10 minutes, granting you a +1 status bonus Perception checks to pierce a hag's disguise, to skill checks to "
          },
          {
            "type": "ref",
            "id": "3c873e49-a1c4-53b5-9694-66b860d94d43"
          },
          {
            "type": "text",
            "text": " about hags, and to saving throws made against hags' abilities and spells. During this time, weapons you wield count as cold iron for any physical attacks made against hags."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The biscuit tastes especially bitter to hags, changelings, and other hag-related creatures (such as a sorcerer with the hag bloodline). If such a creature attempts to eat the biscuit, they must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 18,
            "options": ["inflicts:sickened"]
          },
          {
            "type": "text",
            "text": " save or it fails and wastes the action (and is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": " on a critical failure)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.ZY0XGD1LFFSh3VNO"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 10
        }
      },
      "bulk": "negligible",
      "category": "other",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "18bfb3dc-5500-5ea8-ac5a-5d6dd521436a",
    "pack": "troubles-in-grayce",
    "kind": "consumable",
    "slug": "consumable:last-word-stone",
    "name": "Last Word Stone",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["consumable", "divine"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4944"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This small, palm-sized smooth crystal has a translucent gray coloration. But with a whisper from the lips of the desperate, a "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " can be filled with a spark of memory, changing its appearance to an opaque, polished stone that is strangely warm to the touch. These divinely infused objects were initially created by Pharasmin priests to preserve a dying person's last moment of life should loved ones be delayed in their arrival at the dying person's side. But with the tragedy of Lastwall, "
          },
          {
            "type": "text",
            "text": "last word stones",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " have gained a new, more desperate purpose. Here, along the Gravelands border regions, refugees and adventurers have taken to using "
          },
          {
            "type": "text",
            "text": "last word stones",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to impart important details to recipients outside of endangered places when it seems likely they won't survive to spread the news themselves."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Capture Memory",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " doesn't contain a memory"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You press an empty "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to an adjacent willing creature's head. The stone fills with an important memory from the creature's mind, then becomes opaque in appearance. The memory is duplicated, and remains in the target creature's thoughts, but no indication of what type of memory is held within the stone is discernible to anyone else. Which memory is placed in the "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is chosen by the creature from whom the memory is copied, and once a memory is stored, the stone can't be used again to Capture Memory. A stored memory can't contain much information beyond a single emotion and a hazy mental picture that, taken together, convey a short message of no more than 10 words—typically enough to impart final words of comfort to a loved one, or to warn one of a specific location that might be trapped, or to impart a bit of news about a noteworthy event. The limit of 10 words represents the hazy and sometimes confusing nature of the mental image."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Reveal Memory",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " contains a memory"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You hold the "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to your head and concentrate on its contents. A moment later, the stored memory plays out in your mind and the "
          },
          {
            "type": "text",
            "text": "last word stone",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " crumbles to dust in your hand."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.tAGWI3br9PO4It6R"
    },
