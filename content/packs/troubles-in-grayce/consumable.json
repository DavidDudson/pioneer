    "name": "Guardian Rose",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["consumable", "healing", "magical", "talisman"],
    "sources": [
      {
        "kind": "book",
        "book": "troubles-in-grayce",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4943"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You would be reduced to 0 Hit Points but not immediately killed."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This rose-shaped crystal brooch is a translucent bloodred. These talismans have saved the lives of many a soldier on the field of battle. When you activate a "
          },
          {
            "type": "text",
            "text": "guardian rose",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", you avoid being knocked out and regain "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d8+5"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points. However, this puts a strain on your body and you are "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 1"
          },
          {
            "type": "text",
            "text": " until the end of your next turn."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.MBKnfr5EW60lpWBL"
    },
    "data": {
