    "traits": ["alchemical", "bomb", "consumable", "light"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers",
        "page": 230,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4022"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Strike"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This vial of glowing goo constantly sheds dim light in a 10-foot radius. When a bioluminescence bomb strikes a creature or a hard surface, it shatters and releases the bioluminescent fluid's energy in a flare of light. Each creature within "
          },
          {
            "type": "template",
            "shape": "burst",
            "size": 10
          },
          {
            "type": "text",
            "text": " of where the bomb exploded must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 17
          },
          {
            "type": "text",
            "text": " or be marked with dye that continues to glow for 24 hours. An affected creature must also attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 17,
            "outcomes": {
              "success": [{ "type": "text", "text": "The creature is unaffected." }],
              "failure": [
                { "type": "text", "text": "The creature is " },
                { "type": "ref", "id": "943dfd55-ad09-5abf-9138-95a6149d3302" },
                { "type": "text", "text": " for 1 round." }
              ],
              "criticalFailure": [
                { "type": "text", "text": "The creature is " },
                { "type": "ref", "id": "5d63458a-cde5-5d64-8fea-b920f04f36b7" },
                { "type": "text", "text": " for 1 round, then dazzled for 1 round." }
              ]
            }
          },
          {
            "type": "text",
            "text": " saving throw against the overwhelming burst of light."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is "
          },
          {
            "type": "ref",
            "id": "943dfd55-ad09-5abf-9138-95a6149d3302"
          },
          {
            "type": "text",
            "text": " for 1 round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is "
          },
          {
