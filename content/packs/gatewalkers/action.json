  },
  {
    "id": "98fca967-e8d7-5889-9a74-e0a7f5d13c7b",
    "pack": "gatewalkers",
    "kind": "action",
    "slug": "action:blackfrost-dead-ice-climb",
    "name": "(Blackfrost Dead) Ice Climb",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The blackfrost dead can climb on ice as though it had the listed climb Speed. It ignores difficult terrain and greater difficult terrain from ice and snow and doesn't risk falling when crossing ice."
          }
        ]
      }
