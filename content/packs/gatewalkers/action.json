    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When the blackfrost dead is destroyed, its body shatters like brittle ice, filling the air around it with a cloud of frigid, razor-sharp ice shards. Creatures in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 10
          },
          {
            "type": "text",
            "text": " take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d8",
                "damageType": "cold"
              }
            ]
          },
          {
            "type": "text",
            "text": " per level of the blackfrost dead (minimum 3d8), with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "basic": true,
            "options": ["inflicts:bleed"]
          },
          {
            "type": "text",
            "text": " save. Creatures that critically fail this save also take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "bleed"
              }
            ]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
