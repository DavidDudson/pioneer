  {
    "id": "e375de02-8f37-5a97-b821-27e8a82ddfc3",
    "pack": "gatewalkers",
    "kind": "effect",
    "slug": "effect:effect-spirit-guide-form",
    "name": "Effect: Spirit Guide Form",
    "level": 14,
    "rarity": "common",
    "traits": ["polymorph"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Granted by "
          },
          {
            "type": "ref",
            "id": "8c210356-34d0-5b1e-8846-14976ec6843e"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You fuse with your spirit guide, becoming a hybrid being with enhanced physical and spiritual power. This effect lasts 1 minute; you can end it early as a free action. During this time, you can't use any other actions granted by this archetype. You gain the following statistics and abilities, regardless of your type of spirit guide."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You become incorporeal."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "You gain resistance 10 to all damage (except force, "
                },
                {
                  "type": "text",
                  "text": "ghost touch",
                  "marks": ["emphasis"]
                },
                {
                  "type": "text",
                  "text": ", or spirit; double resistance vs. non-magical)."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Darkvision."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "An unarmed melee attack of the same type as your spirit guide (either claws or jaws), which is the only attack you can Strike with. You're trained with this attack. Your attack modifier is +29 or your normal unarmed attack modifier, whichever is higher. You use the listed statistics for the unarmed attack type:"
                }
              ]
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Claws",
                        "marks": ["strong"]
                      },
                      {
                        "type": "text",
                        "text": " (agile, backstabber, finesse) "
                      },
                      {
                        "type": "action-cost",
                        "cost": "one"
                      },
                      {
                        "type": "text",
                        "text": ", "
                      },
                      {
                        "type": "text",
                        "text": "Damage",
                        "marks": ["strong"]
                      },
                      {
                        "type": "text",
                        "text": " 3d6+5 slashing plus 1d6 force;"
                      }
                    ]
                  }
                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Jaws",
                        "marks": ["strong"]
                      },
                      {
                        "type": "text",
                        "text": " (forceful) "
                      },
                      {
                        "type": "action-cost",
                        "cost": "one"
                      },
                      {
                        "type": "text",
                        "text": ", "
                      },
                      {
                        "type": "text",
                        "text": "Damage",
                        "marks": ["strong"]
                      },
                      {
                        "type": "text",
                        "text": " 3d10+5 piercing plus 1d6 force."
                      }
                    ]
                  }
                ]
              ]
            }
          ]
        ]
      }
    ],
    "rules": [
      {
        "key": "ChoiceSet",
        "flag": "spirit-guide-form",
        "choices": [
          {
            "value": "claw",
            "label": "Claw"
          },
          {
            "value": "jaws",
            "label": "Jaws"
          }
        ],
        "prompt": "Select an unarmed attack.",
        "rollOption": "spirit-guide-form"
      },
      {
        "key": "ActorTraits",
        "add": ["incorporeal"]
      }
    ],
