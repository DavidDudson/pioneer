    "slug": "consumable:psychic-colors-elixir",
    "name": "Psychic Colors Elixir",
    "level": 8,
    "rarity": "uncommon",
    "traits": ["alchemical", "consumable", "elixir"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This orange liquid lets you visibly detect the psychic energies that enable telekinesis and telepathy. For the next minute, you can sense if a creature you can see is using a telepathic or telekinetic ability, such as the telepathy monster ability, a spell like "
          },
          {
            "type": "ref",
            "id": "ed1f3941-7c08-5015-b12a-2017b44f68e3"
          },
          {
            "type": "text",
            "text": ", or similar abilities. You also can sense if an object or creature you can see is being manipulated or contacted by such an ability. Both the user and the target of the ability are outlined in faint shimmers of matching color."
          }
        ]
      }
    ],
    "rules": [],
