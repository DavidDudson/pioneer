    "slug": "consumable:draft-of-stellar-radiance",
    "name": "Draft of Stellar Radiance",
    "level": 3,
    "rarity": "rare",
    "traits": ["consumable", "light", "magical", "potion"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers"
