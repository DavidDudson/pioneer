    "slug": "consumable:star-of-cynosure",
    "name": "Star of Cynosure",
    "level": 10,
    "rarity": "uncommon",
    "traits": ["consumable", "magical", "talisman"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You attempt a Will save against a mental spell, but you haven't rolled yet"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You have master proficiency in Will saves."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Found throughout Golarion, these star-shaped talismans of whalebone scrimshaw are carved by the Erutaki people from the Crown of the World. They are popular with adherents to the cult of Desna, who believe the talismans protect their dreams."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you activate this talisman, you gain a +2 status bonus to saves against spells with the mental trait for 1 minute. On the triggering save, if the outcome of the roll is a failure, you get a success instead, or if the outcome is a critical failure, you get a failure instead."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "35cdff9e-48e5-5573-ae6d-4ea0dd21276b"
          }
        ]
      }
    ],
