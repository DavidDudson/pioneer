  {
    "id": "06c0b5d1-e4f5-5330-bc88-cbdf3ca5abcb",
    "pack": "gatewalkers",
    "kind": "spell",
    "slug": "spell:lashing-rope",
    "name": "Lashing Rope",
    "level": 3,
    "rarity": "common",
    "traits": ["attack", "concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2536",
        "page": 234
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You cause a section of rope or a rope-like object to animate, slither to your square, and encircle you, wreathing you in twisting, lashing fibers."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you Cast the Spell and each time you Sustain the Spell, you can make a melee Strike with the rope, which uses and contributes to your multiple attack penalty. These rope Strikes are melee spell attacks; have the magical, reach, and trip weapon traits; and deal 3d6 slashing damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you critically fail a check to "
          },
          {
            "type": "ref",
            "id": "6257c7f0-f483-53d3-a791-d73a616cbce4"
          },
          {
            "type": "text",
            "text": " using the rope, you can't make any more Strikes with it this turn, nor can you use it to make an Attack of Opportunity until the beginning of your next turn. This replaces the usual results of a critical failure to Trip."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage from your rope Strikes increases by 2d6."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.sbTxe4CGP4tn6y51"
    },
