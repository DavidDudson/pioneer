    "kind": "spell",
    "slug": "spell:advanced-scurvy",
    "name": "Advanced Scurvy",
    "level": 2,
    "rarity": "common",
    "traits": ["concentrate", "disease", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2534",
        "page": 233
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your touch afflicts the target with an advanced form of scurvy, a mariner's disease stemming from improper nutrition. The symptoms of scurvy include fatigue, joint pain, loose teeth, and internal hemorrhaging."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 1"
          },
          {
            "type": "text",
            "text": " for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is afflicted with advanced scurvy at stage 1."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is afflicted with advanced scurvy at stage 2."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Advanced Scurvy",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " (disease)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Level",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 4"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "for 1 day after eating fresh fruit, a creature gains a +2 circumstance bonus to their next saving throw against this affliction"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stage 1",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " enfeebled 1 and the damage dealt by persistent bleed effects is increased by 1 (1 day)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stage 2",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " enfeebled 1, "
          },
          {
            "type": "ref",
            "id": "5e3582c3-701c-5169-9c69-4221096722c2"
          },
          {
            "type": "text",
            "text": ", and the damage dealt by persistent bleed effects is increased by 1d4 (2 days)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stage 3",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 2"
          },
          {
            "type": "text",
            "text": ", fatigued, and the damage dealt by persistent bleed effects is increased by 1d6 (4 days)"
          }
        ]
      }
    ],
