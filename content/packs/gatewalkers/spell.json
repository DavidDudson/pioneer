    "slug": "spell:briny-bolt",
    "name": "Briny Bolt",
    "level": 1,
    "rarity": "common",
    "traits": ["attack", "concentrate", "manipulate", "water"],
    "sources": [
      {
        "kind": "book",
        "book": "gatewalkers",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2535",
        "page": 233
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You hurl a bolt of saltwater from your extended hand. Make a ranged spell attack against a target within range."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes 4d6 bludgeoning damage and is "
          },
          {
            "type": "ref",
            "id": "5d63458a-cde5-5d64-8fea-b920f04f36b7"
          },
          {
            "type": "text",
            "text": " for 1 round and "
          },
          {
            "type": "ref",
            "id": "943dfd55-ad09-5abf-9138-95a6149d3302"
          },
          {
            "type": "text",
            "text": " for 1 minute as saltwater sprays into its eyes. The creature can spend an Interact action to rub its eyes and end the blinded condition, but not the dazzled condition."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes 2d6 bludgeoning damage and is blinded for 1 round. The creature can spend an Interact action wiping the salt water from its eyes to end the blinded condition."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases by 2d6."
          }
        ]
      }
    ],
