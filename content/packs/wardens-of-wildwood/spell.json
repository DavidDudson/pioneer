[
  {
    "id": "7ab39181-ec99-59c5-b0b0-732e1898f1ba",
    "pack": "wardens-of-wildwood",
    "kind": "spell",
    "slug": "spell:bee-mans-summons",
    "name": "Bee-Man's Summons",
    "level": 2,
    "rarity": "rare",
    "traits": ["auditory", "concentrate", "linguistic", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "wardens-of-wildwood",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2439"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You recreate the Bee-Man's infamous ability to sense when someone utters their name. During the spell's duration, you mentally sense whenever someone (referred to as a speaker) speaks your full name while within the spell's area. You gain a vague sense of the speaker's identity, such as \"a local farmer\" or \"a halfling in distress,\" unless the speaker is someone you have met and interacted with before, in which case you recognize the speaker specifically. As a reaction within 1 minute of the speaker's utterance, you can send the speaker a telepathic prompt, asking if they intend to summon you. If they respond affirmatively, the spell's remaining duration decreases to sustained (up to 10 minutes), during which time you know the direction to where the speaker named you and how far away they are."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (4th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The emanation's radius increases to 1,000 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (7th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The emanation's radius increases to 1 mile, and instead of locating the speaker, you can instead converse with the speaker for 5 minutes. This otherwise works as sending."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (9th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As 7th, except the emanation's radius increases to 5 miles, and the duration of the conversation is 10 minutes."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.BcqJqxIKYE0aoDiS"
    },
