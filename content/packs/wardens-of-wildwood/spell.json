            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1"
          },
          {
            "type": "text",
            "text": " condition and ignores all cover except greater cover. If you hit, the projectile deals 7d10 bludgeoning damage."
          }
        ]
      },
