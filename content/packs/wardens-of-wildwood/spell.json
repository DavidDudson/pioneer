        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (7th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases to 9d10."
          }
        ]
      },
