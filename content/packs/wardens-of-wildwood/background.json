[
  {
    "id": "45f5d1d0-f653-53eb-9452-d2996262f662",
    "pack": "wardens-of-wildwood",
    "kind": "background",
    "slug": "background:fey-friend",
    "name": "Fey Friend",
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "wardens-of-wildwood"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Many grow up hearing cautionary tales of mischievous fey, and with good reason: from sprites' pranks to gremlins' sabotage to redcaps' outright lethality, fey pose a real danger to the unwary. But not for you—usually! Whether you grew up near an enchanted wilderness, have visited the First World, frequently deal with nature spirits, or even were a fey foundling raised by otherworldly beings, you're well acquainted with fey, their myriad traditions, and their even more numerous tricks. Fey and the Wildwood Lodge aren't the same thing, yet there's enough overlap that you're sure to fit in at the upcoming Greenwood Gala."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Charisma",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Deception skill and the Fey Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "d1ff4227-7dc1-57d9-a3d8-1f16ad627b61"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:deception",
        "rank": "trained"
      },
      {
        "key": "Proficiency",
        "selector": "skill:lore:fey",
        "rank": "trained"
      },
      {
        "key": "GrantItem",
        "item": "d1ff4227-7dc1-57d9-a3d8-1f16ad627b61"
      }
