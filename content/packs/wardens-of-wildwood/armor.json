    "name": "Canopy Bulwark",
    "level": 8,
    "rarity": "rare",
    "traits": ["invested", "laminar", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "wardens-of-wildwood",
        "page": 81,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3595"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This suit of "
          },
          {
            "type": "text",
            "text": "+1 assisting leaf weave",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is composed entirely of primal-infused leaves bestowed by a dying arboreal. The leaves display the vibrant greens of summer, as if full of life, regardless of the time that has passed since the arboreal gifted them. The armor is constantly drawing in imperceptible amounts of primal energy to help bear its wearer's burdens. You can draw deeply upon the untapped reserves of primal magic within it and infuse yourself with these energies to a limited extent, giving you a burst of quickness."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " command, envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You cast "
          },
          {
            "type": "ref",
            "id": "2b79f5bd-e9d5-59cd-81f8-b1362ed0b59a"
          },
          {
            "type": "text",
            "text": " targeting yourself. In addition to the effects of the spell, visible primal energy surges over the armor for the duration. This has no mechanical impact."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include leaves freely given by an arboreal."
          }
        ]
      }
    ],
