    "name": "Armorskin Robes of Air",
    "level": 9,
    "rarity": "common",
    "traits": ["comfort", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "player-core",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5241"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 resilient explorer's clothing",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is woven with thread spun by an elemental, and it sparkles with radiant color. A strong breeze wafts from the thread, blowing attacks off course. You gain resistance 5 to electricity damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Elemental Sheath",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The elemental threads cover your skin, further protecting you but limiting mobility. For 10 minutes, you gain resistance 5 to slashing and piercing damage but take a –5-foot status penalty to all Speeds. While activated, you gain a +1 status bonus to your AC against physical ranged attacks."
          }
        ]
      }
    ],
