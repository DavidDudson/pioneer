    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "player-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can use oil to fuel lanterns, but you can also set a pint of oil aflame and throw it. You must first spend an Interact action preparing the oil, then throw it with another action as a ranged attack. If you hit, it splatters on the creature or in a single 5-foot square you target. You must succeed at a "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 10
          },
          {
            "type": "text",
            "text": " for the oil to ignite successfully when it hits. If the oil ignites, the target takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "fire"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      }
    ],
