    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can see in darkness and dim light just as well as you can see in bright light, though your vision in darkness is in black and white. Some forms of magical darkness, such as a 4th-rank "
          },
          {
            "type": "ref",
            "id": "d7720a54-bc70-5d59-bdb1-d50d8eb0dac9"
          },
          {
            "type": "text",
            "text": " spell, block normal darkvision. You, however, can see through even these forms of magical darkness."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Sense",
        "sense": "d9c41f9d-318a-5062-b129-db87b8f08f5e"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.vPhPgzpRjYDMT9Kq"
    },
    "data": {}
  },
  {
    "id": "db4b07da-dded-5264-b468-ad3c684dba6d",
