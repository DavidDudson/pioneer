    "level": 0,
    "rarity": "common",
    "traits": ["halfling"],
    "sources": [
      {
        "kind": "book",
        "book": "player-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your eyes are sharp, allowing you to make out small details about "
          },
          {
            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1"
          },
          {
            "type": "text",
            "text": " or even "
          },
          {
            "type": "ref",
            "id": "53cf375b-c3fa-5d92-afde-135a3c001674"
          },
          {
            "type": "text",
            "text": " creatures that others might miss. You gain a +2 circumstance bonus when using the "
          },
          {
            "type": "ref",
            "id": "d45207be-e539-50ce-9463-f4edc3671076"
          },
          {
            "type": "text",
            "text": " action to find "
          },
          {
            "type": "ref",
            "id": "d851e3ca-be0d-55a7-a4d1-d7ed8b7ecafa"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "61f1fec4-1bb4-585d-9c12-6059d15dd74b"
          },
          {
            "type": "text",
            "text": " creatures within 30 feet of you. When you target an opponent that is concealed from you or hidden from you, reduce the DC of the flat check to 3 for a concealed target or 9 for a hidden one."
          }
        ]
      }
    ],
    "rules": [
      {
