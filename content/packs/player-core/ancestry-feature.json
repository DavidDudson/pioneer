  {
    "id": "b3e4df23-ef73-5717-b2fd-01c4764f4a75",
    "pack": "player-core",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:plant-nourishment",
    "name": "Plant Nourishment",
    "level": 0,
    "rarity": "common",
    "traits": ["leshy"],
    "sources": [
      {
        "kind": "book",
        "book": "player-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain nourishment in the same way that the plants or fungi that match your body type normally do, through some combination of photosynthesis, absorbing minerals with your roots, or scavenging decaying matter. You typically do not need to pay for food. If you normally rely on photosynthesis and go without sunlight for 1 week, you begin to starve. You can derive nourishment from specially formulated bottles of sunlight instead of natural sunlight, but these bottles cost 10 times as much as standard rations (or 40 sp)."
          }
        ]
      }
    ],
    "rules": [],
