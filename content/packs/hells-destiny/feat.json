[
  {
    "id": "bbbd3d89-1711-5469-9e7e-3fd9e9d49ba3",
    "pack": "hells-destiny",
    "kind": "feat",
    "slug": "feat:adventurous-outfitter",
    "name": "Adventurous Outfitter",
    "level": 7,
    "rarity": "uncommon",
    "traits": ["general", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "hells-destiny",
        "page": 230,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8980"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You tinker, create, and repair gear as you adventure. You can spend part of your daily preparations adjusting your group's equipment. This allows you to attempt to Repair up to five items during that time."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain access to a new exploration activity: Tinker on the Go. So long as you have two free hands and have access to the necessary tools, you can make Crafting progress while out traveling. At the GM's discretion, you might not be able to Tinker on the Go for projects that require extensive infrastructure, such as a smithing forge. Otherwise, time spent exploring can count toward a day of crafting progress, as long as 8 hours of time get used in this way."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you lead a troop, you maintain their equipment in addition to your companions' gear. Once per day when you Command the troop in a skirmish encounter, you can increase the DC of their offensive actions by 1 until the beginning of your next turn."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.A3j9m1aKDb9nErrM"
    },
    "data": {
      "category": "skill",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "master in Crafting, Quick Repair"
            }
          ]
        }
      ]
    }
  },
