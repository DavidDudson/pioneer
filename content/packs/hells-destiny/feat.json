  {
    "id": "3cf0bea4-756e-5cc9-b1b5-720cffc2eec8",
    "pack": "hells-destiny",
    "kind": "feat",
    "slug": "feat:drowning-mist",
    "name": "Drowning Mist",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["impulse", "kineticist", "primal", "stance", "water"],
    "sources": [
      {
        "kind": "book",
        "book": "hells-destiny",
        "page": 228,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8978"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Though not unique to Chelaxian kineticists, this sarglagoninspired technique floods enemies' lungs. Your elemental gate exudes a faint mist that feels as thick as standing water. The moisture doesn't just tug at limbs; it forcibly seeps into the nostrils and lungs of air-breathing creatures. While in this stance, your aura is difficult terrain for any creature that doesn't have a swim Speed. Creatures that can't breathe water must hold their breath while in the aura, and when such creatures take an action that reduces their remaining air by 1 or more rounds, they must also attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-dc"
            }
          },
          {
            "type": "text",
            "text": " save against your class DC (maximum once per round). You're immune to the effects of your own Drowning Mist."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected and becomes temporarily immune to the effects of this impulse for 24 hours."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Moisture seeps into the creature's lungs, making the creature "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
