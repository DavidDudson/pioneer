          },
          {
            "type": "ref",
            "id": "f7fea8f9-c457-5b9f-9283-f567fa557184"
          },
          {
            "type": "text",
            "text": ", frightened, "
          },
          {
            "type": "ref",
            "id": "cab530ff-ca20-5f0a-8a5e-b9fdb322b146"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "7802f1d9-5ced-5b9b-8a08-98ec0adb9947"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "b374c4c9-d230-5167-8878-38e08932a071"
          },
          {
            "type": "text",
            "text": ", slowed, or stunned condition."
          }
        ]
      }
    ],
