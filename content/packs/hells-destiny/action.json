    "slug": "action:shadows-in-the-moonlight",
    "name": "Shadows in the Moonlight",
    "rarity": "common",
    "traits": ["commander", "tactic"],
    "sources": [
      {
        "kind": "book",
        "book": "hells-destiny"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
