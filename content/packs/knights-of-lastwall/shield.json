            "statistic": "save:will",
            "dc": 27,
            "outcomes": {
              "success": [
                {
                  "type": "text",
                  "text": "The creature is unaffected."
                }
              ],
              "failure": [
                {
                  "type": "text",
                  "text": "For 1 round, the creature ignores other creatures in the area and concentrates on bringing you down. The creature will still attack anyone preventing them from attacking you, uses tactics deemed most convenient to defeat you, and works with other creatures that confront you."
                }
              ],
              "criticalFailure": [
                {
                  "type": "text",
                  "text": "As failure, but the duration is 1 minute."
                }
              ]
