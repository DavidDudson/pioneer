    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your familiar has incredible religious knowledge. Despite being a minion, your familiar gains 1 reaction at the start of its turns, which it can use only to "
          },
          {
            "type": "ref",
            "id": "75d39cda-442b-5171-bf18-4645b8813fd3"
          },
          {
            "type": "text",
            "text": " you on a Religion check (it still has to prepare to help you as normal for the Aid reaction). It automatically succeeds its check to Aid you with Religion checks or automatically critically succeeds if you're a master in Religion."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.familiar-abilities.Item.cy7bdQqVANipyljS"
    },
