        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your familiar can draw upon the power of your deity to "
          },
          {
            "type": "ref",
            "id": "5e7b32f6-95d4-5b66-9956-03c679d22fa2"
          },
          {
            "type": "text",
            "text": " once per day. The familiar can cast the 1-action version of "
          },
          {
            "type": "ref",
            "id": "949e0a89-f44b-598d-8adb-3d9d31db900e"
          },
          {
            "type": "text",
            "text": " at a level 2 levels lower than your highest-rank spell slot, which it can cast only on you. You must be able to cast 3rd-rank spells from spell slots to select this ability."
          }
        ]
      }
    ],
    "rules": [
