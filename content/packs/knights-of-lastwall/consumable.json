[
  {
    "id": "0c471809-6567-502e-8ba3-7495c06135fb",
    "pack": "knights-of-lastwall",
    "kind": "consumable",
    "slug": "consumable:anointing-oil",
    "name": "Anointing Oil",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["consumable", "magical", "oil"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Carried by many Knights of Lastwall, this amber-colored, fragrant-smelling oil is meant to prevent those who fall in battle from rising as undead. Applying "
          },
          {
            "type": "text",
            "text": "anointing oil",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to a corpse casts "
          },
          {
            "type": "ref",
            "id": "2d4c6edd-9059-52d9-b547-c7da47a9c1c5"
          },
          {
            "type": "text",
            "text": " on it. The effects last for 24 hours."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The oil is repugnant to the undead. An undead creature that touches a corpse treated with this oil is "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 1"
          },
          {
            "type": "text",
            "text": " until the contact is broken or the oil's effect wears off."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.89955RkZoEmVNo3V"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 18
        }
      },
      "bulk": "light",
      "category": "oil",
      "usage": {
        "type": "held",
        "hands": "two"
      }
    }
  },
