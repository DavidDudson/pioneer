  {
    "id": "fc5ab5c9-f13d-5801-935e-5757eb66cfb3",
    "pack": "knights-of-lastwall",
    "kind": "consumable",
    "slug": "consumable:lastwall-soup-greater",
    "name": "Lastwall Soup (Greater)",
    "level": 18,
    "rarity": "uncommon",
    "traits": ["alchemical", "consumable", "elixir"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 minute (Interact)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Crimson Reclaimers make this rich, hearty soup using herbs that baffle the senses of the undead. A bowl of Lastwall soup is as nourishing as a full meal. Gravelands Herbalists have spent time with the Knights of Lastwall, and have learned how to improve upon Lastwall soup."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "For 1 hour after consuming a bowl of improved Lastwall soup, you gain a +3 item bonus to Stealth checks and DCs against undead. In addition, you gain 10 temporary hit points that last for 10 minutes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "363ea1af-c0dc-5bae-a665-db1124353348"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Note: Paizo did not provide a price for this item, so we set it as appropriate for a level 18 consumable.",
            "marks": ["emphasis"]
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.ed8gAxli6Of58kAM"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 3500
        }
      },
      "bulk": "light",
      "category": "elixir",
      "effect": "363ea1af-c0dc-5bae-a665-db1124353348",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
