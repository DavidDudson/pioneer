  {
    "id": "de4927ba-7aad-56df-814e-be2676ecff76",
    "pack": "knights-of-lastwall",
    "kind": "consumable",
    "slug": "consumable:ghost-oil",
    "name": "Ghost Oil",
    "level": 4,
    "rarity": "common",
    "traits": ["consumable", "magical", "oil"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The vials containing this translucent, unsubstantial oil are always cold to the touch. Applying "
          },
          {
            "type": "text",
            "text": "ghost oil",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to a melee weapon you're wielding or carrying causes it to become semitransparent and gain the effects of a "
          },
          {
            "type": "ref",
            "id": "3e294082-c3ff-58be-ab80-1608b9c6229a"
          },
          {
            "type": "text",
            "text": " rune, but it also makes the weapon unable to harm corporeal creatures. The oil has no effect when applied to another creature's weapon. The effect of the oil lasts for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "ca9b9081-d789-5771-bf28-8bd358525b36"
          }
        ]
      }
    ],
