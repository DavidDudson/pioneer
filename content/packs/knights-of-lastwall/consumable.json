  {
    "id": "cb4852ad-a90e-50a0-a1cf-7e98474b904b",
    "pack": "knights-of-lastwall",
    "kind": "consumable",
    "slug": "consumable:camp-shroud-greater",
    "name": "Camp Shroud (Greater)",
    "level": 13,
    "rarity": "uncommon",
    "traits": ["consumable", "illusion", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Knights make use of this magically treated powder to help hide their camps while traveling through the Gravelands or other dangerous regions. When you toss the powder into a campfire or other sizable fire, the fire produces a thin mist that enshrouds everything in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 25
          },
          {
            "type": "text",
            "text": " from the fire. The mist creates protective illusions that remain for up to 12 hours and make it difficult to spot the area from afar. You can end the effect earlier by putting out the fire. Light and smoke produced in the area aren't visible from outside the area. The illusions don't prevent sound from traveling nor prevent the area or its inhabitants from being seen."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A creature outside the area that uses the "
          },
          {
            "type": "ref",
            "id": "d45207be-e539-50ce-9463-f4edc3671076"
          },
          {
            "type": "text",
            "text": " action or "
          },
          {
            "type": "ref",
            "id": "13c83114-7186-5ae6-99eb-2730f9d20d72"
          },
          {
            "type": "text",
            "text": " activity to examine the area or look for smoke and light coming from that direction can attempt a "
          },
          {
            "type": "check",
            "statistic": "perception",
            "dc": 30
          },
          {
            "type": "text",
            "text": " check to disbelieve the illusion."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.AGD0qLB8zKGinKwv"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 500
        }
      },
      "bulk": "negligible",
      "category": "other",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
