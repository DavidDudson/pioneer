      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Wisdom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Medicine skill and the Undead Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "9848970b-02f3-562b-9a64-29e42647bbc1"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
