  {
    "id": "483f1f20-89f9-5539-9f72-2987dd021fc7",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:enhance-senses",
    "name": "Enhance Senses",
    "level": 4,
