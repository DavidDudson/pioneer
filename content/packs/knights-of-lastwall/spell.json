      "damage": [
        {
          "key": "j2ds5suvw51ucg4c",
          "formula": "2d10",
          "damageType": "fire",
          "kinds": ["damage"]
        }
      ],
      "heightening": {
        "type": "interval",
        "interval": 2,
        "damage": [
          {
            "key": "j2ds5suvw51ucg4c",
            "formula": "1d10"
          }
        ]
      }
    }
