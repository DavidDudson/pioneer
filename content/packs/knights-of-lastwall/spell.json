  {
    "id": "9179938b-1b6f-530f-899b-24295874fff2",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:for-love-for-lightning",
    "name": "For Love, For Lightning",
    "level": 6,
    "rarity": "uncommon",
    "traits": ["concentrate", "electricity", "focus", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you Cast the Spell, you plunge the required weapon into the ground, where it crackles with crimson lightning. When you Cast the Spell, and the first time during each of your subsequent turns that you Sustain the spell, the crimson lightning arcs. When the weapon arcs, one enemy of your choice within 30 feet of the weapon takes 3d12 electricity damage (basic Reflex save). If you Interact to draw the weapon from the ground, the spell ends."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases by 1d12."
          }
        ]
      }
    ],
