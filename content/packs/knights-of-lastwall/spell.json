[
  {
    "id": "692f5e7c-ad2e-5fa7-a7bc-b07bbd606771",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:buffeting-winds",
    "name": "Buffeting Winds",
    "level": 1,
    "rarity": "common",
    "traits": ["air", "concentrate", "manipulate", "nonlethal"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You release a quick burst of wind that batters your living opponents without causing them lasting harm, while also blowing undead away. The wind deals 2d4 bludgeoning damage, which is nonlethal against living creatures. Against undead, the winds are more vicious, and the spell loses the nonlethal trait against such creatures. Each creature in the area must attempt a basic Reflex save. On a failure, undead creatures are also knocked back 5 feet (or 10 feet on a critical failure)."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases by 2d4."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
