  {
    "id": "ac5f72ca-eaec-583c-89c9-8047f143f579",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:erase-trail",
    "name": "Erase Trail",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You drastically reduce all signs of one specific creature's passage from the area, including footprints, handprints, dirt, and minor changes caused to the surrounding environment, like the bending of grass. The DC of checks to "
          },
          {
            "type": "ref",
            "id": "d45207be-e539-50ce-9463-f4edc3671076"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "13c83114-7186-5ae6-99eb-2730f9d20d72"
          },
          {
            "type": "text",
            "text": " and discover such signs within the area gains a +4 status bonus or is equal to your spell DC, whichever is higher. This spell doesn't repair objects the creature damaged, return slain creatures to life, or remove objects or garbage left behind. It also doesn't prevent others from noticing that the creature's trail ends or begins abruptly outside the area. Finally, this spell doesn't hide the creature from sight or prevent them from leaving new signs of their presence after this spell is cast."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The range increases by 100 feet, the area increases by 20 feet, and you can remove all signs of 1 additional creature's passage from the area."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.Tw9e2rPaNdxcM1Rp"
