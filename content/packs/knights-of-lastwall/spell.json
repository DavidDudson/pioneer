  {
    "id": "e3cabf1f-2011-5513-be13-1feaf83b1adc",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:wall-of-virtue",
    "name": "Wall of Virtue",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["concentrate", "holy", "light", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You create a translucent wall of light, which draws power from the celestial realms. You create either a 5-foot-thick wall in a straight line up to 60 feet long and 10 feet high or a 5-foot-thick, 10-foot-radius ring with the same height. The wall sheds bright light for 20 feet on each side and dim light for the next 20 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If the light passes through an area of magical darkness or targets a creature affected by magical darkness, wall of virtue attempts to counteract the darkness."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Any creature that crosses the wall or is occupying the wall's area at the start of its turn takes 1d8 spirit damage and 1d8 vitality damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The spirit damage increases by 1d8, and the vitality damage increases by 1d8."
          }
        ]
      }
    ],
