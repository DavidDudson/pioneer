  {
    "id": "5734477b-63a8-5c3e-9dd5-3f51245fdd0c",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:empathic-link",
    "name": "Empathic Link",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["concentrate", "emotion", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You forge a bond between yourself and the target, enabling you to feel each other's emotions. You and the target can communicate empathetically, sharing emotions, at a distance of up to 1 mile."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (4th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You can target up to 4 willing creatures, and the duration increases to 8 hours."
          }
        ]
      }
    ],
    "rules": [],
