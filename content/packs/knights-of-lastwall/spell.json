  {
    "id": "199eb7f8-9e05-5b8a-9e60-d82acc8420eb",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:consecrate-flesh",
    "name": "Consecrate Flesh",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["concentrate", "holy", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Through the strength of your faith, your body becomes infused with holy energy. You have weakness 5 to unholy. Any creature that touches or damages you with an unarmed attack or non-reach melee weapon takes 1d6 spirit damage. Your unarmed attacks deal an additional 1 spirit damage. Your healing spells that restore Hit Points restore an additional (max(1,floor(@item.rank/3)))d4[healing] Hit Points when you initially cast them; as normal, if your healing spell restores Hit Points more than once, grants fast healing, or the like, the additional Hit Points still only apply once."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "8a70e6c2-6a9e-522a-9981-aabb95f9321a"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+3)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Creatures touching you take 1d6 additional spirit damage, your unarmed Strikes deal 1 additional spirit damage, your healing spells restore 1d4 more additional Hit Points, and your weakness to unholy increases by 5."
          }
        ]
      }
    ],
