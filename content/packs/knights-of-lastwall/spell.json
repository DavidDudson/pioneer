  {
    "id": "a3a3be30-ea55-56c5-8962-edb08cfc7f1e",
    "pack": "knights-of-lastwall",
    "kind": "spell",
    "slug": "spell:synchronize-steps",
    "name": "Synchronize Steps",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You link the minds of two targets, enabling them to move in tandem. When one of the targets Steps, the other target can use a reaction to Step. When one of the targets Strides, the other target can use a reaction to Stride."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (5th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The range increases to 60 feet, and you can target up to 10 willing creatures."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.EeEgzWYcAY7ZQkS6"
    },
    "data": {
      "rank": 1,
