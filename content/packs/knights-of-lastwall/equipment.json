  {
    "id": "0c33255c-953d-552c-b997-4fead60fdf70",
    "pack": "knights-of-lastwall",
    "kind": "equipment",
    "slug": "equipment:parade-armor",
    "name": "Parade Armor",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["adjustment"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Parade armor is an armor adjustment that creates a set of pseudo-decorative armor to wear during noncombat functions. Any medium or heavy armor can be fashioned into parade armor, which features custom designs based on the wearer's affiliation, military branch, or rank. A particular faction typically has one uniform appearance for its set of parade armor. While wearing this armor, you gain a +1 item bonus to Diplomacy and Intimidation checks against creatures of the same affiliation as your parade armor, though the bonus to Intimidation doesn't apply when interacting with creatures of higher rank than you. The armor is slightly bulkier, increasing the Bulk by 1."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:diplomacy", "skill:intimidation"],
        "type": "item",
        "value": 1,
        "predicate": ["option:same-affiliation"],
        "display": {
          "label": "Against a Creature of the Same Affiliation"
        }
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.hHOi8jV85CN8WRJT"
    },
    "data": {
      "price": {
