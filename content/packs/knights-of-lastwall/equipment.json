      }
    }
  },
  {
    "id": "2de42929-0865-59ab-bd7a-dd1994adb7d5",
    "pack": "knights-of-lastwall",
    "kind": "equipment",
    "slug": "equipment:knights-tabard",
    "name": "Knight's Tabard",
    "level": 3,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This cloth vestment features the heraldry or symbol associated with an entity (such as a deity, kingdom, or organization). Knights typically wear it over armor and other clothing, helping them identify allies on the battlefield or distinguishing themselves in more peaceful situations. An individual wearing a tabard gains a +1 item bonus to "
          },
          {
            "type": "ref",
            "id": "722e5346-27c0-5157-b5a9-e6018df94150"
          },
          {
            "type": "text",
            "text": " on creatures who have a positive association with the entity represented on the tabard."
          }
        ]
      }
    ],
    "rules": [
