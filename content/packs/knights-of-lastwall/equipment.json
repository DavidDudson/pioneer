  {
    "id": "54f102e2-1adf-503c-a4ad-d15ebb54cf3c",
    "pack": "knights-of-lastwall",
    "kind": "equipment",
    "slug": "equipment:swiftmount-saddle",
    "name": "Swiftmount Saddle",
    "level": 7,
    "rarity": "uncommon",
    "traits": ["companion", "invested", "magical", "primal"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This sturdy leather saddle was designed to improve communication between mount and rider, allowing even inexperienced knights to command their mounts in battle. A "
          },
