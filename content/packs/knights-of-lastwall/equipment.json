[
  {
    "id": "7820220d-85f7-51ab-b681-3bd8f38a5150",
    "pack": "knights-of-lastwall",
    "kind": "equipment",
    "slug": "equipment:busine-of-divine-reinforcements",
    "name": "Busine of Divine Reinforcements",
    "level": 15,
    "rarity": "uncommon",
    "traits": ["divine", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "knights-of-lastwall"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This long, straight, trumpet-like instrument is made of well-polished brass and adorned with imagery of angels fighting demons or religious symbols. When played as an instrument, the busine generates powerful and harmonious notes and grants a +2 item bonus to Performance checks."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " Interact (auditory)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You play a few notes on the busine. Evil creatures within 60 feet who hear the notes must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 34
          },
          {
            "type": "text",
            "text": " save or be "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f"
          },
          {
            "type": "text",
            "text": " for 1 round, or 2 rounds on a critical failure; this is an incapacitation effect."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " command, envision, Interact"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You blow into the busine and conjure a celestial with the effects of a 6th-rank "
          },
          {
            "type": "ref",
            "id": "5fa9980f-96b8-5ba5-853f-2d7a7d3339cb"
          },
          {
            "type": "text",
            "text": " spell, but there are no alignment restrictions to define which celestials you can call. The celestial will fight only evil creatures and leaves after all present evil creatures have been defeated or the spell's duration ends, whichever comes first. You can Sustain the Activation to extend the spell's duration, as normal. If you have a deity and the conjured celestial's alignment is one of your deity's preferred alignments, the effect functions as a normal 6th-rank "
          },
          {
            "type": "text",
            "text": "summon celestial",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " spell instead, meaning the celestial will fight any creature, not just evil creatures, and will perform other tasks as you command."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "domain": "skill:performance",
        "option": "option:playing",
        "toggleable": true,
        "display": {
          "label": "Playing Busine of Divine Reinforcements"
        }
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:performance"],
        "type": "item",
        "value": 2,
        "predicate": ["option:playing"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.z5u7z3zBHZcCxfyX"
    },
    "data": {
