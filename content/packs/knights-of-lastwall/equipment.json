          "gp": 10
        }
      },
      "bulk": "negligible",
      "usage": {
        "type": "affixed",
        "to": "medium-heavy-armor"
      }
    }
  },
  {
    "id": "6bfef2e0-becd-5a10-a9e7-3da1599f9391",
    "pack": "knights-of-lastwall",
    "kind": "equipment",
    "slug": "equipment:portable-altar",
