          "frequency": {
            "max": 1,
            "per": "day"
          },
          "traits": ["auditory", "fortune", "linguistic", "mental"],
          "description": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Frequency",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " once per day"
                }
              ]
            },
            {
              "type": "rule"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Effect",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The barkeep gives some pertinent advice to a single creature other than themself. For 24 hours, when that creature fails a skill check or saving throw, they can recall this advice and reroll the check, using the second result instead. Once that creature uses this ability, its effect ends."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A creature that receives the Barkeep's Advice is temporarily immune to the ability for 1 month."
                }
              ]
            }
