      "abilities": [
        {
          "name": "Destructive Vengeance",
          "cost": "reaction",
          "trigger": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "An enemy within 15 feet damages the antipaladin"
                }
              ]
            }
          ],
          "traits": ["divine"],
          "description": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Trigger",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " An enemy within 15 feet damages the antipaladin"
                }
              ]
            },
            {
              "type": "rule"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Effect",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The antipaladin increases the amount of damage they take by 2d6 and deals 2d6 to the triggering enemy, choosing "
                },
                {
                  "type": "damage",
                  "instances": [
                    {
                      "formula": "2d6",
                      "damageType": "spirit"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " or "
                },
                {
                  "type": "damage",
                  "instances": [
                    {
                      "formula": "2d6",
                      "damageType": "void"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " damage. In addition, the antipaladin deals 2 extra damage of the chosen type with their Strikes against the triggering creature until the end of the antipaladin's next turn."
                }
              ]
            }
          ],
          "rules": [
            {
              "key": "RollOption",
              "option": "option:destructive-vengeance",
              "toggleable": true,
              "suboptions": [
                {
                  "value": "spirit",
                  "label": "Spirit"
                },
                {
                  "value": "void",
                  "label": "Void"
                }
              ]
            },
            {
              "key": "AdjustStrike",
              "property": "traits",
