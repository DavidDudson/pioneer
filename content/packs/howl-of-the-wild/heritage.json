    "kind": "heritage",
    "slug": "heritage:hardshell-surki",
    "name": "Hardshell Surki",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your carapace is much denser than that of other surkis, offering you a suit of your very own armor. Your carapace is medium armor in the plate armor group that grants a +4 item bonus to AC, a Dex cap of +1, a check penalty of –2, a Speed penalty of –5 feet, a Strength value of +3, and has the comfort trait. You can never wear other armor or remove your carapace. You can etch armor runes onto your carapace."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Evolution",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The magical circulatory system that runs between your nodes has become a reinforcing network that strengthens your carapace with magical energy. If you're struck by a critical hit that deals physical damage, you can use your reaction to attempt a "
                },
                {
                  "type": "check",
                  "statistic": "flat",
                  "dc": 17
                },
                {
                  "type": "text",
                  "text": ". If successful, the attack becomes a normal hit."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Evolution",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " Your abdominal nodes can project a field around you that guards you against the type of magic you're most familiar with. You gain the "
                },
                {
                  "type": "ref",
                  "id": "c38e56e8-d99b-56de-a98e-ee03b7d26ac2"
                },
                {
                  "type": "text",
                  "text": " action."
                }
              ]
            }
          ]
        ]
      }
    ],
    "rules": [
      {
        "key": "GrantItem",
        "item": "c38e56e8-d99b-56de-a98e-ee03b7d26ac2",
        "allowDuplicate": false,
