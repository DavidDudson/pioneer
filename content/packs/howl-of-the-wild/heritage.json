[
  {
    "id": "7a1cb65e-9337-50b5-86f8-e3018368a6c4",
    "pack": "howl-of-the-wild",
    "kind": "heritage",
    "slug": "heritage:abyssal-merfolk",
    "name": "Abyssal Merfolk",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You live far, far below the surface of the ocean. Your fish tail might resemble a viperfish or anglerfish, and you might have luminous eyes or translucent skin. Abyssal merfolk have an uncanny reputation, but they can exist in even the most lightless realms. You gain darkvision and are immune to the crushing pressure of the oceanic depths."
          }
        ]
      }
    ],
    "rules": [
