    "kind": "heritage",
    "slug": "heritage:climbing-animal",
    "name": "Climbing Animal",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You are an animal whose limbs are adapted to grab, climb, and brachiate. You might be dexterous and ready to use tools like a chimpanzee or otter, or you may simply be a quick climber like a bear, raccoon, or sloth."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have a land Speed of 20 feet, a climb Speed of 20 feet, and one animal attack of your choice (typically claw, fist, or jaws)."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Change",
