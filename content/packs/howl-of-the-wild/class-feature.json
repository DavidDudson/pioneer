    "slug": "class-feature:devourer-of-decay",
    "name": "Devourer of Decay",
    "level": 1,
    "rarity": "common",
    "traits": ["witch"],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your patron appeared at the end or near the end of a life, flickering in feverish visions or glinting mysteriously in the eyes of waiting scavengers. Although horrifying to many, decay creates the resources needed for new life. This fate awaits you and possibly even your patron, whether they're a towering arboreal, a subterranean fungus creature, or one of the psychopomps that shepherds the entire process along."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Spell List",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " primal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Patron Skill",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Nature"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lesson of the Hungry Scavenger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your patron teaches ways to convert death into new life. You gain the "
          },
          {
            "type": "ref",
            "id": "62eccc11-67bb-54b4-9d94-8a77ef1f693c"
          },
          {
            "type": "text",
            "text": " hex cantrip, and your familiar learns Enfeeble."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Familiar of Parasitic Might",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your familiar appears gaunt and malnourished or otherwise on the brink of death, even though it's quite healthy. When you Cast or Sustain a hex, your familiar can draw on the waning strength of another to sustain itself. One creature within 15 feet of your familiar with less than half of its maximum Hit Points becomes Sickened 1 unless it succeeds at a Fortitude saving throw against your spell DC."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:nature",
        "rank": "trained"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.classfeatures.Item.T9wA833bzZVlB3Lo"
    },
    "data": {
      "tags": ["witch-elementalist-patron", "witch-patron"]
    }
