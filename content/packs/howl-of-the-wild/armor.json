  {
    "id": "9350afbb-98b0-522e-a777-2b0802891377",
    "pack": "howl-of-the-wild",
    "kind": "armor",
    "slug": "armor:hodag-leather",
    "name": "Hodag Leather",
    "level": 8,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild",
        "page": 100,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3196"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dyed green and white and studded with the natural spines of a hodag, this "
          },
          {
            "type": "text",
            "text": "+1 Deathless studded leather armor",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is an imposing sight, especially when its wearer is barreling towards you."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Hodag Toss",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You Stride up to your Speed and make a Strike at the end of your movement. If you succeed at your Strike, attempt an "
          },
          {
            "type": "check",
            "statistic": "skill:athletics"
          },
          {
            "type": "text",
            "text": " check against the creature's Fortitude DC. On a success, the creature is thrown 10 feet in a straight line in the direction of your choice and lands Prone. If the creature is knocked into a solid object, it takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "bludgeoning"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage before landing prone. You can instead toss the creature straight up into the air. The creature lands in the same square it occupied, and takes 1d6 bludgeoning damage as it lands prone. You can't use this ability again for 1d4 rounds."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include the hide of a hodag."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.EnTfjcVhcdgd1sLW"
    },
