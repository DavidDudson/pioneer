      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your carapace is medium armor in the plate armor group that grants a +4 item bonus to AC, a Dex cap of +1, a check penalty of –2, a Speed penalty of –5 feet, a Strength value of +3, and has the comfort trait. You can never wear other armor or remove your carapace. You can etch armor runes onto your carapace."
          }
        ]
      }
