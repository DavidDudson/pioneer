  {
    "id": "54a4a144-cf14-548e-8547-a6e026d09fd1",
    "pack": "howl-of-the-wild",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:aquatic-grace",
    "name": "Aquatic Grace",
    "level": 0,
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you roll a success on a saving throw against a water effect, you get a critical success instead."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "AdjustDegreeOfSuccess",
        "selectors": ["saving-throw"],
        "adjustment": {
          "success": "one-degree-better"
        },
        "predicate": ["option:water"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.d5TYEND07kwWRBIq"
    },
    "data": {}
  },
  {
    "id": "99e07dd6-2d0d-544a-a894-bf1a19d08508",
    "pack": "howl-of-the-wild",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:awakened-form",
    "name": "Awakened Form",
    "level": 1,
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Awakening altered your form, enabling you to speak verbally and stand on two legs. You can wear, hold, wield, and use items. Which limbs you use to manipulate items and how many are determined by you and your GM, but for the rules you function like a humanoid with two hands."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.ItQDbIiqpb50Zbtm"
    },
    "data": {}
  },
  {
    "id": "61295a1c-505d-566b-964a-62bac64443c1",
    "pack": "howl-of-the-wild",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:awakened-mind",
    "name": "Awakened Mind",
    "level": 1,
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "howl-of-the-wild"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Awakening altered your mind. You are no longer an animal, but you can still ask questions of, receive answers from, and use the Diplomacy skill with animals of your kind. By remembering your instincts, you can allow yourself to be affected by spells and other effects as though you were an animal."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.ancestryfeatures.Item.0qHN69NF7JBWKO8v"
    },
    "data": {}
  },
  {
    "id": "58b293fa-e68b-59bf-8caf-85bddf3f9f86",
    "pack": "howl-of-the-wild",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:horns-minotaur",
