    "slug": "action:hunt-runelord",
    "name": "Hunt Runelord",
    "rarity": "common",
    "traits": ["concentrate"],
    "sources": [
      {
        "kind": "book",
        "book": "revenge-of-the-runelords"
      }
    ],
    "description": [
      {
        "type": "paragraph",
