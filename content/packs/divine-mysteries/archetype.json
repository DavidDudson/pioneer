    "slug": "archetype:mortal-herald",
    "name": "Mortal Herald",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "divine-mysteries",
        "aon": "https://2e.aonprd.com/Archetypes.aspx?ID=305",
