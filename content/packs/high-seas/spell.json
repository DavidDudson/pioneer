  {
    "id": "ace48a6b-8e1e-5d3a-84c1-3b007d2d1310",
    "pack": "high-seas",
    "kind": "spell",
    "slug": "spell:undertow",
    "name": "Undertow",
    "level": 3,
    "rarity": "common",
    "traits": ["concentrate", "incapacitation", "water"],
    "sources": [
      {
        "kind": "book",
        "book": "high-seas"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You create an area of water 20 feet deep. The DC for Athletics checks to Swim in the area is equal to your spell DC. A creature that starts its turn in the area must attempt a Fortitude save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "damageType": "bludgeoning"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d6",
                "damageType": "bludgeoning"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and takes a –2 circumstance penalty to Athletics checks to Swim and a –10-foot circumstance penalty to its swim Speed, if it has one, until it leaves the area."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "66d7bc6f-e6f9-5275-a802-8d1886dbfdd2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, and the creature is pulled 10 feet down."
          }
        ]
      }
    ],
