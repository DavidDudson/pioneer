  {
    "id": "307503ef-c74a-5642-b774-b1ad43a4c16d",
    "pack": "high-seas",
    "kind": "spell",
    "slug": "spell:shipwreck",
    "name": "Shipwreck",
    "level": 8,
    "rarity": "common",
    "traits": ["concentrate", "incapacitation", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "high-seas"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gesture toward a vehicle and the vessel wrenches itself apart. It must attempt a Fortitude save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The vehicle is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The vehicle becomes uncontrolled, and spaces within it become difficult terrain."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, plus the vehicle gains the "
          },
          {
            "type": "ref",
            "id": "c945a9c5-1053-552c-8cc3-ac4832741d0f"
          },
          {
            "type": "text",
            "text": " condition. If it already had the broken condition, it's destroyed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The vehicle is reduced to 0 HP and is destroyed."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
