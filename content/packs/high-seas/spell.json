  {
    "id": "18a767bf-0028-54c4-91c2-4c2a61a78c38",
    "pack": "high-seas",
    "kind": "spell",
    "slug": "spell:whispers-of-a-dead-goddess",
    "name": "Whispers of a Dead Goddess",
    "level": 5,
    "rarity": "common",
    "traits": ["auditory", "concentrate", "incapacitation", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "high-seas"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The mysterious whispers that fill the Mordant Spire, which some believe to be the voice of the dead goddess Acavna, become audible. A creature in the area when this Spell is Cast or who enters the area must attempt a Will save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected and becomes temporarily immune for 1 hour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target becomes "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 1"
          },
          {
            "type": "text",
            "text": ", listening to the whispers."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, and the creature will not voluntarily leave the area for 1 round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, and you can whisper a single course of action to each creature that critically failed, with the effects of suggestion. The effect ends on a creature if you stop sustaining the spell or the creature leaves the area."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
