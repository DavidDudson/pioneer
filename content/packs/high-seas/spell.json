[
  {
    "id": "abf2b0bc-1460-5831-bc43-2de6a26d8ab3",
    "pack": "high-seas",
    "kind": "spell",
    "slug": "spell:anchoring-air",
    "name": "Anchoring Air",
    "level": 4,
    "rarity": "common",
    "traits": ["air", "concentrate"],
    "sources": [
      {
        "kind": "book",
        "book": "high-seas"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature attempts a melee Strike against you"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You solidify the air around an incoming attack, catching it in a vise-like grip. The triggering creature must attempt a Reflex save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes a –2 circumstance penalty to the triggering Strike's attack roll."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes a –2 circumstance penalty to all attack rolls until the end of its turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the creature is also "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": " until the start of its next turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "6c465e40-1d9e-54a3-b365-d7ec31717f7c"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.bCZP8N2C41gF10G2"
    },
    "data": {
      "rank": 4,
      "time": {
        "type": "actions",
        "cost": "reaction"
      },
      "defense": {
        "save": {
          "statistic": "save:reflex",
          "basic": false
        }
      },
      "traditions": ["occult", "primal"],
      "damage": []
    }
  },
  {
    "id": "a7bacfa2-2999-541a-b774-2e5bc7444f74",
    "pack": "high-seas",
    "kind": "spell",
    "slug": "spell:connective-current",
    "name": "Connective Current",
    "level": 1,
    "rarity": "common",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "high-seas"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You create a magical connection between you and an enemy, as if you were both caught in the same current. When the target takes a move action, you can Stride up to half your Speed in the same direction as the target as a reaction."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (4th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You can Stride up to your Speed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (6th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As 4th, and you gain an additional reaction when you Cast this Spell and at the start of each of your turns that you can use only to make this movement."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.t6vJnkyAYLXrOjQI"
    },
    "data": {
      "rank": 1,
      "time": {
        "type": "actions",
        "cost": "two"
      },
      "range": {
        "type": "feet",
        "feet": 30
      },
      "targets": {
        "any": [
          {
            "count": 1,
