    "kind": "consumable",
    "slug": "consumable:poets-fritter-greater",
    "name": "Poet's Fritter (Greater)",
    "level": 15,
    "rarity": "common",
    "traits": ["alchemical", "consumable", "processed"],
    "sources": [
      {
        "kind": "book",
        "book": "bastion-of-blasphemies",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=5203",
        "page": 241
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The flavor of the cinnamon apple pastry called a poet's fritter is more than delicious—it inspires the tongue to great acts of spoken eloquence. When eaten, a poet's fritter not only bolsters your knack at telling stories and entertaining with your voice, it also fills your thoughts with the ability to swiftly and adroitly defend your mind from unpleasant mental agonies. For 1 hour, you gain a +3 item bonus to Deception checks to Lie and to Performance checks made for vocal-based performances, and resistance 15 against mental damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "673b5f96-0baf-5b1e-b60f-779ee5dd8abc"
