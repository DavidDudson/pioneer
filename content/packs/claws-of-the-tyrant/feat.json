  {
    "id": "e79a4c80-dac1-596c-9f52-924fe1f21636",
    "pack": "claws-of-the-tyrant",
    "kind": "feat",
    "slug": "feat:i-knew-the-heroes",
    "name": "I Knew the Heroes",
    "level": 18,
    "rarity": "common",
    "traits": ["archetype", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "claws-of-the-tyrant",
        "page": 113,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7760"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your stories aren't mere tales passed down from elder to youth or teacher to student. They're the lived experiences of those you've met, and they're the stuff of legend. When you use "
          },
          {
            "type": "ref",
            "id": "89da1f15-6113-565d-8892-74d2f8e339fc"
          },
          {
            "type": "text",
            "text": ", if you're legendary in the skill you use to Recall Knowledge, you gain a +1 circumstance bonus to the Recall Knowledge check, and the circumstance bonus to "
          },
          {
            "type": "ref",
            "id": "df66f15d-d0e9-5899-a39b-ac77ed973e9d"
          },
          {
            "type": "text",
            "text": " increases to +2."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.mbmjj0LKVuI4Zl81"
    },
    "data": {
      "category": "class",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Uzunjati Recollection; legendary in a Recall Knowledge Skill"
            }
          ]
        }
      ],
      "prerequisiteClauses": [
        {
          "text": "Uzunjati Recollection",
          "predicate": ["feat:uzunjati-recollection"]
        },
        {
