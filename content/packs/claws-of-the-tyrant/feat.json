  {
    "id": "75638434-5912-5cb5-85df-c3c1dbe62c8d",
    "pack": "claws-of-the-tyrant",
    "kind": "feat",
    "slug": "feat:preternatural-polish",
    "name": "Preternatural Polish",
    "level": 16,
    "rarity": "common",
    "traits": ["archetype", "exploration", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "claws-of-the-tyrant",
        "page": 112,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7751"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Armor you polish shines with righteous grace. You can take 10 minutes to recite prayers or oaths while polishing a suit of heavy armor that you or a willing creature is wearing. If you do, attempt a "
          },
          {
            "type": "check",
            "statistic": "skill:crafting",
            "dc": 35
          },
          {
            "type": "text",
            "text": " check with the following results. The armor then becomes temporarily immune to this ability until your next daily preparations."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Once in the next hour, the creature wearing the polished armor can use a reaction to shine majestically. This reaction is triggered when they would be affected by a spell or ability with the darkness trait. The creature attempts a counteract check against the triggering effect using your Crafting modifier. Additionally, the creature wearing the polished armor gains an additional reaction at the start of each of their turns that can be only used for this reaction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As critical success, but the creature wearing the polished armor doesn't gain an additional reaction at the start of each of their turns."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.xuZFUOkkjHg9mrcI"
    },
    "data": {
      "category": "skill",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Knight Vigilant Dedication; legendary in Crafting"
            }
          ]
        }
      ],
      "prerequisiteClauses": [
        {
          "text": "Knight Vigilant Dedication",
          "predicate": ["feat:knight-vigilant-dedication"]
        },
        {
          "text": "legendary in Crafting",
          "predicate": [
            {
              "gte": ["skill:crafting:rank", 4]
            }
          ]
        }
      ]
    }
  },
