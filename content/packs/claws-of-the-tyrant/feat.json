    "kind": "feat",
    "slug": "feat:cautious-word",
    "name": "Cautious Word",
    "level": 12,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "claws-of-the-tyrant",
        "page": 113,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7757"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " An enemy hits you with a Strike."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're currently unable to cast "
          },
          {
            "type": "ref",
            "id": "6dee4f5d-f584-5402-af2a-d3738ec685b3"
          },
          {
            "type": "text",
            "text": " because you used "
          },
          {
            "type": "ref",
            "id": "4333cbb5-7f4c-5c8e-bbad-afa6b6f2043b"
          },
          {
            "type": "text",
            "text": " with it."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You let your words defend you, just as your allies in the Vellumis Scholars defend through knowledge. You immediately cast "
          },
          {
            "type": "text",
            "text": "shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " and gain its bonus to AC even though you normally couldn't cast it, and you become "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": " for 1 round."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.2i6sEZ4rQm1Pd5nD"
    },
