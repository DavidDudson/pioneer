    "slug": "feat:adept-storyteller",
    "name": "Adept Storyteller",
    "level": 12,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "claws-of-the-tyrant",
        "page": 113,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7756"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your ability to tell stories rivals those of the finest bards. You can use your proficiency rank in any skill that can be used to Recall Knowledge to meet the requirements of skill feats that require a particular rank in Performance. You gain two Performance skill feats of 7th level or lower that you meet the prerequisites for."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
