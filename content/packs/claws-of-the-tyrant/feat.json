    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "claws-of-the-tyrant",
        "page": 112,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7752"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You and at least one ally are in the area of an effect that requires a Reflex save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When your allies are in danger, you don't hesitate to take the brunt of the blow for them. You grant all allies in the area standard cover against the triggering effect, and you gain weakness to all damage against the triggering effect equal to twice the number of allies that gain cover in this way."
          }
        ]
      }
    ],
    "rules": [],
