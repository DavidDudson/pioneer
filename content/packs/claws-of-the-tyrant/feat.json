            {
              "type": "text",
              "text": "Uzunjati Storytelling; ability to cast shield"
            }
          ]
        }
      ],
      "prerequisiteClauses": [
        {
          "text": "Uzunjati Storytelling",
          "predicate": ["feat:uzunjati-storytelling"]
        },
        {
          "text": "ability to cast shield"
        }
      ],
