    "pack": "tian-xia-character-guide",
    "kind": "ancestry-feature",
    "slug": "ancestry-feature:wanderers-soul",
    "name": "Wanderer's Soul",
    "level": 1,
    "rarity": "common",
    "traits": ["samsaran"],
    "sources": [
      {
        "kind": "book",
        "book": "tian-xia-character-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your soul is especially able to return to the cycle of reincarnation. When you're the subject of "
          },
          {
            "type": "ref",
            "id": "0fc0fff7-19d9-5610-a6c7-b586b4e07cad"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "2538cc40-43fa-5583-994b-db2735d6d75c"
          },
          {
            "type": "text",
            "text": ", or a similar ritual that would return you to life, the primary caster uses the outcome one degree of success better than their roll. You always return to life as a samsaran, even if the ritual would reincarnate you into a body of a different ancestry."
          }
        ]
      }
    ],
