    "kind": "spell",
    "slug": "spell:home-among-mulberry-leaves",
    "name": "Home Among Mulberry Leaves",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["focus", "magus", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "tian-xia-character-guide",
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2134"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're wielding qi-infused fabric."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Qi-formed threads unravel from your fabric on conjured needles as your attack makes contact with an enemy and wraps it in place like an insect in its cocoon. Make a melee Strike with your qi-infused fabric. On a success, the target is "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": " until the start of your next turn, though it can attempt to "
          },
          {
            "type": "ref",
            "id": "2ae74030-e87a-55ee-955c-fb9870392d44"
          },
          {
            "type": "text",
            "text": " against your spell DC. On a critical success, your needles anchor in the target's nerve centers after the threads bind it, making it your choice of "
          },
          {
            "type": "ref",
            "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8",
            "label": "Clumsy 1"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 1"
          },
          {
            "type": "text",
            "text": " until the start of your next turn, in addition to immobilizing it."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.JIphJbkWHndtFk72"
    },
