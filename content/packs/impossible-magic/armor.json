    "pack": "impossible-magic",
    "kind": "armor",
    "slug": "armor:invisible-chain-shirt",
    "name": "Invisible Chain Shirt",
    "level": 13,
    "rarity": "common",
    "traits": ["comfort", "flexible", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+2 resilient invisibility chain shirt",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is itself invisible. Other creatures can't see it at all, allowing you to wear it surreptitiously. Additionally, the armor's invisible composition is quieter and more comfortable than a normal chain shirt. It loses the noisy trait and gains the comfort trait."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Obscured Approach",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You Stride and turn partially invisible, becoming "
          },
          {
            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1"
          },
          {
            "type": "text",
            "text": " until the end of your next turn or until you use a hostile action, whichever comes first. As normal, you can use the concealment from this activation to Hide."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.BK1AKKi1gDMn5uBs"
    },
