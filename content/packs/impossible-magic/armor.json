  {
    "id": "35a3abb2-a4a3-587f-8d93-48d965175bff",
    "pack": "impossible-magic",
    "kind": "armor",
    "slug": "armor:energy-shield-tunic",
    "name": "Energy Shield Tunic",
    "level": 15,
    "rarity": "common",
    "traits": ["comfort", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This sleek, color-changing tunic has a higher thread count than most garments. It's a "
          },
          {
            "type": "text",
            "text": "+2 greater resilient explorer's clothing",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " that helps the wearer survive powerful energy magic. During your daily preparations, you choose one of the following energy types: acid, cold, electricity, fire, or sonic. You gain resistance 10 to the chosen energy type until your next daily preparations. The tunic changes color and gains thematic embroidery to reflect the energy type you've chosen."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Acid",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The tunic turns brown and has acid splashes embroidered in bright green thread."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Cold",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The tunic turns sky blue and has snowflakes embroidered in silver thread."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Electricity",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The tunic turns dark gray and has lightning bolts embroidered in light blue thread."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fire",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The tunic turns orange and has balls of fire embroidered in red and yellow threads."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Sonic",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The tunic turns white and has musical notes embroidered in golden thread."
                }
              ]
            }
          ]
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "d83dc0eb-eada-5260-93d1-ff67278d8d5c"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Shielding Command",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " (fortune, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You attempt a saving throw against a spell that deals acid, cold, electricity, fire, or sonic damage, but you haven't rolled yet"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Roll the triggering saving throw twice and take the better result."
          }
        ]
      }
    ],
