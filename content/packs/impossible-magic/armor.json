            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your armor has absorbed at least "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "30"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The absorbed energy explodes from your armor in a pulse of force. Creatures in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 30
          },
          {
            "type": "text",
            "text": " take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "12d6",
                "damageType": "force"
              }
