[
  {
    "id": "eeaef39b-c31d-5f8c-9b4b-c67b60b382cf",
    "pack": "impossible-magic",
    "kind": "armor",
    "slug": "armor:accoutrements-of-bone",
    "name": "Accoutrements of Bone",
    "level": 9,
    "rarity": "common",
    "traits": ["comfort", "invested", "magical", "void"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This set of +1 resilient explorer's clothing is lined with magically reinforced carved bones that are connected with reinforced sinews to provide the wearer both comfort and mobility. Spikes and spines of various shapes and sizes jut menacingly from the shoulder and forearm coverings. When you wear this outfit, you gain a +2 item bonus to Occultism checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Piercing Vengeance",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " An enemy damages you with a melee Strike"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Jagged spines from your clothing launch themselves at the triggering enemy, dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d6",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 26,
            "basic": true
          },
          {
            "type": "text",
            "text": " save."
          }
        ]
      }
