  {
    "id": "717ec9b7-dca6-559a-90e5-790ed223af8a",
    "pack": "impossible-magic",
    "kind": "armor",
    "slug": "armor:crystal-lattice",
    "name": "Crystal Lattice",
    "level": 12,
    "rarity": "common",
    "traits": ["comfort", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+2 resilient raiment explorer's clothing",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is a longline vest made of a flexible, durable lattice of many fine crystals. A wide variety of these vests exist, and their colors depend on the type of crystal that forms the lattice. The crystals glow briefly when an enemy hits the wearer."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Crystal Exoskeleton",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The crystals on your vest grow and extend, becoming an architecturally sculpted exoskeleton that covers your form. You gain 20 temporary Hit Points that last for 1 hour. The exoskeleton crumbles into dust when the temporary Hit Points are depleted or when the duration ends, and the crystals return to their original state."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "829977ec-f8f0-5615-8f99-7a8956c068c3"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.bpZjOL370dgKAO6Q"
    },
