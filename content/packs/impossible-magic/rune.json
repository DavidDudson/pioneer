  {
    "id": "8a83a07a-a165-50a5-a061-a1669493db9b",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:impactful",
    "name": "Impactful",
    "level": 10,
    "rarity": "common",
    "traits": ["force", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 204,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4990"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This rune thrums with pure magical energy. Weapons with the rune deal an additional 1d6 force damage on a successful Strike. On a critical hit, you can choose to force the target to succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 27
          },
          {
            "type": "text",
            "text": " save or be pushed 5 feet away from you."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "DamageDice",
        "selectors": ["etched-damage"],
        "diceNumber": 1,
        "dieSize": "d6",
        "damageType": "force"
      },
      {
        "key": "Note",
        "selectors": ["etched-damage"],
        "title": "Impactful",
        "outcome": ["criticalSuccess"],
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "You can choose to force the target to succeed at a save or be pushed 5 feet away from you."
              }
            ]
          }
        ]
      }
    ],
