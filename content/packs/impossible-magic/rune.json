  {
    "id": "abf538c2-d659-5e11-96ee-20e52e0d8818",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:moonweave",
    "name": "Moonweave",
    "level": 5,
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 204,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4992"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your armor bathes your wounds in the cool light of the moon. While wearing this armor, whenever you would be healed by a spell or magical effect, you recover an additional "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points. You regain additional Hit Points from moonweave only the first time you regain HP from a given healing spell or effect, so a spell or effect that heals you repeatedly over a duration would restore additional Hit Points only once, when you're first healed."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.PV2TxKcs09x9BfCc"
    },
