  {
    "id": "56d3d00b-ca75-570a-be19-ae3d6bd6933a",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:self-sealing",
    "name": "Self-Sealing",
    "level": 7,
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 205,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4994"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A suit of armor etched with this rune can create a bolstering magical layer that closes off to protect the wearer against dangerous environments. When you would take environmental damage, or when you enter an environment where you can't safely breathe, your self-sealing armor seals itself shut. It holds 1 minute's worth of air and grants you resistance 10 to environmental damage while sealed. You or another creature can take an Interact action to unseal it at any time. Once unsealed, the armor can't seal itself again for 1 hour."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.48tdInl0iSnUA5JA"
