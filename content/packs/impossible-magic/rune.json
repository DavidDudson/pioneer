  {
    "id": "02895cb2-3e89-57d5-8cf1-65e062435d6f",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:energy-vulnerability",
    "name": "Energy Vulnerability",
    "level": 4,
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 204,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4989"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A weapon etched with this rune has a sheen of a color corresponding to the energy type chosen when the rune is created: green (acid), blue (cold), white (electricity), orange (fire), or yellow (sonic). When you critically hit a target with a weapon with this rune, the target gains weakness 5 to the chosen energy type until the end of your next turn. This weakness isn't cumulative with any weakness to that energy type the target already has and doesn't affect a creature with immunity or resistance to that energy type."
          }
        ]
      }
    ],
