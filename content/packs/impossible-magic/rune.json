[
  {
    "id": "b87722cc-7fc3-535c-963c-8c06864b69c6",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:bane",
    "name": "Bane",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 204,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4986"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A bane rune grants you improved understanding of creatures of a particular type, allowing you to deal more damage to those creatures. The crafter chooses aberration, animal, beast, celestial, construct, dragon, elemental, fey, fiend, giant, monitor, ooze, or both fungus and plant. The weapon deals 1d6 additional damage of the weapon's damage type to creatures with the chosen trait or traits. The benefit doesn't apply against creatures of the chosen type disguised as other creatures. It's up to GM discretion whether the bane rune applies against a creature disguised as a creature of the chosen type."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The GM might allow bane runes for other creature traits, such as astral, demon, dream, or vampire. However, the humanoid trait, the undead trait, and the traits for specific types of humanoids (such as elf) are never a valid option."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.hnbbqvzYDyhDiJnf"
    },
