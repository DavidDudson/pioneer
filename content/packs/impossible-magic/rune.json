  {
    "id": "93c77662-c381-52ab-9384-458a4e034ec5",
    "pack": "impossible-magic",
    "kind": "rune",
    "slug": "rune:sidestepping",
    "name": "Sidestepping",
    "level": 13,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 205,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4995"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A suit of armor etched with this rune can cause its wearer's form to vibrate slightly out of phase with the rest of the world, allowing them to impossibly pass through solid objects."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Phase Through",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Until the end of your current turn, you can move through non-magical solid surfaces. Treat any movement through an item thicker than air as difficult terrain. When the duration ends, if you're sharing space with a solid item, you'll be shoved into the closest unoccupied space and take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d6",
                "damageType": "bludgeoning"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.E4iDTr5likUCR6gz"
