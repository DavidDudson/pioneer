    "kind": "rune",
    "slug": "rune:deflecting",
    "name": "Deflecting",
    "level": 6,
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-magic",
        "page": 204,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4988"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When using a weapon etched with this rune to parry, you have the potential to reduce the damage you take."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Deflecting Parry",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're critically hit with a Strike that deals physical damage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're benefiting from the bonus to AC from the weapon's parry trait"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain resistance 5 to physical damage against the triggering Strike."
          }
        ]
      }
