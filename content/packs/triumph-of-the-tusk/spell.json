    "slug": "spell:ancestral-winds",
    "name": "Ancestral Winds",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["concentrate", "emotion", "fear", "manipulate", "mental", "void"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You call on the same energies that manifest ancestor storms, summoning wailing spirits to terrorize your foes. Living creatures in the area take 5d6 void damage and 1d6 mental damage and must attempt a Will save. Nonliving creatures are immune to this spell's effects."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes half damage and is "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes full damage and is "
          },
          {
            "type": "ref",
            "id": "4218b8f3-1756-50cd-a914-6ce750659a62",
            "label": "Frightened 2"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the creature takes double damage and is "
          },
          {
            "type": "ref",
            "id": "f622dca5-47d5-57a2-9b84-1e8ec5506d3f",
            "label": "Stunned 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The first time each round you Sustain the spell, you can move the area up to 30 feet within the range of the spell. Living creatures in the new area must attempt saves with the same effects as above."
          }
        ]
      }
    ],
