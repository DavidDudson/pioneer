  {
    "id": "3f16d23c-c34c-5053-9f56-9340589a31b2",
    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:aurochs-headed",
    "name": "Aurochs-Headed",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["skill"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7648"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your words and body language can subconsciously unsettle orcs, giving you an advantage when convincing them to see things your way. Many with this feat use it to travel freely between holds, warning all but the toughest orcs to waylay weaker prey. You gain a +1 circumstance bonus to skill checks to "
          },
          {
            "type": "ref",
            "id": "722e5346-27c0-5157-b5a9-e6018df94150"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "ed0f3425-17f0-51f3-bb5d-1ca7475499a5"
          },
          {
            "type": "text",
            "text": " creatures with the orc trait. Enemy orcs who can see you at the start of combat take a –1 penalty to initiative rolls."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:diplomacy", "skill:intimidation"],
        "type": "circumstance",
        "value": 1,
        "predicate": [
          "target:trait:orc",
          {
            "or": ["action:make-an-impression", "action:coerce"]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.nTHhkHfAItjrO9d9"
    },
    "data": {
      "category": "skill",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "trained in Diplomacy or Intimidation"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "d8ebfb92-3fa9-5075-8a5b-3dfcccb7fe36",
    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:infused-with-belkzens-might",
    "name": "Infused with Belkzen's Might",
    "level": 6,
    "rarity": "uncommon",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7652"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your tattoos immortalize the conquests of orc war leaders, such as Belkzen besieging the dwarven Sky Citadel of Koldukar. You can expend one use of your storied skin's Living History ability to channel this power into your own weapons. Until the end of your next turn, you deal additional spirit damage with weapons and unarmed attacks equal to 1 plus half the number of Tattooed Historian feats you have."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
