  {
    "id": "f7cc581c-c582-5308-a84a-72435460c205",
    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:spell-survivor",
    "name": "Spell Survivor",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["orc"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7649"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Once you've resisted an opponent's magic, anything else they throw your way becomes less effective. When you attempt a saving throw against a spell using "
          },
          {
            "type": "ref",
            "id": "a50a59d6-604f-52af-85fb-24ad27a68dda"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "2cf3f871-cef3-5095-aa49-0b1fab9e932f"
          },
          {
            "type": "text",
            "text": " and critically succeed, you gain resistance 1 to all damage dealt by that triggering spell's caster until the end of their next turn. At 9th level and every 4 levels thereafter, the resistance increases by 1."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.QkDZ96UR3PzW8FDB"
    },
    "data": {
      "category": "ancestry"
    }
  },
  {
    "id": "da44242c-4db6-586a-8ba0-149599c66351",
    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:tattooed-historian-dedication",
    "name": "Tattooed Historian Dedication",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["archetype", "dedication"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7647"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You become trained in Diplomacy or Performance; if you are already trained in both skills, you instead become trained in a skill of your choice. You gain access to all uncommon magical tattoos with the orc trait."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain a "
          },
          {
            "type": "ref",
            "id": "530bd5e3-9926-52f5-bdc5-090b51e6fede"
          },
          {
            "type": "text",
            "text": " for free upon gaining this feat (or another magical tattoo of 2nd level or lower if you already have storied skin). You cannot have more than one storied skin tattoo, but the frequency of its Living History ability increases by one use per minute for every three tattooed historian feats you have. For every two tattooed historian feats you have, you can invest one magical tattoo that does not count against the maximum number of items you can have invested at one time."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.oKjyD46NmkKx1OvO"
    },
    "data": {
      "category": "class",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Constitution +1; trained in Belkzen Lore, Orc Lore, Orc Pantheon Lore, or (at the GM's discretion) a related Lore skill"
            }
          ]
        }
      ],
      "archetype": "cc741243-3002-541a-85d7-954f5aa242f2"
    }
  },
  {
    "id": "dde0aca7-2c7c-5dd0-ab84-f244e15f024c",
    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:wrath-of-the-hold",
    "name": "Wrath of the Hold",
    "level": 8,
    "rarity": "uncommon",
    "traits": ["archetype", "occult"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7654"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your tattoos carry the strength of an innumerable horde, and you can expend one use of your storied skin's Living History ability to animate your tattoos as ghostly assailants that swarm your foes. These spirits attack all foes in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": ", dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "(floor(@level/2))d6",
                "damageType": "spirit"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage. The damage increases by 1d6 at 10th level and every 2 levels thereafter. Each affected creature must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " saving throw against the higher of your class DC or spell DC."
          }
        ]
      }
    ],
    "rules": [],
