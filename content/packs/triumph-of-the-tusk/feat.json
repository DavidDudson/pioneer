    "pack": "triumph-of-the-tusk",
    "kind": "feat",
    "slug": "feat:inked-panoply",
    "name": "Inked Panoply",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7651"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature targets you with an attack, and you can see the attacker."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your tattoos can briefly animate and extend from your skin, granting you a spectral shield-bearer who protects you from harm. Doing so expends one use of your "
          },
          {
            "type": "ref",
            "id": "530bd5e3-9926-52f5-bdc5-090b51e6fede"
          },
          {
            "type": "text",
            "text": ", granting you a +1 circumstance bonus to AC against the triggering attack. In addition, you gain resistance to mental, spirit, and void damage equal to twice your number of tattooed historian feats against the triggering attack."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:inked-panoply",
        "toggleable": true
      },
      {
        "key": "FlatModifier",
