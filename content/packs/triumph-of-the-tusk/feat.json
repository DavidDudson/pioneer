    "kind": "feat",
    "slug": "feat:agent-of-all-holds",
    "name": "Agent of all Holds",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7650"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You critically fail a Diplomacy, Intimidation, or Performance check."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Orcs across Belkzen recognize you as an honored lorekeeper. You're adept at leveraging this status and showing off your tattoos to resolve conflicts, change minds, or distract others from a faux pas. You get a failure on the check, rather than a critical failure. If the triggering check was made against a creature with the orc trait, you can instead add the fortune trait to this ability and reroll the check, treating any critical failure as a failure."
          }
        ]
      }
    ],
    "rules": [],
