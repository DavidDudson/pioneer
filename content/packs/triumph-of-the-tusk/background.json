      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Constitution",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Wisdom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Survival skill and the Badlands Lore skill. You gain the "
          },
          {
            "type": "ref",
            "id": "5e597080-193c-5a28-a1ed-901ee2ebba74"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
