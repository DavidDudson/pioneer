  {
    "id": "15c43b83-cbd5-5f35-bef8-e55fbf30135b",
    "pack": "triumph-of-the-tusk",
    "kind": "weapon",
    "slug": "weapon:venom-lash",
    "name": "Venom Lash",
    "level": 7,
    "rarity": "uncommon",
    "traits": ["disarm", "magical", "poison", "sweep", "trip"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "With careful alchemical treatments, orc weaponsmiths can enhance the durability and flexibility of giant scorpion tails to create multi-headed "
          },
          {
            "type": "text",
            "text": "+1 striking flails",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". Additional enchantments allow the stingers to generate their own venom. When you would apply this flail's critical specialization, you can instead deal "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "poison",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the target. You gain an item bonus to the persistent poison damage equal to the weapon's item bonus to attack rolls."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Envenom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate, poison)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You temporarily fill the flail's stingers with venom. The next successful Strike you make with it before the end of your next turn deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "damageType": "poison",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the target. If the Strike critically succeeds and if you would apply persistent poison damage with this weapon's alternate critical specialization, you combine the two effects to deal "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "3d6",
                "damageType": "poison",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the target."
          }
        ]
      }
    ],
