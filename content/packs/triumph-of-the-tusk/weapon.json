    "slug": "weapon:faultline-hammer",
    "name": "Faultline Hammer",
    "level": 6,
    "rarity": "uncommon",
    "traits": ["magical", "razing", "shove", "two-hand-d10", "versatile-p"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The steel head of this "
          },
          {
            "type": "text",
            "text": "+1 striking earthbreaker",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " has a large crack that zigzags down its center, making it look like it could crack in half with any swing. This belies the hammer's strength; its strikes can shatter stone with ease."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Create Faultline",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You Strike an object or raised shield with the faultline hammer and would deal piercing damage to that object"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Until the end of your next turn, any weapon that Strikes the object deals additional damage as though the weapon had the razing trait. The triggering Strike also deals this additional damage."
          }
        ]
      }
    ],
