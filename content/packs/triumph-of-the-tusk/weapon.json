  {
    "id": "abc7d5e6-b94e-5a76-9ab9-80ca1a2ddeae",
    "pack": "triumph-of-the-tusk",
    "kind": "weapon",
    "slug": "weapon:kinetic-club",
    "name": "Kinetic Club",
    "level": 7,
    "rarity": "uncommon",
    "traits": ["backswing", "earth", "magical", "shove"],
    "sources": [
      {
        "kind": "book",
        "book": "triumph-of-the-tusk"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Embedded along the length of this "
          },
          {
            "type": "text",
            "text": "+1 striking greatclub",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " are the teeth and scales of a zetogeki, a giant lizard that can absorb and then release bursts of kinetic energy. The more momentum a wielder builds up while swinging the weapon, the more forceful the impact when it finally makes contact."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Store Kinetic Energy",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You add a circumstance bonus to your attack with the "
          },
          {
            "type": "text",
            "text": "kinetic club's",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " backswing trait and successfully Strike your target"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You channel the club's stored energy into the Strike, dealing 1d6 additional damage. If the club has a "
          },
          {
            "type": "text",
            "text": "greater striking",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " rune, increase the additional damage to 2d6. If the club has a "
          },
          {
            "type": "text",
            "text": "major striking",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " rune, increase the additional damage to 3d6."
          }
        ]
      }
    ],
