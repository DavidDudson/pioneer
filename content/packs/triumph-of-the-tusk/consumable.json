          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This thick, waxy gel erases the effects of flame. It restores "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d12"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points to a creature when applied to their body. If the creature has taken fire damage within the last minute, it restores additional Hit Points equal to the amount of fire damage the creature took within the last minute (maximum +10). Finally, the creature becomes immune to the effects of severe heat for 1 hour."
          }
        ]
      }
