  {
    "id": "9092a427-3b5b-593a-9979-a2d2b72ce43e",
    "pack": "npc-core",
    "kind": "spell",
    "slug": "spell:far-flung-fetch",
    "name": "Far-Flung Fetch",
    "level": 2,
    "rarity": "rare",
    "traits": ["manipulate", "subtle", "teleportation"],
    "sources": [
      {
        "kind": "book",
        "book": "npc-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can pilfer an object even if it's outside the reach of your fingers. You teleport the target into one of your open hands. If you don't have a hand free, it falls to the ground at your feet."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (3rd)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The range increases to 120 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (5th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The range increases to 120 feet, and you can target an unattended object with a Bulk of 1 or less."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (7th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As 5th rank, and when you Cast the Spell you can spend 3 actions instead of 1 to increase the range to planetary. If you do, you don't need line of sight to the target, but you must be extremely familiar with the target."
          }
        ]
      }
    ],
    "rules": [],
