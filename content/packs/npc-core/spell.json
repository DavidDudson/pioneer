  {
    "id": "9e5dbe40-8343-56f9-b0c8-d4e7c091925c",
    "pack": "npc-core",
    "kind": "spell",
    "slug": "spell:burglars-blind",
    "name": "Burglar's Blind",
    "level": 3,
    "rarity": "rare",
    "traits": ["illusion", "manipulate", "subtle"],
    "sources": [
      {
        "kind": "book",
        "book": "npc-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The only thing thieves love more than being silent and stealthy is the piles of gold they win with that silence and stealth. You mask the target with multiple illusions combined in a perfect mix, affecting them with both the "
          },
          {
            "type": "ref",
            "id": "e8221b18-c4c7-5d99-a604-a3cf119d41b1"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "306213b0-9e11-55d8-b630-8786ea86a27d"
          },
          {
            "type": "text",
            "text": " spells. If the target takes a hostile action, "
          },
          {
            "type": "text",
            "text": "burglar's blind",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " and both the spells it grants end after the hostile action is completed."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (5th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You can target up to 5 willing creatures. The spells end for all targets if any one of them takes a hostile action."
          }
        ]
      }
    ],
    "rules": [],
