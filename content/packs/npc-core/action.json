[
  {
    "id": "522f699b-7078-5f92-a320-7c2224008c38",
    "pack": "npc-core",
    "kind": "action",
    "slug": "action:change-formation",
    "name": "Change Formation",
    "rarity": "common",
    "traits": ["concentrate", "move"],
    "sources": [
      {
        "kind": "book",
        "book": "npc-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The troop reconfigures to assume one of the formations below they know. Using this action again ends any previous formation, and the troop can also use this action to revert to its default formation, ending any benefits and drawbacks."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Loose",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " Members of the troop fan out to cover more ground. "
                },
                {
                  "type": "text",
                  "text": "Benefit",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " Any weaknesses the troop has to area and splash damage are suppressed. "
                },
                {
                  "type": "text",
                  "text": "Drawback",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " Enemies' saving throws against the troop's damaging effects are one degree of success better than they roll."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Marching Column",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " This formation traverses long distances more rapidly. "
                },
                {
                  "type": "text",
                  "text": "Benefit",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop gains a +10 foot circumstance bonus to all its Speeds. "
                },
                {
                  "type": "text",
                  "text": "Drawback",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop is "
                },
                {
                  "type": "ref",
                  "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
                },
                {
                  "type": "text",
                  "text": " and takes a –2 penalty to Reflex saves."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Turtle Shell",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop interlocks their shields. Only a group with shields can use this formation. "
                },
                {
                  "type": "text",
                  "text": "Benefit",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop gains a +2 circumstance bonus to AC against ranged attacks and to Reflex saves. "
                },
                {
                  "type": "text",
                  "text": "Drawback",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop takes a –10-foot penalty to all its Speeds."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Wedge",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop aligns itself behind a powerful commander. "
                },
                {
                  "type": "text",
                  "text": "Benefit",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop chooses an adjacent allied creature without the troop trait to fall in behind. Each time the chosen creature Strides, the troop follows as a free action, Striding to keep the chosen creature adjacent. "
                },
                {
                  "type": "text",
                  "text": "Drawback",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The troop loses some of their autonomy. They're slowed 1 and can't voluntarily move away from their leader."
                }
              ]
            }
          ]
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:change-formation",
        "toggleable": true,
        "suboptions": [
          {
            "value": "loose",
            "label": "Loose"
          },
          {
            "value": "marching-column",
            "label": "Marching Column"
          },
          {
            "value": "turtle-shell",
            "label": "Turtle Shell"
          },
          {
            "value": "wedge",
            "label": "Wedge"
          }
        ]
      },
      {
        "key": "FlatModifier",
        "selectors": ["all-speeds"],
        "type": "circumstance",
