  {
    "id": "c43e7f62-e72b-5776-ba6d-f45b0f866419",
    "pack": "npc-core",
    "kind": "action",
    "slug": "action:martial-artist-dirty-fighting-contraband-substance",
    "name": "(Martial Artist, Dirty Fighting) Contraband Substance",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "npc-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The martial artist pulls out a concealed alchemical vial of mutagen and drinks it to improve their combat prowess. The item is usually a "
          },
          {
            "type": "ref",
            "id": "e0e49434-da08-5307-afff-c7ee027670d4"
          },
          {
            "type": "text",
            "text": ", or "
          },
          {
            "type": "ref",
            "id": "1c1b6de6-2472-5755-8c3a-b54ab16a1660"
          },
          {
            "type": "text",
            "text": ". This ability can't be used again until the martial artist has time to acquire and hide a new mutagen. Some martial artists use concealed small vials, but others hide a syringe or soak the alchemical liquid into a garment they can put in their mouth."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
