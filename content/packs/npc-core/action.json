        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The grandmaster has a target "
          },
          {
            "type": "ref",
            "id": "cab530ff-ca20-5f0a-8a5e-b9fdb322b146"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "b374c4c9-d230-5167-8878-38e08932a071"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The grandmaster tosses their target upwards and electrocutes them with a qi-infused double palm strike as they land. The target becomes "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": ", loses the grabbed or restrained condition, and takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "5d6",
                "damageType": "bludgeoning"
              },
              {
                "formula": "2d8",
                "damageType": "electricity",
                "category": "persistent"
              }
            ],
            "label": "5d6 bludgeoning damage and 2d8 persistent electricity damage"
          },
          {
            "type": "text",
            "text": " ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 38,
            "basic": true
          },
          {
            "type": "text",
            "text": " save)."
          }
        ]
      }
    ],
