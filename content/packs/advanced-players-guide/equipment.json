    "pack": "advanced-players-guide",
    "kind": "equipment",
    "slug": "equipment:urn-of-ashes",
    "name": "Urn of Ashes",
    "level": 9,
    "rarity": "common",
    "traits": ["magical", "void"],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=751"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This sealed pewter urn contains the ashes of a benevolent ancestor, with a sliver of lingering spirit that strives to protect you."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You would become doomed or your doomed value would increase"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ashes aren't doomed"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ashes in the urn intervene, taking the doomed condition in your place, and you don't gain or increase the value of your own doomed condition. Each night when you get a full night's rest, you can reduce your own doomed condition or that of the urn, but not both."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " envision, interact (attack)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per round"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The urn shoots a bolt of void energy at a foe within 30 feet."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Attempt a spell attack roll against the target's AC, using a modifier of 1d20+15 or your own spell attack roll modifier, whichever is higher. On a success, the bolt deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d4",
                "damageType": "void"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage (doubled on a critical success)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.3G2No6QaU1wSPTh6"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 700
        }
      },
