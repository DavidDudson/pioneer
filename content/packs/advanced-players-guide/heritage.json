  {
    "id": "3fe83653-972a-5041-828f-90a17574deba",
    "pack": "advanced-players-guide",
    "kind": "heritage",
    "slug": "heritage:nine-lives-catfolk",
    "name": "Nine Lives Catfolk",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=61"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your family has always seemed to bound back from disaster, not through physical hardiness or specialized skill, but from sheer luck. Other catfolk whisper that you have nine lives."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you are reduced to 0 Hit Points by a critical hit on an attack roll, you become "
          },
          {
            "type": "ref",
            "id": "c0cd649a-7029-5174-a5b4-678f51598dec",
            "label": "Dying 1"
          },
          {
            "type": "text",
            "text": " instead of dying 2."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.hOPOyyt7qZXYYCOU"
    },
