  {
    "id": "6f6d2b4e-9f42-5877-91d3-cc36efd5a412",
    "pack": "advanced-players-guide",
    "kind": "heritage",
    "slug": "heritage:hunting-catfolk",
    "name": "Hunting Catfolk",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=59"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You come from a long line of skilled hunters and trackers and have a particularly keen sense of smell."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain imprecise scent with a range of 30 feet. This means you can use your sense of smell to determine a creature's location. The GM will usually double the range if you're downwind from the creature or halve the range if you're upwind."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In addition, you gain a +2 circumstance bonus to "
          },
          {
            "type": "ref",
            "id": "b81cfd58-ce40-526a-b3da-f3c218b5c566"
          },
          {
            "type": "text",
            "text": " a creature or object if you've smelled it before."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["action:track", "target:previously-smelled"],
        "display": {
          "label": "Hunting Catfolk (Track smelled creatures)"
        }
      },
      {
        "key": "Sense",
        "sense": "279973df-e7b9-5fa1-9bb6-1cfdc54b82b6",
        "acuity": "imprecise",
        "range": 30
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.1lv7RMp7t5iqeUFT"
    },
    "data": {
      "ancestry": "d9e02ac6-fa8f-5177-9a03-d1de22cf1ea4"
    }
  },
  {
    "id": "2f4066ee-1d49-5273-bf78-bc89e8667b6b",
    "pack": "advanced-players-guide",
    "kind": "heritage",
    "slug": "heritage:jinxed-tengu",
    "name": "Jinxed Tengu",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=77"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your lineage has been exposed to curse after curse, and now, they slide off your feathers like rain. If you succeed at a saving throw against a curse or misfortune effect, you get a critical success instead."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you would gain the "
          },
          {
            "type": "ref",
            "id": "cd164d22-2d8e-5fd2-b8b2-03e1360df1e7"
          },
          {
            "type": "text",
            "text": " condition, attempt a "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 17
          },
          {
            "type": "text",
            "text": " check. On a success, reduce the value of the doomed condition you would gain by 1."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "AdjustDegreeOfSuccess",
        "selectors": ["saving-throw"],
        "adjustment": {
          "success": "one-degree-better"
        },
        "checkType": "save",
        "predicate": [
          {
            "or": ["option:curse", "option:misfortune"]
          }
        ]
      },
      {
        "key": "Note",
