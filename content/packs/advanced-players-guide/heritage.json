      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your ancestors lived in dark spaces underground, granting you dark fur and a vaguely unnatural mien that unnerves sapient creatures and frightens animals. You gain the trained proficiency rank in Intimidation and can use Intimidation to "
          },
          {
            "type": "ref",
            "id": "ed0f3425-17f0-51f3-bb5d-1ca7475499a5"
          },
          {
            "type": "text",
            "text": " animals. When you "
          },
          {
            "type": "ref",
            "id": "2a3671d0-7d0b-53db-8648-861d457f0175"
          },
          {
            "type": "text",
            "text": " an animal, you don't take a penalty for not sharing a language with it. If you would automatically become trained in Intimidation (from your background or class, for example), you become trained in another skill of your choice."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Animals' attitudes toward you begin one degree worse than normal, usually starting at unfriendly instead of indifferent for domesticated animals, and hostile instead of unfriendly for wild animals."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Note",
        "selectors": ["skill:intimidation"],
        "title": "Shadow Rat",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "When you Demoralize an animal, you don't take a penalty for not sharing a language with it."
              }
            ]
          }
        ],
        "predicate": ["action:demoralize", "target:trait:animal"]
      }
    ],
