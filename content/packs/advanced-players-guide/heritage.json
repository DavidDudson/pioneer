    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=78"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You come from a line of tengu ascetics, leaving you with a link to the spirits of the world and the Great Beyond. You can cast the "
          },
          {
            "type": "ref",
            "id": "ad3bed02-6064-56d1-949c-7f5b8355cee7"
          },
          {
            "type": "text",
            "text": " cantrip as a primal innate spell at will. A cantrip is heightened to a spell rank equal to half your level rounded up."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each time you cast a spell from a tengu heritage or ancestry feat, you can decide whether it's a divine or primal spell."
          }
        ]
      }
    ],
    "rules": [],
