[
  {
    "id": "20aa64ee-126c-5181-9e48-a4d9c7cbd36f",
    "pack": "advanced-players-guide",
    "kind": "heritage",
    "slug": "heritage:cavern-kobold",
    "name": "Cavern Kobold",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=63"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You hatched into a warren among narrow tunnels and countless kin. Your body is flexible."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When "
          },
          {
            "type": "ref",
            "id": "d26ec2df-83bd-5f2f-988e-e922681de6ba",
            "label": "Climbing"
          },
          {
            "type": "text",
            "text": " rock walls, stalactites, and other natural stone features, you move at half your Speed on a success and at full Speed on a critical success (and you move at full Speed on a success if you have "
          },
          {
            "type": "ref",
            "id": "a1f321de-e696-5d28-ad54-980c6372750b"
          },
          {
            "type": "text",
            "text": "). This doesn't affect you if you're using a climb Speed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you roll a success on an Acrobatics check to "
          },
          {
            "type": "ref",
            "id": "c677e3a9-1109-541c-8888-d97a6129acda"
          },
          {
            "type": "text",
            "text": ", you get a critical success instead."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Note",
        "selectors": ["skill:athletics"],
        "title": "Cavern Kobold",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "When you climb natural stone, you move at half your Speed on a success, and full speed on a critical success."
              }
            ]
          }
        ],
        "predicate": ["action:climb", "option:natural-stone"]
      },
      {
        "key": "Note",
        "selectors": ["skill:acrobatics"],
        "title": "Cavern Kobold",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "When you roll a success to Squeeze, you get a critical success instead."
              }
            ]
          }
        ],
        "predicate": ["action:squeeze"]
      },
      {
        "key": "AdjustDegreeOfSuccess",
        "selectors": ["skill:acrobatics"],
        "adjustment": {
          "success": "one-degree-better"
        },
        "checkType": "skill",
        "predicate": ["action:squeeze"]
      }
    ],
