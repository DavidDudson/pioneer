        "title": "Jinxed Tengu",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "If you succeed at a saving throw against a curse or misfortune effect, you get a critical success instead."
              }
            ]
          }
        ]
      }
    ],
