    "slug": "ancestry-feature:sharp-beak",
    "name": "Sharp Beak",
    "level": 0,
    "rarity": "uncommon",
    "traits": ["tengu"],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide"
