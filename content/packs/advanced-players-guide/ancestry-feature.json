    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "With your Sharp Beak, you are never without a weapon. You have a beak unarmed attack that deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage. Your beak is in the brawling weapon group and has the finesse and unarmed traits."
          }
        ]
      }
    ],
    "rules": [
      {
