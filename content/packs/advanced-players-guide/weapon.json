    "slug": "weapon:crystal-shards-moderate",
    "name": "Crystal Shards (Moderate)",
    "level": 4,
    "rarity": "common",
    "traits": ["alchemical", "bomb", "consumable", "earth", "splash"],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=685"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Usage",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " held in 1 hand"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Strike"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This flask holds a pressurized red-brown gas flecked with bits of sublimated crystal. You gain a +1 item bonus to attack rolls. When the bomb explodes, it deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d4",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4",
                "damageType": "piercing",
                "category": "splash"
              }
            ],
            "label": "4 piercing splash damage"
          },
          {
            "type": "text",
            "text": " as the mixture suddenly turns into solid crystals flying at high speeds."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Surfaces in the splash area grow brittle, gleaming red crystals that crumble to dust after 1 minute. The crystals on level surfaces are "
          },
          {
            "type": "ref",
            "id": "474c405c-c7e4-5468-9a5d-db9761113555"
          },
          {
            "type": "text",
            "text": ". The crystals on vertical surfaces can be used briefly as handholds, granting the listed item bonus to the next Athletics check to "
          },
          {
            "type": "ref",
            "id": "d26ec2df-83bd-5f2f-988e-e922681de6ba"
          },
          {
            "type": "text",
            "text": " each space. The crystals in each space crumble after the creature leaves, whether Climbing or moving through the caltrops."
          }
        ]
      }
    ],
    "rules": [],
