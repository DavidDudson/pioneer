  {
    "id": "191eb051-ada4-514c-a84f-4677712fc304",
    "pack": "advanced-players-guide",
    "kind": "weapon",
    "slug": "weapon:infiltrators-accessory",
    "name": "Infiltrator's Accessory",
    "level": 5,
    "rarity": "common",
    "traits": ["agile", "concealable", "finesse", "illusion", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=736"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This elegant +1 striking sword cane serves equally well as a fashionable accessory and hidden weapon suitable for high-society events where weapons aren't typically permitted."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You twist the sword cane's hilt, magically merging the blade into the cane. While the blade is merged, it can't be drawn and gains the benefits of a 3rd-rank magic aura spell to appear non-magical. Passive observers can't attempt a check to notice the cane is anything more than a mundane, if superb, fashion accessory. Those carefully examining it can discern the cane is more than it appears, but doing so is extremely difficult ("
          },
          {
            "type": "check",
            "statistic": "perception",
            "dc": 30
          },
          {
            "type": "text",
            "text": "). Activating the sword cane again releases the blade, allowing it to be drawn normally."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.AYdpUABAZeZnSA7s"
    },
