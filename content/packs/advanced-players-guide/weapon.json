  {
    "id": "a74249a7-e445-512b-a5f5-f63fafb0f408",
    "pack": "advanced-players-guide",
    "kind": "weapon",
    "slug": "weapon:four-ways-dogslicer",
    "name": "Four-Ways Dogslicer",
    "level": 12,
    "rarity": "uncommon",
    "traits": ["agile", "backstabber", "cold", "electricity", "finesse", "fire", "goblin", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=733"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+2 striking dogslicer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is obviously the work of a brilliant but scrappy artisan who valued versatility over safety. Four toothy gems line the blade's cutting edge, three of which glow-one with fiery red light, one with a chill blue, and one that gives off sparks-while the last is a glistening black. Each of these gems embodies a weapon property rune, but only one rune can be active at a time."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You twist the gem along the blade corresponding with the desired weapon rune: red for "
          },
          {
            "type": "text",
            "text": "flaming",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", blue for "
          },
          {
            "type": "text",
            "text": "frost",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", or yellow for "
          },
          {
            "type": "text",
            "text": "shock",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". You take 1d6 damage of the type the chosen rune deals. You can instead twist the black gem to disable the active property rune, taking no damage."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.3oexArva2aEm69WV"
    },
