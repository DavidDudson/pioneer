          {
            "type": "text",
            "text": "This +1 striking "
          },
          {
            "type": "ref",
            "id": "3e294082-c3ff-58be-ab80-1608b9c6229a"
          },
          {
            "type": "text",
            "text": " crossbow has an array of crystalline lenses and silver fittings along the stock and feels strangely light."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You aim through the crossbow's crystalline lenses, gaining imprecise vision onto the "
          },
          {
            "type": "text",
            "text": "Ethereal Plane",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " with a range of 60 feet in addition to your normal senses for the rest of your turn. While this effect lasts, your next Strike with the "
          },
          {
            "type": "text",
            "text": "spiritsight crossbow",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " can also affect targets on the Ethereal Plane during the first 60 feet of its flight."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.2UX3tlC5vKeQjG7t"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 450
        }
      },
      "bulk": 2,
