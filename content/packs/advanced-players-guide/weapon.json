    "sources": [
      {
        "kind": "book",
        "book": "advanced-players-guide",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=687"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Strike"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These spring-loaded metal canisters contain a mixture of chemicals and salts that drain and disintegrate nearby undead creatures."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A "
          },
          {
            "type": "text",
            "text": "ghost charge",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " gives a +1 item bonus to attack rolls, deals 2d8 vitality damage and 2 vitality splash damage, though as usual for vitality damage, this damage harms only undead and creatures with void healing. A primary target that takes damage from a "
          },
          {
            "type": "text",
            "text": "ghost charge",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " becomes "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 1"
          },
          {
            "type": "text",
            "text": " until the start of your next turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ghost charges",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " are designed to explode even on contact with a spiritual substance, making them ideal for damaging incorporeal undead."
          }
        ]
      }
    ],
