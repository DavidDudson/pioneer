  {
    "id": "6509830c-99c9-5470-b90e-90fa4e579b4e",
    "pack": "gm-core",
    "kind": "environment",
    "slug": "environment:wind",
    "name": "Wind",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core",
        "page": 95,
        "aon": "https://2e.aonprd.com/Rules.aspx?ID=2821"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Wind imposes a circumstance penalty on auditory Perception checks depending on its strength. It also interferes with physical ranged attacks such as arrows, imposing a circumstance penalty to attack rolls involving such weapons, and potentially making attacks with them impossible in powerful windstorms."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Wind snuffs out handheld flames; lanterns protect their flame from the wind, but particularly powerful winds can extinguish these as well."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Wind is difficult or greater difficult terrain when Flying. Moving in wind of sufficient strength requires a Maneuver in Flight action, and fliers are blown away on a critical failure or if they don't succeed at a minimum of one such check each round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Even on the ground, particularly strong winds might require a creature to succeed at an Athletics check to move, knocking the creature back and prone on a critical failure. On such checks, Small creatures typically take a –1 circumstance penalty, and Tiny creatures typically take a –2 penalty."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Note",
        "selectors": ["attack-roll", "perception"],
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Wind imposes a circumstance penalty on auditory Perception checks depending on its strength. It also interferes with physical ranged attacks such as arrows, imposing a circumstance penalty to attack rolls involving such weapons, and potentially making attacks with them impossible in powerful windstorms."
              }
            ]
          }
        ]
      }
    ],
