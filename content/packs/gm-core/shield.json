          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You use the "
          },
          {
            "type": "text",
            "text": "forge warden",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to Shield Block an adjacent creature's attack and the shield takes damage"
          }
        ]
      },
      {
        "type": "paragraph",
