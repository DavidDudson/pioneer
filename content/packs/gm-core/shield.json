      "hardness": 6,
      "hitPoints": 24,
      "activations": [
        {
          "slug": "float",
          "name": "Float",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "baseItem": "buckler",
      "acBonus": 1
    }
  },
