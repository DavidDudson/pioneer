[
  {
    "id": "9d41e3b9-ddb3-508f-ba94-28071c852b83",
    "pack": "gm-core",
    "kind": "shield",
    "slug": "shield:dragonslayers-shield",
    "name": "Dragonslayer's Shield",
    "level": 9,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core",
        "page": 234,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=2818"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A "
          },
          {
            "type": "text",
            "text": "dragonslayer's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is a steel shield covered with dragonhide from a specific dragon, which visually distinguishes each shield from the others. While raised, this steel shield (Hardness 8, HP 32, BT 16) grants its circumstance bonus to Reflex saves against area effects (as well as to AC, as normal)."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "While you hold the shield, it also grants you a +2 circumstance bonus to Will saves against a dragon's frightful presence ability. The shield has resistance 10 against the damage type corresponding to the dragon breath of the dragon whose hide was used in its creation (for example, a "
          },
          {
            "type": "text",
            "text": "dragonslayer's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " made with the hide of a diabolic dragon would grant resistance to fire); this applies after reducing the damage for Hardness, so when you use Shield Block, the "
          },
          {
            "type": "text",
            "text": "dragonslayer's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " takes 18 less damage from attacks of that damage type. You can use Shield Block against effects that deal damage of that type."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include at least 30 gp of dragonhide."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["save:will"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["action:frightful-presence", "origin:trait:dragon"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.Q8BscHUFiM1a86PO"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 670
        }
      },
      "bulk": 1,
      "hardness": 8,
      "hitPoints": 32,
      "baseItem": "steel-shield",
      "acBonus": 2
    }
  },
  {
    "id": "9275b276-b3d0-5d15-88a4-63c3700e6b97",
    "pack": "gm-core",
    "kind": "shield",
    "slug": "shield:floating-shield",
    "name": "Floating Shield",
    "level": 11,
    "rarity": "uncommon",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core",
        "page": 234,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=2819"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A "
          },
          {
            "type": "text",
            "text": "floating shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is usually carved with wing motifs. This buckler (Hardness 6, HP 24, BT 12) can protect you on its own."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Float",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shield magically releases itself and floats off your arm into the air next to you, granting you its bonus automatically, as if you had Raised the Shield."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Because you're not wielding the shield, you can't use reactions such as Shield Block with the shield, but you gain its benefits even when using both of your hands."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "After 1 minute, the shield drops to the ground, ending its floating effect. While the shield is adjacent to you, you can Interact to grasp it, ending its floating effect early."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.ydNocKN6afzIyVh6"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 1250
        }
      },
