    "level": 17,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Made of overlapping, lustrous black scales of standard-grade adamantine, this +2 "
          },
          {
            "type": "text",
            "text": "greater resilient ",
            "marks": ["emphasis"]
          },
          {
            "type": "ref",
            "id": "1100f76c-d253-50b6-82c0-c70593e97e10"
          },
          {
            "type": "text",
            "text": " adamantine scale mail",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " seems to momentarily thicken at the point of impact when hit."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Whenever the armor's "
          },
          {
            "type": "text",
            "text": "fortification",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " rune successfully turns a significant foe's critical hit into a normal hit, one of the scales on the armor turns violet. You gain resistance to physical damage equal to the number of violet scales, to a maximum of 8."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "At dawn each day, all the violet scales return to normal."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include 1,600 gp of adamantine."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "d6f38c0c-72f7-5b86-948f-0d5667e46f57"
          }
        ]
      }
