[
  {
    "id": "4c92f3e8-441c-5c3e-86ff-642b78ddb086",
    "pack": "gm-core",
    "kind": "armor",
    "slug": "armor:barding-of-the-zephyr",
    "name": "Barding of the Zephyr",
    "level": 10,
    "rarity": "common",
    "traits": ["companion", "invested", "primal"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This light barding is covered in stylized wind motifs. When you suit up your animal companion, the barding adjusts to fit your animal companion regardless of its shape."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When your companion falls, wind picks it up from below; it gains the effects of Gentle Landing."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Take Flight",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You trace a finger along the wind motifs on the barding, granting your companion wearing the barding a fly Speed of 30 feet for 10 minutes. Even if the companion doesn't have the mount special ability, it can still Fly while being ridden."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "b15edb2d-a252-51f5-a905-5a6025195958"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.eoI3M6FXtcPWeg7i"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 900
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "take-flight",
          "name": "Take Flight",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "category": "light-barding",
      "acBonus": 1,
      "dexCap": 5,
      "checkPenalty": 1,
      "speedPenalty": 5,
      "strength": 3
    }
  },
