  {
    "id": "93a6a3e7-bf1a-5413-801c-686ceeafc46f",
    "pack": "gm-core",
    "kind": "armor",
    "slug": "armor:elven-chain-high-grade",
    "name": "Elven Chain (High-Grade)",
    "level": 20,
    "rarity": "uncommon",
    "traits": ["flexible"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Elven chain is a Chain Shirt made of dawnsilver that glitters in even the faintest light. Because it's constructed with small, supple rings, it has no check penalty."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Created by elven artisans employing ancient crafting techniques, elven chain is exceptionally quiet. Unlike other chain shirts-even other dawnsilver chain shirts-elven chain does not have the noisy trait. This suit of armor can be etched with runes like any other dawnsilver chain shirt."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include dawnsilver worth at least 26,000 gp"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.PuqdH7DmNsN79HyE"
    },
    "data": {
