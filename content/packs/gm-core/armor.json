    "kind": "armor",
    "slug": "armor:lions-armor",
    "name": "Lion's Armor",
    "level": 12,
    "rarity": "common",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Various parts of this +2 "
          },
          {
            "type": "text",
            "text": "resilient half plate",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " are forged into the shape of a lion's head. The golden lion heads grant you a commanding presence and seem to actively growl at your enemies, granting you a +2 item bonus to Intimidation."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The lions on the armor work in tandem with the lion on a "
          },
          {
            "type": "text",
            "text": "lion's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". If you critically hit with the "
          },
          {
            "type": "text",
            "text": "lion's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " using Lion Bite, the lions on the armor roar in support of the shield, causing the target of the shield's Strike to become Frightened 1."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Roar of the Pride",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The lions on your armor roar, attempting to cow your enemies. Attempt a check to Demoralize each enemy within 30 feet of you. On a critical success, the target is also Fleeing for 1 round."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:intimidation"],
        "type": "item",
        "value": 2
      }
    ],
