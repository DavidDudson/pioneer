  {
    "id": "544f6158-2224-5a00-8784-2b0e59697bee",
    "pack": "gm-core",
    "kind": "armor",
    "slug": "armor:life-saver-mail",
    "name": "Life-Saver Mail",
    "level": 14,
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "gm-core"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This suit of "
          },
          {
            "type": "text",
            "text": "+2 resilient fortification splint mail",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " has a large, green gemstone inset in a prominent location. While wearing the armor, you feel at ease knowing the armor can protect you in even dire circumstances. The gemstone glows with life essence, casting green light as brightly as a torch. You can suppress or resume this light by using a single action, which has the concentrate trait."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Second Chance",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " (concentration)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You would die"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The armor's gemstone turns gray as it shares life energy with you. The armor casts Breath of Life on you."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Shielding Light",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentration, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You tap on the gemstone, producing a protective screen of green light. You cast a 5th-rank Shield spell. As normal with the spell, you can't cast "
          },
          {
            "type": "text",
            "text": "shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " again (using this activation or other means) for 10 minutes if you use it to Shield Block."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:lit-life-saver-mail",
        "toggleable": true,
        "value": true,
        "display": {
          "label": "Life-Saver Mail is lit"
        }
      }
    ],
