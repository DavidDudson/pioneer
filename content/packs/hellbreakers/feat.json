  {
    "id": "d545d4c4-cc89-51ad-9cc9-60e8abc8ff8a",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:return-to-the-pit",
    "name": "Return to the Pit!",
    "level": 12,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8543",
        "page": 217
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can send the fiends who have vexed you back to their home plane where they belong. You can cast "
          },
          {
            "type": "ref",
            "id": "b2355f5f-2795-58d8-a713-df34a0257e46"
          },
          {
            "type": "text",
            "text": " once per day as a divine innate spell. When you take this feat, you craft a personal symbol of the Hellbreakers League that's anathema to devils. If you wield this symbol in one hand when you spend an extra action while casting "
          },
          {
            "type": "text",
            "text": "banishment",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " on a devil, you don't need to pay the extra cost to give that creature a –2 circumstance penalty to its save."
          }
        ]
      }
    ],
    "rules": [],
