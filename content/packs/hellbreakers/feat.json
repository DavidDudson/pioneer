    "kind": "feat",
    "slug": "feat:hellbreakers-resolve",
    "name": "Hellbreaker's Resolve",
    "level": 4,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8536",
        "page": 216
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gird yourself in both mind and body for danger, steeling your resolve. You gain a number of temporary Hit Points equal to your level that last for 1 minute. While you have those temporary Hit Points, you gain a +1 status bonus to Will saves."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "ce872563-e177-5b30-bcd5-d01a9f89fbe6"
          }
        ]
      }
    ],
