  {
    "id": "0d814de4-5502-56b3-ac27-6df3cfbbdd7f",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:hells-bane",
    "name": "Hell's Bane",
    "level": 8,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8539",
        "page": 217
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your in-depth knowledge of your foes grants you insight into their weaknesses, granting you an advantage when fighting against them. When you critically succeed at a skill check to Recall Knowledge about a devil or Hellknight, you gain a +4 status bonus to damage against that creature for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
