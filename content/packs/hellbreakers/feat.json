  {
    "id": "ed4c9f44-eece-57e7-b123-c682516311b0",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:opportune-trickster",
    "name": "Opportune Trickster",
    "level": 6,
    "rarity": "common",
    "traits": ["archetype", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " An adjacent ally makes a melee Strike against a creature."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're adjacent to both your ally and the creature."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You aren't above using underhanded tactics to gain an advantage, easily routing your opponents when they attack. Attempt a "
          },
          {
            "type": "check",
            "statistic": "skill:deception"
          },
          {
            "type": "text",
            "text": " check against the Perception DC of the creature that's the target of the triggering attack. Regardless of the result, the target is temporarily immune to your attempts to use Opportune Trickster for the next 10 minutes."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " (including against the triggering attack) until the end of your ally's turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is off-guard against the triggering attack."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You lose your balance in your attempt to assist your ally and fall "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Special",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " If you have the "
          },
          {
            "type": "ref",
            "id": "88af3edf-2b57-5a2f-9a0d-4e7f540fc2ef"
          },
          {
            "type": "text",
            "text": " skill feat, you can attempt a "
          },
          {
            "type": "check",
            "statistic": "skill:thievery"
          },
          {
            "type": "text",
            "text": " check instead of a Deception check; if you do, this action loses the mental trait"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
