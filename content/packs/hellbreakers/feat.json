  {
    "id": "1e72abb2-7928-54f9-bbe6-210459db40bc",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:devil-you-know",
    "name": "Devil You Know",
    "level": 4,
    "rarity": "common",
    "traits": ["archetype", "skill"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8535",
        "page": 216
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your knowledge of your enemies gives you an advantage against them, granting you a swift reaction to their devilry. If you know you're fighting against any devils or Hellknights at the beginning of an encounter, you can roll the respective Lore skill for your initiative roll."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In addition, whenever you successfully Recall Knowledge about a creature using Devil Lore or Hellknight Lore, you gain a +1 circumstance bonus to your next skill check against that creature before the end of your next turn. If you're a master in Devil Lore or Hellknight Lore, the bonus increases to +2."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "4ee0e73c-4b99-5c7f-93eb-885317ea3eb3"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.DqPZCCbWzfMMGFI8"
    },
    "data": {
      "category": "skill",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Hellbreaker Dedication; expert in Devil Lore or Hellknight Lore"
            }
          ]
        }
      ],
      "archetype": "eee4c7b6-a02f-541b-bb80-56ef169abfe7"
    }
  },
  {
    "id": "65bb5abd-55d5-5552-b127-ea8952fa120d",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:hellbreaker-dedication",
    "name": "Hellbreaker Dedication",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["archetype", "dedication"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8534",
        "page": 216
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Access",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're a member of the Hellbreakers league."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "By joining the League, you've taken on the responsibilities of a Hellbreaker. You gain the "
          },
          {
            "type": "ref",
            "id": "50ac17a9-a644-58e8-8ee0-ce4c6cfbf17b"
          },
          {
            "type": "text",
            "text": " general feat for both Devil Lore and Hellknight Lore. If you were already trained in one or both of those Lore skills, you also become trained in a Lore skill of your choice."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you roll initiative, you can attempt a Recall Knowledge, Recall Knowledge, or Recall Knowledge check to "
          },
          {
            "type": "ref",
            "id": "3c873e49-a1c4-53b5-9694-66b860d94d43"
          },
          {
            "type": "text",
            "text": " about one enemy you can see as a free action, if that skill would be applicable. The GM is the final arbiter of whether or not one of those skills would be appropriate to Recall Knowledge about the enemy."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "GrantItem",
        "item": "50ac17a9-a644-58e8-8ee0-ce4c6cfbf17b"
      },
      {
        "key": "GrantItem",
        "item": "50ac17a9-a644-58e8-8ee0-ce4c6cfbf17b"
      },
      {
        "key": "Note",
        "selectors": ["initiative"],
        "title": "Hellbreaker Dedication",
        "text": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "When you roll initiative, you can attempt a recall-knowledge, recall-knowledge, or recall-knowledge check to Recall Knowledge about one enemy you can see as a free action, if that skill would be applicable."
              }
            ]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.v22KrWg1T7F5VYgx"
    },
    "data": {
      "category": "class",
      "archetype": "eee4c7b6-a02f-541b-bb80-56ef169abfe7"
    }
  },
  {
    "id": "52d44710-4446-520b-a00d-91348ce7b0b8",
