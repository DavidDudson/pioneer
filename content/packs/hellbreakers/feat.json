  {
    "id": "459c984b-2365-5939-9d88-f9afd33fa700",
    "pack": "hellbreakers",
    "kind": "feat",
    "slug": "feat:high-alert",
    "name": "High Alert",
    "level": 6,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=8537",
        "page": 216
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're constantly on guard, keeping watch over your allies against fiendish forces—no one can get the jump on your group while you're around. Choose an ally you can see within 30 feet. They gain a +1 circumstance bonus to their AC and Reflex saving throws against devils and creatures allied with the Chelaxian government (as determined by the GM) until the beginning of your next turn. This action gains the visual trait, the auditory trait, or both, depending on how you alert your ally."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "ba1b3a1f-f2fd-5da3-849a-4564dc42c6fc"
          }
        ]
      }
    ],
    "rules": [],
