    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This low-grade silver shield is equipped with a "
          },
          {
            "type": "text",
            "text": "+1 shield boss",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " emblazoned with the image of a beheaded fiend. Any creature with the unholy trait that wields the shield becomes "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 2"
          },
          {
            "type": "text",
            "text": " and can't recover from this condition while wielding the shield."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Silvery Backlash",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (concentrate, holy)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You Shield Block an attack from a creature with the unholy trait"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The fiendsbane shield's Hardness increases to 10, and the symbol of the beheaded demon lashes out in silvery ribbons, dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "3d6",
                "damageType": "slashing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 19,
            "basic": true
          },
          {
            "type": "text",
            "text": " save) to the creature whose attack you blocked. This damage is treated as silver for the purposes of weaknesses, resistances, and the like."
          }
        ]
      },
