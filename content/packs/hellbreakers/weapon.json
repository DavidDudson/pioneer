    "kind": "weapon",
    "slug": "weapon:crimson-thorn",
    "name": "Crimson Thorn",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["magical", "reach", "versatile-p"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "page": 213,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4188"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 asp coil",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is used by many trained Sisters of the Golden Erinys. It has a deep-red hue on each segment of the blade complemented by a pitch-black pommel. Death isn't the worst outcome for someone on the receiving end of its lashes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Taste the Pain",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " (manipulate, visual)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your last action was a Strike with the crimson thorn that dealt damage to a creature"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Attempt an Intimidation check to "
          },
          {
            "type": "ref",
            "id": "2a3671d0-7d0b-53db-8648-861d457f0175"
          },
          {
            "type": "text",
            "text": " the creature you dealt damage to with a +2 item bonus to the roll. You don't take any penalties to this check for not sharing a language."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.sAhQdzMThRXu4556"
    },
