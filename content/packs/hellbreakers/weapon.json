  {
    "id": "4159e10b-3a3b-5c60-a960-575fe810e438",
    "pack": "hellbreakers",
    "kind": "weapon",
    "slug": "weapon:calamity",
    "name": "Calamity",
    "level": 8,
    "rarity": "uncommon",
    "traits": ["magical", "versatile-p"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "page": 212,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4187"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hewn from a solid block of ensorcelled stone, this "
          },
          {
            "type": "text",
            "text": "+1 striking greatsword",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is monumental in heft as well as destructive force. The weapon is named for the disbelieving leaders of the Seventh Army of Exploration, who denied the power of such a weapon and claimed their losses came from natural disasters. When wielded against creatures that are larger than you, the sword gains the sweep trait."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Shatter Legions",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (earth)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You smash the sword down upon the ground with the anger of a conquered land and a subjugated people. Each creature in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": " takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d12",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 24,
            "basic": true
          },
          {
            "type": "text",
            "text": " save as the earth shatters beneath their feet. Until the beginning of your next turn, you gain the benefits of standard cover from the broken soil around you."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.YqhEmz8dmf02b99u"
    },
