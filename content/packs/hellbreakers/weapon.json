    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Order of the Rack uses weapons like the "
          },
          {
            "type": "text",
            "text": "dreamcrusher",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to crush those who dare stand in the way. This "
          },
          {
            "type": "text",
            "text": "+1 longsword",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " has additional weight at the tip of its blade for the wielder to drive home their strikes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Doom the Rebel",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per 10 minutes"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your last action was a Strike with the dreamcrusher that critically hit a creature"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature you critically hit must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 19
          },
          {
            "type": "text",
            "text": " save. On a failure, they take a –1 status penalty to attack rolls and skill checks for 1 round (1 minute on a critical failure)."
          }
        ]
      },
      {
        "type": "paragraph",
