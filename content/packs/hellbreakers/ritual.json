      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The emanation protected by the keystone increases by 20 feet."
          }
        ]
      }
