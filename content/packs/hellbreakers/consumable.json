    "slug": "consumable:smugglers-padlock",
    "name": "Smuggler's Padlock",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["consumable", "extradimensional", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "hellbreakers",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4176"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 minute (manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This padlock exists in a dormant state while it's closed and its associated key is in the keyhole. To activate this item, you remove the key, which causes the keyhole to become a portal to an extradimensional space. This space can hold a single object of up to 1 Bulk by pressing it against the keyhole. At any point within the next 24 hours, the key can be used to open the lock with an Interact action, which safely releases the item onto the ground in your space."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If the lock isn't opened within the next 24 hours, the key disintegrates, and from then on, a creature who succeeds at a "
          },
          {
            "type": "check",
            "statistic": "skill:thievery",
            "dc": 16
          },
          {
            "type": "text",
            "text": " check can Pick the Lock open to release the item. On a critical failure, the padlock is destroyed and its contents are lost forever"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.4jjhUwHiEY2v8afe"
    },
