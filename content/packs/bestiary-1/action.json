          },
          {
            "type": "text",
            "text": " damage to all creatures in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": " ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 25,
            "basic": true
          },
          {
            "type": "text",
            "text": " save)."
          }
        ]
      },
      {
