    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The barghest breathes a cloud of toxic gas that deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "8d6",
                "damageType": "poison"
              }
