    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A vrykolakas master can transform into a form resembling the body it had in life, with the effects of humanoid form but with unlimited duration. It loses its fangs and claw Strikes but gains a +2 circumstance bonus to Deception checks to "
          },
          {
            "type": "ref",
            "id": "9d26c6da-04e9-5491-86c1-7a4b23fe9da3"
          },
          {
            "type": "text",
            "text": " in this form."
          }
        ]
      }
    ],
    "rules": [
