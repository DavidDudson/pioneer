    }
  },
  {
    "id": "296d03c3-cb4c-5084-9010-43c75b9cc660",
    "pack": "bestiary-2",
    "kind": "action",
    "slug": "action:vampire-vrykolakas-master-children-of-the-night",
    "name": "(Vampire, Vrykolakas Master) Children of the Night",
    "rarity": "common",
    "traits": ["divine", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "bestiary-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The presence of a vrykolakas master inspires savage creatures to crawl forth to do its bidding, including Rat Swarms, Wargs, Werewolves, and similar creatures."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The vrykolakas master can give telepathic orders to these creatures within 100 feet, but they can't communicate back."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.tKixfds07IRH2nnh"
    },
    "data": {
      "category": "interaction"
    }
  },
  {
    "id": "a2e03975-4d97-57ca-9cfb-2f50997ece74",
    "pack": "bestiary-2",
    "kind": "action",
    "slug": "action:vampire-vrykolakas-master-create-spawn",
    "name": "(Vampire, Vrykolakas Master) Create Spawn",
    "rarity": "common",
    "traits": ["divine", "downtime"],
    "sources": [
      {
        "kind": "book",
        "book": "bestiary-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If a creature dies after being reduced to 0 HP by Drink Blood, a vrykolakas master can turn this creature into a Vrykolakas Spawn by donating some of its own blood to the creature and burying it in earth for 3 nights."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Such vrykolakas spawn are generally friendly to the vrykolakas that created them, but they are not under its control and typically wander off on their own rampage within 1d6 days of their creation."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.QuHeuVNDnmOCS9M1"
    },
    "data": {
      "category": "offensive"
    }
  },
  {
    "id": "b9f894f4-97a6-5909-834c-a8fd1879b29f",
    "pack": "bestiary-2",
    "kind": "action",
    "slug": "action:vampire-vrykolakas-master-dominate-animal",
    "name": "(Vampire, Vrykolakas Master) Dominate Animal",
    "rarity": "common",
    "traits": ["divine", "incapacitation", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "bestiary-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The vrykolakas can cast "
          },
          {
            "type": "ref",
            "id": "54bcf730-ab6d-5ba7-9747-86a6debbd00c"
          },
          {
            "type": "text",
            "text": " at will as a divine innate spell that affects only animals. The save DC is a high DC for the vrykolakas's level, and a creature that succeeds is immune to that vrykolakas's Dominate Animal for 24 hours. Destroying the vrykolakas ends the effect, but reducing it to 0 HP does not."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A dominated animal takes a -4 circumstance penalty to saving throws against the vrykolakas's Feral Possession."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.zwgUxJBNFqWOuaBX"
    },
    "data": {
      "cost": "one",
      "category": "offensive"
    }
  },
