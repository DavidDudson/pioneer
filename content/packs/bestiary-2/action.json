        "option": "option:change-shape",
        "toggleable": true,
        "display": {
          "label": "Impersonating the Body It Had in Life"
        }
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:deception"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["option:change-shape", "action:impersonate"]
      }
    ],
