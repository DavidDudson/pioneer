  {
    "id": "5e4ee94f-81b8-5e7c-a86c-fa675bed640c",
    "pack": "bestiary-2",
    "kind": "action",
    "slug": "action:ravener-discorporate",
    "name": "(Ravener) Discorporate",
    "rarity": "common",
    "traits": ["divine"],
    "sources": [
      {
        "kind": "book",
        "book": "bestiary-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ravener takes excess damage to their soul ward but still has at least 51 Hit Points in their soul ward"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ravener draws deeply into their soul ward, discorporating their body into soul energy in order to escape. They take 50 damage to their soul ward and their physical body vanishes, reappearing 1d4 hours later in a random location within 1 mile from the location where they used Discorporate."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.HLPLYJ9bOazb2ZPX"
    },
