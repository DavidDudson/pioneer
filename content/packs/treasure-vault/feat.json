        "book": "treasure-vault"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The gelid shard within your heart may sap your ability to feel and experience emotion, but it also lets you create and manipulate cold. You learn to cast arcane spontaneous spells, and you gain a spell repertoire with the "
          },
          {
            "type": "ref",
            "id": "4564025d-51b0-541a-a554-662ea3883cda"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "faa17958-536a-5762-8bda-7ef4aed15800"
          },
          {
            "type": "text",
            "text": " cantrips. You're trained in spell attack modifier and spell DC. Your key spellcasting attribute is Charisma."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "spellcasting",
        "rank": "trained"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.j2XKVhDuhdcI15kD"
    },
    "data": {
      "category": "class"
    }
  },
