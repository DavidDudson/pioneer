[
  {
    "id": "73684561-9bf0-5b7f-bbda-9254e75119fb",
    "pack": "dark-archive-remastered",
    "kind": "background",
    "slug": "background:empty-whispers",
    "name": "Empty Whispers",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "dark-archive-remastered"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You knew someone once, and now you know only a life stitched together and healed over, nary even a scar remaining. You hear voices of souls that have fallen through the cracks of reality, creatures who have been removed from memory, banished planar entities, and similar. Their whispers guide you."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Intelligence",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Wisdom",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Occultism skill and the Planar Rift Lore skill. You get a Planar Rift Lore check to sense planar rifts, even if you aren't specifically Investigating or Searching for them, as well as locations where magic has been used to remove the memory of an object or creature from existence."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:occultism",
        "rank": "trained"
      },
      {
        "key": "Proficiency",
        "selector": "skill:lore:planar-rift",
        "rank": "trained"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.backgrounds.Item.g8xUX7DAu2ShZ90Q"
    },
    "data": {
      "boosts": [
        ["int", "wis"],
        ["cha", "con", "dex", "int", "str", "wis"]
      ]
    }
  },
  {
    "id": "79c1d4c9-25c6-5e8f-a55f-73df8d0af809",
    "pack": "dark-archive-remastered",
    "kind": "background",
    "slug": "background:legacy-of-the-hammer",
    "name": "Legacy of the Hammer",
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "dark-archive-remastered"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your introduction to the criminal life was spurred forward by a seemingly innocuous hammer that provided you with all kinds of innovative criminal ideas. It has since left your possession, but every now and then you hear a faint whisper urging you toward crime."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Charisma",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Thievery skill and Engineering Lore. You gain the "
          },
          {
            "type": "ref",
            "id": "bfabdbad-248e-57aa-81b6-6a8eb3839e03"
          },
          {
            "type": "text",
            "text": " skill feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Proficiency",
        "selector": "skill:thievery",
        "rank": "trained"
      },
      {
        "key": "Proficiency",
        "selector": "skill:lore:engineering",
        "rank": "trained"
      },
      {
        "key": "GrantItem",
        "item": "bfabdbad-248e-57aa-81b6-6a8eb3839e03"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.backgrounds.Item.qzKT7L1qldz14q8M"
    },
    "data": {
      "boosts": [
        ["cha", "dex"],
        ["cha", "con", "dex", "int", "str", "wis"]
      ]
    }
  },
  {
    "id": "c720f59d-097d-58b5-bfad-2ad9d1c3a662",
    "pack": "dark-archive-remastered",
    "kind": "background",
    "slug": "background:reborn-soul",
    "name": "Reborn Soul",
    "rarity": "rare",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "dark-archive-remastered"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You were given a second opportunity at life by mysterious forces in the Lands of Second Souls. You remember your life before your death and now live with an extra lifetime of knowledge."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose two attribute boosts. One must be to "
          },
          {
            "type": "text",
            "text": "Constitution",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Intelligence",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You become trained in two Lore skills, which you and your GM choose from Lore skills associated with your past life. At 3rd level, 7th level, and 15th level, you receive skill increases, which you can apply only to these Lore skills. In certain situations analogous to your past life, fragments of memories resurface, potentially helping or distracting you. The GM can offer you a +1 circumstance bonus on skill checks with either of these Lore skills or on other skill checks that echo your past life. If you accept but fail the check, you're "
          },
          {
            "type": "ref",
            "id": "9e1dad43-36fe-5629-923f-2df63c12d90f",
            "label": "Stupefied 1"
          },
          {
            "type": "text",
            "text": " for 1 minute by the mental distraction of your past-life memories, or "
          },
          {
            "type": "ref",
            "id": "9e1dad43-36fe-5629-923f-2df63c12d90f",
            "label": "Stupefied 2"
          },
          {
            "type": "text",
            "text": " for 1 minute on a critical failure."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.backgrounds.Item.HrWEyXTgIj16Z1RR"
    },
    "data": {
      "boosts": [
        ["con", "int"],
        ["cha", "con", "dex", "int", "str", "wis"]
      ]
    }
  }
]
