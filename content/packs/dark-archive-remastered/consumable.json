      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "214a6fb6-6518-55e5-8a92-cfd28fda3d7c",
    "pack": "dark-archive-remastered",
    "kind": "consumable",
    "slug": "consumable:parchment-of-secrets",
    "name": "Parchment of Secrets",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["consumable", "illusion", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "dark-archive-remastered",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4124"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Access",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Member of a secret society"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This parchment is crafted with illusion magic, allowing for the transfer of secret messages. You can fill the parchment with the usual amount of text, encoding your secret message within the innocuous message."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Hide Message",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 minute (manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You tap the letters of your secret message one at a time, causing the letters to glow momentarily before fading to their standard ink color, and a symbol of your choice appears at the corner of the page. The next time someone taps the symbol with a writing instrument, the chosen letters glow again, revealing the secret message, and then the power of the parchment is spent."
          }
        ]
      }
    ],
