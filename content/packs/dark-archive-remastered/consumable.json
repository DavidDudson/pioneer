          "gp": 22
        }
      },
      "bulk": "negligible",
      "category": "ammunition",
      "ammunition": ["arrows", "bolts"]
    }
  },
  {
    "id": "6024cea4-b6ca-551c-8048-3c330590b05d",
    "pack": "dark-archive-remastered",
    "kind": "consumable",
    "slug": "consumable:self-immolating-note",
    "name": "Self-Immolating Note",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["alchemical", "consumable", "fire"],
    "sources": [
      {
        "kind": "book",
        "book": "dark-archive-remastered",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4125"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Access",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Member of a secret society"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This paper is crafted with an unusual formula, causing it to catch fire and self-immolate 5 minutes after being exposed to the air. The item activates automatically when the envelope is opened, which typically takes an Interact action. Anyone holding the note when it catches fire takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1",
                "damageType": "fire"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage. Often, these notes are given as practical jokes or threats, but secret societies find them quite useful when sharing information about upcoming meetings or any other relevant news. These letters must be written in haste and require the use of their accompanying envelopes, which prevent air from interacting with the paper until the envelope's seal is broken."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.g91dodJKrkQ2gCA6"
    },
