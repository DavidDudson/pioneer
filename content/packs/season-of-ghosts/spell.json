            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": " until the end of its turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is sickened 1. In addition, it becomes "
          },
