            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Increase the Hit Points restored to 1d8 and "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
