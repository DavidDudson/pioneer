  {
    "id": "d6150a19-00da-5d19-843c-566c7f14c6d3",
    "pack": "season-of-ghosts",
    "kind": "spell",
    "slug": "spell:fated-healing",
    "name": "Fated Healing",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["concentrate", "linguistic", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts",
        "page": 287,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2539"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You speak about the consequences of actions people take against each other and how it's possible to break cycles of violence simply by making a different choice. The targets regain 1d4 Hit Points at the end of each of their own turns while the spell is in effect. If a target uses a hostile action against the other target, the spell ends for the target that used the hostile action."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The targets regain an additional 1d4 Hit Points at the end of their own turns."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.X3RUan7TVqo6UpUG"
