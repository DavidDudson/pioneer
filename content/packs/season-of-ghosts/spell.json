  {
    "id": "9c7428fa-588f-5dc8-822b-202eed6952ac",
    "pack": "season-of-ghosts",
    "kind": "spell",
    "slug": "spell:lifes-flowing-river",
    "name": "Life's Flowing River",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts",
        "page": 287,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2540"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You create a flowing river of ghostly water and that sheds dim light for 10 feet on each side. The river begins in an adjacent square to you and extends in a straight 5-foot path to its maximum range or until it hits a solid barrier, whichever comes first. A creature that begins its turn in the glowing waters of the river or who enters one of the river's spaces must attempt a Will save. If the creature is undead or a nindoru, it takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d6",
                "damageType": "mental"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage, modified by the result of their Will save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature ignores the river's effects until the start of its next turn. If the creature is undead or a nindoru, it takes no damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature treats all squares occupied by the river as difficult terrain until the start of its next turn. If the creature is undead or a nindoru, it takes half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, but the creature is also knocked "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": ". If the creature is undead or a nindoru, it takes full damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the creature is pushed 20 feet along the river's path in the direction of flow. If the creature is undead or a nindoru, it takes double mental damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The mental damage increases by 1d6."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.CgekONDD5jIxL8oM"
