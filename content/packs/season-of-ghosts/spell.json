[
  {
    "id": "69021b14-c5c5-5b1f-bf7d-70e48b6faa0f",
    "pack": "season-of-ghosts",
    "kind": "spell",
    "slug": "spell:cycle-of-retribution",
    "name": "Cycle of Retribution",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts",
        "page": 287,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2537"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An understanding of how violence begets more violence fills your target, causing it mental anguish in the form of splitting headaches when it attempts to take violent actions. The target must attempt a Will saving throw, with the following results."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The next time the target takes a hostile action, the target takes 1d4 mental damage; the spell's duration then ends."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The first time in a round when the target takes a hostile action, the target takes 1d4 mental damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Each time the target takes a hostile action, the target takes 1d4 mental damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The mental damage increases by 1d4."
          }
        ]
      }
    ],
