  {
    "id": "e28dc240-2e8e-549b-94ed-2f48728cfabd",
    "pack": "season-of-ghosts",
    "kind": "spell",
    "slug": "spell:fateful-condemnation",
    "name": "Fateful Condemnation",
    "level": 6,
    "rarity": "uncommon",
    "traits": ["aura", "concentrate", "incapacitation", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts",
        "page": 287,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2538"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You draw upon the target's negative fate, causing this lingering destiny to afflict it and its nearby allies with the unintended consequences of its past lives. Spiritual echoes of the target's past lives instill overwhelming feelings of doubt, regret, and despair into the minds of the target and its nearby allies. The effects depend on the target's Will save, with the following results."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature takes 4d6 mental damage, and then an aura of shimmering mist with a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 10
          },
          {
            "type": "text",
            "text": " surrounds the creature. This mist isn't dense enough to affect sight, but it does cause the creature and any of its allies in the aura to take a –1 status penalty to all skill checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, but the creature takes an initial 8d6 mental damage and is then "
          },
          {
            "type": "ref",
            "id": "13584c6a-a624-511c-a5de-0c36a9136b9e",
            "label": "Slowed 1"
          },
          {
            "type": "text",
            "text": " for the duration of the effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As success, but the creature takes an initial 16d6 mental damage, then is slowed 1 for the duration of the effect. Any of the target's allies who begin their turn in the "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 10
          },
          {
            "type": "text",
            "text": " is slowed 1 for 1 round."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.ReUoodsqUYSTwSgE"
    },
