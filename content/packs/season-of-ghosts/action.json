[
  {
    "id": "87978b08-889b-55d3-bccf-c1fe98c5fbaf",
    "pack": "season-of-ghosts",
    "kind": "action",
    "slug": "action:elemental-attack",
    "name": "Elemental Attack",
    "rarity": "common",
    "traits": ["magical"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose from air, earth, fire, metal, water, or wood (this choice can't be changed once you select it for the impersonator). The noppera-bo impersonator targets a creature within 60 feet and creates a detonation of that element; that creature takes 4d6[@item.flags.system.rulesSelections.elementalAttack.damage] (slashing (air), bludgeoning (earth, water, or wood), piercing (metal), or fire (fire)) damage ("
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 24,
            "basic": true
          },
          {
            "type": "text",
            "text": " save). Elemental Attack gains the appropriate elemental trait."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.adventure-specific-actions.Item.6U04OKtvRURExkli"
    },
    "data": {
      "cost": "two",
      "category": "offensive"
    }
  },
  {
    "id": "a7073345-9142-5dd8-879b-811baeca6eea",
    "pack": "season-of-ghosts",
    "kind": "action",
    "slug": "action:invoke-shrine-blessing",
    "name": "Invoke Shrine Blessing",
    "rarity": "common",
    "traits": ["concentrate", "exploration", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You are holding an unblessed copper coin and are adjacent to one of Willowshore's shrines."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You offer prayers to a shrine and implore its associated deity to bless a copper coin. Place the copper coin before the shrine, then spend 10 minutes in prayer before the shrine. Attempt a "
          },
          {
            "type": "check",
            "statistic": "skill:religion",
            "dc": 15
          },
          {
            "type": "text",
            "text": " or deity Lore check or a DC 17 skill check associated with the deity's teachings—two alternate skills are available for each shrine, as detailed in the Willowshore's Shrines. If you worship the deity in question, increase the result of your check by one degree of success."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The deity blesses the copper coin but also imbues you with additional divine energy and insight. You heal "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d8+8"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points and can cast "
          },
          {
            "type": "ref",
            "id": "71a6396c-7cc2-5918-a06b-bf3cf1b533f6"
          },
          {
            "type": "text",
            "text": " once in the next 24 hours as a divine spell. You treat all further critical successes at Invoking Shrine Blessing as regular successes instead."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The deity blesses the copper coin."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You fail, and can't attempt to invoke a blessing at this specific shrine again for 24 hours."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You anger the deity. The copper coin vanishes, you can't attempt to invoke a blessing at this shrine again for 1 week, and you become "
          },
          {
            "type": "ref",
            "id": "9e1dad43-36fe-5629-923f-2df63c12d90f",
            "label": "Stupefied 1"
          },
          {
            "type": "text",
            "text": " for 1 hour."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.adventure-specific-actions.Item.Su0ZQXpm2D60kWa0"
    },
    "data": {
      "category": "interaction",
      "requirementsText": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You are holding an unblessed copper coin and are adjacent to one of Willowshore's shrines."
            }
          ]
        }
      ]
    }
  },
  {
    "id": "3925c839-f7d4-5397-bfaa-521ed5475e1c",
    "pack": "season-of-ghosts",
    "kind": "action",
    "slug": "action:path-maiden-apostates-shroud",
    "name": "(Path Maiden) Apostate's Shroud",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "season-of-ghosts",
        "page": 343,
        "aon": "https://2e.aonprd.com/Monsters.aspx?ID=4641"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "All path maidens have an apostate's shroud unarmed attack that deals mental damage. This attack, which manifests as a whipping lash from the path maiden's sleeves or hem, has the agile, finesse, and magical traits. A creature damaged by this attack must succeed at a Fortitude save against the path maiden's spell DC. On a failure, the creature becomes cursed for 1 hour; if the creature dies while cursed, it immediately rises from death as a ghost. If the creature is a lower level than the path maiden that cursed it, it treats that path maiden as an ally and loyally obeys her; otherwise, it manifests as a free-willed ghost. In either case, it becomes site bound to the site of their death."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.SPNfbhNa46L3V2NQ"
    },
    "data": {
      "category": "offensive"
    }
  },
  {
