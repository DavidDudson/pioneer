    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This elegant full plate is embossed with heraldic imagery and never tarnishes or loses its shine. "
          },
          {
            "type": "text",
            "text": "Glorious plate",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is "
          },
          {
            "type": "text",
            "text": "+2 resilient full plate",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In battle, "
          },
          {
            "type": "text",
            "text": "glorious plate",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " sheds bright light in a 10-foot radius, which enemies see as a blinding halo that obscures creatures other than the wearer. When an enemy looks at the wearer, it must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 33
          },
          {
            "type": "text",
            "text": " saving throw. The enemy is then temporarily immune for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The enemy is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " For 1 minute, the wearer's allies within the glorious plate's 10-foot radius of light are "
          },
          {
            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1"
          },
          {
            "type": "text",
            "text": " to the enemy. Allies are concealed only while they remain within the light; if allies enter the light later, they are concealed as well."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, except the wearer's allies are "
          },
          {
            "type": "ref",
            "id": "d851e3ca-be0d-55a7-a4d1-d7ed8b7ecafa"
          },
          {
            "type": "text",
            "text": " to the enemy instead of concealed."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
