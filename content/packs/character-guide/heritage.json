  {
    "id": "fad2ebf7-e121-50bc-bb66-8865bde65944",
    "pack": "character-guide",
    "kind": "heritage",
    "slug": "heritage:tailed-goblin",
    "name": "Tailed Goblin",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "character-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=37",
        "page": 37
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have a powerful tail, likely because you descend from a community of monkey goblins. You gain a +2 circumstance bonus to Athletics checks to "
          },
          {
            "type": "ref",
            "id": "d26ec2df-83bd-5f2f-988e-e922681de6ba"
          },
          {
            "type": "text",
            "text": ", you gain "
          },
          {
            "type": "ref",
            "id": "8d47d4b9-3de6-5aca-9993-35356f13d1f6"
          },
          {
            "type": "text",
            "text": " as a bonus feat, and you reduce the number of free hands required to climb or "
          },
          {
            "type": "ref",
            "id": "6257c7f0-f483-53d3-a791-d73a616cbce4"
          },
          {
            "type": "text",
            "text": " by one."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:athletics"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["action:climb"],
        "display": {
          "label": "Tailed Goblin (Climb)"
        }
      },
      {
        "key": "GrantItem",
        "item": "8d47d4b9-3de6-5aca-9993-35356f13d1f6"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.8wGUh9RsMUamOKjh"
    },
    "data": {
      "ancestry": "054f4768-e40c-50b9-bf71-cebc5bd9064e"
    }
  },
  {
    "id": "84b98fa4-9134-5d8c-9630-b46b695d371f",
    "pack": "character-guide",
    "kind": "heritage",
    "slug": "heritage:treedweller-goblin",
    "name": "Treedweller Goblin",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "character-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=38",
        "page": 37
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have adapted particularly well to living in forested environments. As long as you are in a forest or jungle, you gain a +2 circumstance bonus to Stealth checks to "
          },
          {
            "type": "ref",
            "id": "5a86b7d0-fc0e-52a6-9b0d-fb58ed15233d"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "7e4e48de-b626-5513-9518-73261c58b5f4"
          },
          {
            "type": "text",
            "text": ", Survival checks to "
          },
          {
            "type": "ref",
            "id": "897dec4f-1321-59a1-bb19-085290e409f0"
          },
          {
            "type": "text",
            "text": ", and your Survival DC to "
          },
          {
            "type": "ref",
            "id": "1c678b1d-a165-51e0-b936-1769b16a5955"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["action:subsist"],
        "display": {
          "label": "Treedweller Goblin (Subsist)"
        }
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:stealth"],
        "type": "circumstance",
        "value": 2,
        "predicate": [
          {
            "or": ["action:hide", "action:sneak"]
          }
        ],
        "display": {
          "label": "Treedweller Goblin (Hide or Sneak)"
        }
      }
    ],
