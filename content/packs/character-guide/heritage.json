  {
    "id": "f7190e19-41be-5544-bd95-d6435a34e4c1",
    "pack": "character-guide",
    "kind": "heritage",
    "slug": "heritage:vivacious-gnome",
    "name": "Vivacious Gnome",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "character-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=36",
        "page": 31
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have an incredibly strong connection to the vitality energy that flows through the First World, making it harder to attack your life force with void energy. You gain void resistance equal to half your level (minimum 1). When you have the "
          },
          {
            "type": "ref",
            "id": "cd164d22-2d8e-5fd2-b8b2-03e1360df1e7"
          },
          {
            "type": "text",
            "text": " condition, the condition affects you as if its value was 1 lower than it actually is (doomed 1 has no effect, doomed 2 causes you to die at "
          },
          {
            "type": "ref",
            "id": "c0cd649a-7029-5174-a5b4-678f51598dec",
            "label": "Dying 3"
          },
          {
            "type": "text",
            "text": ", and so on)."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Resistance",
        "type": ["void"],
        "value": "max(1, floor(@level / 2))"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.ViKRoVgog172r163"
    },
    "data": {
      "ancestry": "be1b027a-40cb-5267-ac66-7cdc1c0d7813"
    }
  },
  {
    "id": "dbabe8fe-ac32-5387-9b6b-1c303b7811b9",
    "pack": "character-guide",
    "kind": "heritage",
    "slug": "heritage:wintertouched-human",
    "name": "Wintertouched Human",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "character-guide",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=30",
        "page": 11
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The power of winter flows through you. This heritage is most common among the Jadwiga of Irrisen, due to their descent from Baba Yaga, and certain Erutaki touched by the spirits. You gain cold resistance equal to half your level (minimum 1), and you treat environmental cold effects as if they were one step less extreme (incredible cold becomes extreme, extreme cold becomes severe, and so on)."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Resistance",
        "type": ["cold"],
        "value": "max(1, floor(@level / 2))"
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.KO33MNyY9VqNQmbZ"
    },
    "data": {
      "ancestry": "58312ecf-5705-5e7d-b695-248d34618288"
    }
  }
]
