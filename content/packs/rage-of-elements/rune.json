[
  {
    "id": "bbd9397f-9860-5924-86a4-0b82e1e9ff91",
    "pack": "rage-of-elements",
    "kind": "rune",
    "slug": "rune:malleable",
    "name": "Malleable",
    "level": 9,
    "rarity": "common",
    "traits": ["magical", "metal"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=2614",
        "page": 146
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The metal of your armor can shift and rearrange at a moment's notice, allowing you to manipulate what kind of damage it resists."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Reconfigure Armor",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The armor's composition shifts, changing its specialization group to a different one of your choice. This doesn't change what the armor is made of, and any runes or precious material it's made of apply to the new composition. Any property runes that can't apply to the new form are suppressed until the item takes a composition to which they can apply."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.eHfL8Apfx4fxGksT"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 650
        }
      },
      "bulk": "negligible",
      "type": "property",
      "etchedOnto": {
        "item": "armor",
        "restriction": "medium-or-heavy-metal"
      }
    }
  },
  {
    "id": "96e550e0-bd6f-523c-aa2a-18cb57e8daf7",
    "pack": "rage-of-elements",
    "kind": "rune",
    "slug": "rune:rooting",
    "name": "Rooting",
    "level": 7,
    "rarity": "common",
    "traits": ["magical", "plant", "wood"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=2644",
        "page": 202
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Small roots grow along the surface of the weapon, clinging tightly to its contours. On a critical hit with the weapon, roots grow from the target. It's "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": " for 1 round (Escape) and "
          },
          {
            "type": "ref",
            "id": "69f88e3c-d871-5fb9-82c6-120348a7c0e8",
            "label": "Clumsy 1"
          },
          {
            "type": "text",
            "text": " for as long as the immobilization lasts."
          }
        ]
      }
    ],
    "rules": [],
