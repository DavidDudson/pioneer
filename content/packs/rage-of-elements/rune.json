    "kind": "rune",
    "slug": "rune:underwater",
    "name": "Underwater",
    "level": 3,
    "rarity": "common",
    "traits": ["magical", "water"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=2634",
        "page": 178
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This weapon works as well in water as it does on land. Attacks with the weapon don't take the normal penalties and restrictions for being used in water or underwater. If the weapon is capable of dealing fire damage, its fire functions underwater as well."
          }
        ]
      }
    ],
