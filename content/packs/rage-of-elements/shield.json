[
  {
    "id": "a948bd85-b584-50dd-9e1c-03f9f7052127",
    "pack": "rage-of-elements",
    "kind": "shield",
    "slug": "shield:broadleaf-shield",
    "name": "Broadleaf Shield",
    "level": 6,
    "rarity": "common",
    "traits": ["magical", "plant", "wood"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Though it resembles an enormous leaf freshly plucked from a tree, a "
          },
          {
            "type": "text",
            "text": "broadleaf shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is extremely durable. It also regrows rapidly, fully repairing itself when broken if it's left in sunlight for 10 consecutive minutes."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "At each dawn, the leaf transforms to an appearance appropriate for the season. While you're wielding the shield, you gain resistance 3 to a damage type depending on the shield's color. This resistance doubles while you have the shield raised."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Pink",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " (void resistance) In spring, the leaf is a delicate blossom-like pink and exudes the energy of life."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Green",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " (fire resistance) In summer, the leaf is a deep, rich green with a waxy coating."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Orange",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " (poison resistance) In autumn, the leaf turns orange, red, or yellow and dehydrates slightly."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Brown",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " (cold resistance) In winter, the leaf turns dead, dry, and brown."
                }
              ]
            }
          ]
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate - Change Season",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shield transforms as though living through seasons in a moment, becoming the color of your choice for 5 minutes."
          }
        ]
      }
    ],
