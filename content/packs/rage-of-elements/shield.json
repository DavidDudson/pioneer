      "price": {
        "coins": {
          "gp": 1250
        }
      },
      "bulk": "light",
      "hardness": 5,
      "hitPoints": 20,
      "material": {
        "type": "duskwood",
        "grade": "standard"
      },
      "baseItem": "wooden-shield",
      "acBonus": 2
    }
  },
