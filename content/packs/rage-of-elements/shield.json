  {
    "id": "2b4043a6-20ac-5db8-95ee-2e6a14d148af",
    "pack": "rage-of-elements",
    "kind": "shield",
    "slug": "shield:kizidhars-shield",
    "name": "Kizidhar's Shield",
    "level": 11,
    "rarity": "common",
    "traits": ["magical", "wood"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "standard-grade duskwood shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is perfectly symmetrical and incredibly sturdy despite its elaborate construction. These shields are typically given to the chosen emissaries of a kizidhar shuyookh, and the shuyookh's name and title are engraved in Muan behind the shield's handle."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate - Repair",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You command the shield to repair itself, awakening the restorative magic within. For the next minute, the shield heals 3 Hit Points each round at the start of your turn."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate - Secure Site",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 10 minutes (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You place the "
          },
          {
            "type": "text",
            "text": "kizidhar's shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " into the ground at the edge of your campsite, which can't be more than 30 feet on a side, then speak the name of the kizidhar shuyookh carved into its handle. The shuyookh briefly appears just long enough to make a sweeping gesture, causing sprawling thorns to grow in an unnaturally symmetrical formation around the campsite, protecting it for the next 8 hours with an effect that's otherwise identical to "
          },
          {
            "type": "ref",
            "id": "9dfded9c-826b-57e9-989b-6b4ea568d4b8"
          },
          {
            "type": "text",
            "text": ". All creatures within the campsite are then immediately affected by a three-action "
          },
          {
            "type": "ref",
            "id": "949e0a89-f44b-598d-8adb-3d9d31db900e"
          },
          {
            "type": "text",
            "text": " spell cast at 4th rank by the shield. After 8 hours, the wall rots away, and the shield can be retrieved as an Interact action."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.jiC2ufyGZmmxiEAm"
    },
