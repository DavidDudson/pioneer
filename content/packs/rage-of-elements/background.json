            "type": "ref",
            "id": "7e42ccc3-1342-59f0-b827-0279e78a7260"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "1efba07c-26bc-52f1-9e6f-f17ef0bb61e5"
          },
          {
            "type": "text",
