  {
    "id": "a9b32b09-c80b-5035-a0af-10f66e3175e3",
    "pack": "rage-of-elements",
    "kind": "armor",
    "slug": "armor:wisp-chain",
    "name": "Wisp Chain",
    "level": 9,
    "rarity": "common",
    "traits": ["air", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 resilient chain shirt",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is made of small, interlocking currents of wind carefully woven together. While the links of air don't jingle against each other like chain links might, the tiny cyclones nevertheless create a blustering howl akin to standing at the center of a storm. A creature that ends its turn adjacent to you must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 23,
            "options": ["inflicts:deafened"]
          },
          {
            "type": "text",
            "text": " save. On a failure, it becomes "
          },
          {
            "type": "ref",
            "id": "4271da2e-7225-5aa7-9807-c499d8af6a5a"
          },
          {
            "type": "text",
            "text": " until it moves away from you."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Slicing Links",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You unbind the currents that form your armor and release them as cutting whorls of air that slice into creatures in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 60
          },
          {
            "type": "text",
            "text": ". Creatures in the area take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d6",
                "damageType": "slashing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 25,
            "basic": true
          },
          {
            "type": "text",
            "text": " save. A creature that fails its save is also pushed 10 feet (or 20 feet on a critical failure). You lose the AC bonus of your armor until the end of your turn, when the air currents reform the wisp chain around you."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.bosOCvsQb8tG8fuD"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 685
        }
      },
      "bulk": "negligible",
      "activations": [
        {
          "slug": "slicing-links",
          "name": "Slicing Links",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "category": "light",
      "group": "chain",
      "baseItem": "chain-shirt",
      "acBonus": 2,
      "dexCap": 3,
      "checkPenalty": 1,
      "strength": 1,
      "runes": {
        "potency": 1,
        "resilient": 1,
        "property": []
      }
    }
