[
  {
    "id": "850b9a45-076e-5ac4-b647-fcfec5a9b24e",
    "pack": "rage-of-elements",
    "kind": "armor",
    "slug": "armor:tales-in-timber",
    "name": "Tales in Timber",
    "level": 10,
    "rarity": "common",
    "traits": ["invested", "magical", "wood"],
    "sources": [
      {
        "kind": "book",
        "book": "rage-of-elements"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dozens of pictorial stories—told in wood carvings, painting, or pyrography—adorn every outer surface of this "
          },
          {
            "type": "text",
            "text": "+1 resilient wooden breastplate",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". All are old, and many truly ancient, depicting tales set eons ago on the Plane of Wood. You gain a +2 item bonus to Nature checks to Recall Knowledge. If you know the "
          },
          {
            "type": "ref",
            "id": "39a76fbf-320c-5beb-9457-d1766960ab18"
          },
          {
            "type": "text",
            "text": " ritual, you can use Nature instead of Occultism if you're the primary caster."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Statue Disguise",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The armor makes you look like a wooden statue version of one of the creatures depicted on the armor for 1 hour. This is a 3rd-rank "
          },
          {
            "type": "ref",
            "id": "adcc4c8f-05ae-5440-83d0-9e88ad22209b"
          },
          {
            "type": "text",
            "text": ", but it can make you look like any creature depicted on the armor. This doesn't change your size or the capabilities of your body, and it scales the appearance of the creature to match yours. You can Dismiss the activation. This disguise is just real enough to make you somewhat closer to a creature of wood. You're affected by two spells while it lasts: "
          },
          {
            "type": "ref",
            "id": "d649aded-ca36-5663-ba2c-edc97e35bd6c"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "29397615-a073-572b-a506-4a6b88f6529d"
          },
          {
            "type": "text",
            "text": ". If you stand still, you gain a +2 item bonus to Deception checks and DCs to appear as an inanimate wooden statue, in addition to the status bonus to Deception from "
          },
          {
            "type": "text",
            "text": "illusory disguise",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:nature"],
        "type": "item",
        "value": 2,
        "predicate": ["action:recall-knowledge"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.gg6XF2dWafE0pcHu"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 1000
        }
      },
      "bulk": "negligible",
      "activations": [
        {
          "slug": "statue-disguise",
          "name": "Statue Disguise",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "category": "medium",
      "group": "wood",
      "baseItem": "wooden-breastplate",
      "acBonus": 3,
      "dexCap": 2,
      "checkPenalty": 2,
      "speedPenalty": 5,
      "strength": 2,
      "runes": {
        "potency": 1,
        "resilient": 1,
        "property": []
      }
    }
  },
