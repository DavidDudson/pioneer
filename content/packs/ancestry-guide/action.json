  {
    "id": "2720db6e-c857-528e-b504-2c13497f1a1e",
    "pack": "ancestry-guide",
    "kind": "action",
    "slug": "action:mist-blending",
    "name": "Mist Blending",
    "rarity": "common",
    "traits": ["undine"],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature attempts a flat check to target you because you're "
          },
          {
            "type": "ref",
            "id": "f410da96-b56a-5c7c-857b-7096defec0a1"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "d851e3ca-be0d-55a7-a4d1-d7ed8b7ecafa"
          },
          {
            "type": "text",
            "text": " due to fog, haze, mist, or smoke"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You shroud yourself in mist, making it harder for your foe to hit you. If you're concealed, the DC of the flat check increases from 5 to "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 7
          },
          {
            "type": "text",
            "text": "; if you're hidden, it increases from 11 to "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 13
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.I9k9qe4gOT8UVK4e"
    },
    "data": {
      "cost": "reaction",
      "category": "defensive",
      "trigger": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A creature attempts a flat check to target you because you're Concealed or Hidden due to fog, haze, mist, or smoke"
            }
          ]
        }
      ]
    }
  },
