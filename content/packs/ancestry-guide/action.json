          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature that has blood and is not at its maximum Hit Points hits you with a melee Strike"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You channel salt and brine from your blood into the creature's wounds. The creature must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-or-spell-dc"
            }
          },
          {
            "type": "text",
            "text": " using your class DC or spell DC, whichever is higher. On a failure, the creature takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "damageType": "acid",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": " by the pain. On a critical failure, it instead takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "damageType": "acid",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
