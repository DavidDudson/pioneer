  {
    "id": "7a692a56-1428-572e-a927-2115608a2f8c",
    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:tactile-azarketi",
    "name": "Tactile Azarketi",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your skin can detect the slightest changes in ocean currents. You gain imprecise wavesense with a range of 30 feet, allowing you to sense motion in the water around you. You also gain a +1 circumstance bonus to Survival checks to Sense Direction in aquatic environments."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "circumstance",
