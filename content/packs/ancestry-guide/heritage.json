    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:technological-fleshwarp",
    "name": "Technological Fleshwarp",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your transformation is due to manipulation by advanced technology, like that found in Numeria. Your emotions are dulled and hard to influence. When you roll a success on a saving throw against an emotion effect, you get a critical success instead."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "AdjustDegreeOfSuccess",
        "selectors": ["saving-throw"],
        "adjustment": {
          "success": "to-critical-success"
