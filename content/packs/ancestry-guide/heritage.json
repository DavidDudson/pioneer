    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You are a dedicated nocturnal avian, keeping watch and predating in the most lightless environments. You gain darkvision."
          }
        ]
      }
    ],
    "rules": [
