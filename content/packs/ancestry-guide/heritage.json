    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your body was augmented with processes and an appearance intended to blend in with humans more easily."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You become trained in Deception (or another skill if you're already trained in Deception). You don't require a disguise kit when attempting Deception checks to "
          },
          {
            "type": "ref",
            "id": "9d26c6da-04e9-5491-86c1-7a4b23fe9da3"
          },
          {
            "type": "text",
            "text": " a human."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In addition, you gain a +4 circumstance bonus to Impersonate checks to pretend that you're a human version of yourself, rather than an android. This bonus doesn't apply to other checks to Impersonate humans."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:deception"],
        "type": "circumstance",
        "value": 4,
        "predicate": ["action:impersonate", "disguise:human-self"],
        "display": {
          "label": "Impersonator Android (to Impersonate a human version of yourself)"
        }
      },
      {
        "key": "Proficiency",
        "selector": "skill:deception",
        "rank": "trained"
