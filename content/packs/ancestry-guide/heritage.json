    "rarity": "uncommon",
    "traits": ["geniekin", "suli"],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You are descended from a janni or otherwise embody a dichotomy of opposing elemental planar forces. You gain the suli trait, in addition to the traits from your ancestry. You also gain low-light vision, or you gain darkvision if your ancestry already has low-light vision. You can choose from suli feats and feats from your ancestry whenever you gain an ancestry feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Sense",
        "sense": "16b42c38-9373-58ec-a7ac-2221bb17a71c"
