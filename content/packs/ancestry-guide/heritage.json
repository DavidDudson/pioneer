  {
    "id": "23da332c-baa6-59fd-b6c2-13a4a0b6f9c5",
    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:polyglot-android",
    "name": "Polyglot Android",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You were preprogrammed with a multitude of linguistic proficiencies, likely to act as a translator. You learn two new languages, chosen from common languages and any uncommon languages you have access to. These languages take the same form (signed or spoken) as your other languages. If you select the "
          },
          {
            "type": "ref",
            "id": "2cf519d9-3331-5d83-80da-9041ede7e26f"
          },
          {
            "type": "text",
            "text": " feat, you learn three new languages instead of two."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.BjuZKA7lzFSjKbif"
    },
    "data": {
      "ancestry": "55c3cd9b-09bd-5f2a-b395-d8d2c3295f94"
    }
  },
  {
    "id": "418a4642-e01b-5d1b-bc15-1034acb04861",
    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:shapewrought-fleshwarp",
    "name": "Shapewrought Fleshwarp",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A victim of fleshwarping, you likely bear loose flesh, bony spurs, or features of inhuman creatures sprouting from your skin. You have nevertheless turned the psychic toll of your transformation into a strength. You gain resistance to mental damage equal to half your level (minimum 1)."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Resistance",
        "type": ["mental"],
        "value": "max(1, floor(@level / 2))"
      }
