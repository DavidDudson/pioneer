    }
  },
  {
    "id": "8906e8fc-4a52-5d58-a7d3-1e8694fc0494",
    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:nyktera",
    "name": "Nyktera",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have batlike features, an affinity for batkind, and hearing that is second to none. As long as you can hear normally, you can use the Seek action to sense "
          },
          {
            "type": "ref",
            "id": "61f1fec4-1bb4-585d-9c12-6059d15dd74b"
          },
          {
            "type": "text",
            "text": " creatures in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 60
          },
          {
            "type": "text",
            "text": " instead of a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": ". You also gain a +2 circumstance bonus to locate undetected creatures that you could hear within 30 feet with a Seek action."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["perception"],
        "type": "circumstance",
        "value": 2,
        "predicate": ["action:seek", "target:audible", "target:condition:undetected", "target:within-30"],
        "display": {
          "label": "To seek undetected you can hear within 30 feet (Nyktera)"
        }
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.h2VKMYAlUIFAAXVG"
    },
    "data": {
      "ancestry": "dd8ed85b-b70c-5816-8ddc-31590346f8d5"
    }
  },
  {
    "id": "e23ee303-5208-59ac-9df0-e33786cc851c",
    "pack": "ancestry-guide",
    "kind": "heritage",
    "slug": "heritage:oread",
    "name": "Oread",
    "rarity": "uncommon",
    "traits": ["oread"],
    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An earth elemental ancestor has influenced your bloodline, and your features highlight this elemental planar connection. You might have a crystalline or metallic sheen to your skin or hair, rough and stony flesh, or glittering gemstone eyes. You gain the oread trait, in addition to the traits from your ancestry. You also gain low-light vision, or you gain darkvision if your ancestry already has low-light vision. You can choose from oread feats and feats from your ancestry whenever you gain an ancestry feat."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Sense",
