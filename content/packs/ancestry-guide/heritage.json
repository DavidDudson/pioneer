    "sources": [
      {
        "kind": "book",
        "book": "ancestry-guide"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your fins conceal launchable toxic spines. You have a spine ranged unarmed attack with the unarmed trait that deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d4",
                "damageType": "poison"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage, has a range increment of 10 feet, and is in the dart weapon group."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Strike",
        "slug": "spine",
        "category": "unarmed",
        "group": "dart",
        "traits": ["unarmed"],
        "damage": {
          "dice": 1,
          "die": "d4",
          "damageType": "poison"
        },
        "range": 10,
