    "rarity": "common",
    "traits": ["healing"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You arrive at a location via a teleportation effect"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " When you reappear after the teleportation, your body takes advantage of the teleportation to put itself back together in a healthier state, and you restore a number of Hit Points equal to 1d6 plus your level plus your Intelligence modifier ("
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6 + @level + @attr.int"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": ")."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.jjxxWxnlEqWjTUur"
    },
    "data": {
      "cost": "reaction",
      "category": "offensive",
      "trigger": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You arrive at a location via a teleportation effect"
            }
          ]
        }
      ],
      "frequency": {
        "max": 1,
        "per": "minute"
      }
    }
  }
]
