  {
    "id": "e99c0dd3-8a06-5245-91c5-1ff1f42f9d1d",
    "pack": "spore-war",
    "kind": "spell",
    "slug": "spell:trim-the-blight",
    "name": "Trim the Blight",
    "level": 9,
    "rarity": "rare",
    "traits": ["concentrate", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You create a cone of shimmering energy that attempts to banish the influence of invasive, supernatural blight, such as that found in Tanglebriar. Blighted difficult terrain in the area becomes regular terrain, while blighted greater difficult terrain becomes difficult terrain; hazardous terrain in the area becomes nonhazardous. These effects persist for 1 hour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Creatures in the area that carry features of this blight (as determined by the GM, but automatically including all creatures with the fiend trait in this adventure) are trimmed as well, their supernatural infusion of blight being drained. These creatures take 12d10 spirit damage and must attempt a Fortitude save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
