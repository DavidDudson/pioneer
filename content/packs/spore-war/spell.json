[
  {
    "id": "8450af91-174f-51a0-a811-a42e5b1ff2f7",
    "pack": "spore-war",
    "kind": "spell",
    "slug": "spell:dimensional-excision",
    "name": "Dimensional Excision",
    "level": 9,
    "rarity": "rare",
    "traits": ["concentrate", "manipulate", "teleportation"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You manipulate the boundaries between planes like a scalpel, using it to cut away portions of a creature's essence and banishing those portions to other realities and dimensions, afflicting the target deep lacerations or even severed appendages. The creature takes 14d10 damage (no damage type) and 2d10 persistent bleed damage and must attempt a Will save. If the target is not on its home plane, it takes a –4 status penalty to this save. A creature reduced to 0 HP has their entire body sectioned out and banished across multiple planes and dimensions, leaving nothing behind but their gear."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (10th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The base damage increases by 2d10, and the persistent bleed damage by 1d10."
          }
        ]
      }
    ],
