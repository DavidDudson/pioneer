  {
    "id": "b29d36fa-9274-51d5-b5f2-2d5b2ce21ddf",
    "pack": "spore-war",
    "kind": "spell",
    "slug": "spell:ray-of-corruption",
    "name": "Ray of Corruption",
    "level": 7,
    "rarity": "rare",
    "traits": ["concentrate", "fungus", "manipulate", "poison"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You unleash a sickly gray beam of toxic spores at your target. Make a spell attack against the target. If you hit a non-magical object that's made of organic material (such as a tree, wooden house, or massive skull), it melts away into a foul-smelling sludge. A single casting can destroy no more than a 10-foot cube of matter."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you hit a creature, it takes 6d12 poison damage and 6d12 spirit damage with a basic Fortitude save. If you critically hit, the target gets a result one degree of success worse than the outcome of its Fortitude save."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes full damage. Fungal tendrils swiftly digest the body and reduce it to sludge—the target takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d12",
                "damageType": "acid",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the target takes double damage, plus "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d12",
                "damageType": "acid",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The poison damage and spirit damage each increase by 1d12."
          }
        ]
      }
    ],
