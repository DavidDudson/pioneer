  {
    "id": "77e263ba-31e8-54db-8594-5fc0e5f59930",
    "pack": "spore-war",
    "kind": "feat",
    "slug": "feat:traditional-ways",
    "name": "Traditional Ways",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["elf"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You are a fervent follower of the long-standing elven traditions established when your people returned to Kyonin. You gain a +2 circumstance bonus to Nature, Society, and Lore skill checks related to Kyonin or the elves that live there, as well as a +1 circumstance bonus to saves against enchantment effects that would force you to act against your will."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:nature", "skill:society", "lore"],
        "type": "circumstance",
