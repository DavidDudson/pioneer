      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can deliver a melee blow to a demon that creates an explosion of holy light to try to finish the demon off. In addition to the normal damage from your melee Strike, you also inflict "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d6",
                "damageType": "spirit"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the demon. The demon can resist this additional damage with a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " save against your class DC. If the demon is slain by this strike, it explodes in a blast of holy light that fills a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 30
          },
          {
            "type": "text",
            "text": ". All creatures in this area that have the demon trait take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d6",
                "damageType": "spirit"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and must attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-dc"
            }
          },
          {
            "type": "text",
            "text": " save against your class DC."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The demon takes no damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The demon takes half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The demon takes full damage and is "
          },
          {
            "type": "ref",
            "id": "943dfd55-ad09-5abf-9138-95a6149d3302"
          },
          {
            "type": "text",
            "text": " for 1 round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The demon takes full damage and is permanently "
          },
          {
            "type": "ref",
            "id": "5d63458a-cde5-5d64-8fea-b920f04f36b7"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      }
    ],
    "rules": [],
