  {
    "id": "66db4941-ad32-5c8d-8c45-0eb9fd5ca696",
    "pack": "spore-war",
    "kind": "feat",
    "slug": "feat:cold-iron-stomach",
    "name": "Cold Iron Stomach",
    "level": 13,
    "rarity": "uncommon",
    "traits": ["elf"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have steeled yourself against potent odors. Whenever you gain the "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8"
          },
          {
            "type": "text",
            "text": " condition, you reduce the value of that condition by 1; if this reduces the value to 0, you avoid becoming sickened entirely. You gain a +2 circumstance bonus to all saving throws against olfactory and poison effects created by demons or environmental hazards associated with the Outer Rifts (including all environmental hazards found in Tanglebriar)."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["saving-throw"],
        "type": "circumstance",
        "value": 2,
        "predicate": [
          {
            "or": ["item:trait:olfactory", "item:trait:poison"]
          },
          {
            "or": [
              "origin:trait:demon",
              {
                "and": ["origin:trait:environmental", "origin:tag:outer-rifts"]
              }
            ]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.o8DJyu5JJLppnDCS"
    },
    "data": {
      "category": "ancestry"
    }
  },
  {
    "id": "4ddbec1f-bb0f-50fe-8063-51296b293194",
    "pack": "spore-war",
    "kind": "feat",
    "slug": "feat:demon-hunter",
    "name": "Demon Hunter",
    "level": 9,
    "rarity": "uncommon",
    "traits": ["elf"],
    "sources": [
      {
        "kind": "book",
        "book": "spore-war"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The demons of Tanglebriar have long haunted your dreams, just as they have long threatened Kyonin. You have not only studied these fiendish foes well, but have trained extensively to battle the hordes of demons that serve Treerazer and are particularly adept at striking desperate melee blows against them."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When you make your daily preparations, choose one kind of demon, such as succubus, omox, shemhazian, or Treerazer. For the remainder of the day, the first time you hit one of those specific demons in a round with a melee Strike, you also deal 1d6 additional spirit damage. At 13th level, the extra damage increases to 2d6 additional spirit damage, and at 17th level, the extra damage increases to 3d6 spirit damage."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:demon-hunter",
        "toggleable": true
      },
      {
        "key": "DamageDice",
        "selectors": ["melee-strike-damage"],
        "diceNumber": "ternary(gte(@level, 17), 3, ternary(gte(@level, 13), 2, 1))",
        "dieSize": "d6",
        "damageType": "spirit",
        "predicate": ["option:demon-hunter"]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.7Jc5gVUNcEBriL9G"
    },
    "data": {
      "category": "ancestry",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "expert in Religion or Demon Lore"
            }
          ]
        }
      ]
    }
  },
  {
