  {
    "id": "d7b2e05f-ae28-5141-9dfc-33b88eca2c87",
    "pack": "secrets-of-magic",
    "kind": "shield",
    "slug": "shield:staff-storing-shield",
    "name": "Staff-Storing Shield",
    "level": 7,
    "rarity": "common",
    "traits": ["extradimensional", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "secrets-of-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This magically "
          },
          {
            "type": "text",
            "text": "reinforced wooden shield",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " normally has a blank face. It can absorb a staff and transform between a shield and staff. When you prepare a staff, you can hold it up to the shield, at which point the items will merge, and the shield's face becomes an image corresponding to the type of magic, such as a skull for a staff of necromancy."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " Interact"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You change the staff-storing shield from its shield form into the stored staff, which has an image of the shield on it, or change it from the stored staff back into a shield."
          }
        ]
      },
