    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This well-crafted wooden shield is covered in numerous seed pods with long spurs. You can Strike with these burrs as though they were "
          },
          {
            "type": "ref",
            "id": "bbe81ce4-2fd6-5e24-a413-eb4c666c0fd3",
            "label": "+1 Striking Shield Spikes"
          },
