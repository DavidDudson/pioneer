        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Catharsis Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The event or conditions you must meet to take your Catharsis reaction."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Catharsis Activation",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The benefit when you use Catharsis."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Emotional Fervor",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "text",
            "text": "Benefits",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " you gain for 3 rounds after you use Catharsis. This entry also lists a spell you're able to cast while in your emotional fervor. You must expend a spell slot to cast it. This slot most be of at least the spell's rank, and the spell is automatically heightened to the rank of slot you expended."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Emotional Fallout",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The effect you experience when your emotional fervor ends."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Focus Spell",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The focus spell you gain if you select the Cathartic Focus Spell archetype feat."
          }
        ]
      }
    ],
