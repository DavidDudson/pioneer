        "book": "secrets-of-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This rune thrums with pure magical energy. Weapons with the rune deal an additional 1d6 force damage on a successful Strike. On a critical hit, you can choose to force the target to succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 27
          },
          {
            "type": "text",
            "text": " save or be pushed 5 feet away from you."
          }
        ]
      }
    ],
