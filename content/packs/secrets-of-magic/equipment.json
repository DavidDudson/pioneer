  {
    "id": "c8558467-4890-5a7b-ad49-67e4e8433044",
    "pack": "secrets-of-magic",
    "kind": "equipment",
    "slug": "equipment:true-name-amulet-greater",
    "name": "True Name Amulet (Greater)",
    "level": 15,
    "rarity": "rare",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "secrets-of-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This amulet bears the true name of a single creature with a level no higher than the item's level. These amulets are typically made of gold and engraved, but could be made of anything, including simple clay. The name is clearly visible, though only to you, and only while you have the amulet invested."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you can read the language in which the name is written, that creature always takes the effects of "
          },
          {
            "type": "text",
            "text": "invoke true name",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " against your spells (with a spell rank equal to half the item's level, rounded up). In addition, when the creature uses any magical effect against you, you can immediately attempt to counteract it using Arcana, Nature, Occult, or Religion for the counteract check and the true name amulet's level to determine the counteract rank. Legendary amulets bearing the true names of creatures of level 21+ may exist."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.dABsOA9Qiy0nkGgV"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 5500
        }
      },
      "bulk": "negligible",
      "usage": {
        "type": "worn",
        "slot": "amulet"
      }
    }
  },
