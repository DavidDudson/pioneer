          "gp": 320
        }
      },
      "bulk": 1,
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
  },
  {
    "id": "f1675484-c66b-55b5-86a4-ca5edfcb63c6",
    "pack": "secrets-of-magic",
    "kind": "equipment",
    "slug": "equipment:specialists-ring",
    "name": "Specialist's Ring",
    "level": 10,
    "rarity": "common",
    "traits": ["focused", "invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "secrets-of-magic"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each "
          },
          {
            "type": "text",
            "text": "specialist's ring",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is dedicated to a single school of magic, and the ring is covered in symbols and glyphs related to that school according to the creator's arcane studies. A specialist's ring has the trait corresponding to its school of magic. You gain a +2 item bonus to Arcana checks, and a +1 circumstance bonus to recognize magical effects and items of the specific school of magic."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "free"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain 1 Focus Point, which you can use only to cast a wizard school spell of the corresponding school. If not used by the end of your turn, this Focus Point is lost."
          }
        ]
      }
    ],
    "rules": [
