    "slug": "weapon:buzzsaw-axe",
    "name": "Buzzsaw Axe",
    "level": 11,
    "rarity": "common",
    "traits": ["magical", "sweep"],
    "sources": [
      {
        "kind": "book",
        "book": "secrets-of-magic",
        "page": 181,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=1045"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "With an aerodynamic cutting edge and a curved handle, this "
          },
          {
            "type": "text",
            "text": "+2 striking battle axe",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " is perfectly suited to whirling motions, and in fact seems like it wants to whirl free from your grip. A Strike with this axe that benefits from the sweep trait's circumstance bonus on attack rolls also gains a +2 circumstance bonus to the damage roll."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " command, Interact"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You hurl the axe, which spins at great speed as it flies to a distant point and returns to you, leaving a trail of carnage. Each creature in a "
          },
          {
            "type": "template",
            "shape": "line",
            "size": 120
          },
          {
            "type": "text",
            "text": " must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 28,
            "basic": true
          },
          {
            "type": "text",
            "text": " save or take damage equal to the weapon's melee damage, including your Strength modifier."
          }
        ]
      }
    ],
