        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per 10 minutes"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You successfully Strike a creature with a thrown Strike with guiding star"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Soft light outlines the target. At the beginning of your next turn, the guiding star's blades detach and form into darts of starlight, flying up to 40 feet and striking the target unerringly, collectively dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage and "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1",
                "damageType": "spirit"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage before re-forming. The piercing damage increases to "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a greater striking rune and "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "8",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a major striking rune."
          }
        ]
      }
