    "slug": "rune:mythic-armor-potency",
    "name": "Mythic Armor Potency",
    "level": 20,
    "rarity": "rare",
    "traits": ["magical", "mythic"],
    "sources": [
      {
        "kind": "book",
        "book": "war-of-immortals",
