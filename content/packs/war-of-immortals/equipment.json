  {
    "id": "7e4a6877-b3b0-5d9e-a4c5-318545abc96b",
    "pack": "war-of-immortals",
    "kind": "equipment",
    "slug": "equipment:immaculate-instrument",
    "name": "Immaculate Instrument",
    "level": 12,
    "rarity": "rare",
    "traits": ["artifact", "divine", "mythic"],
    "sources": [
      {
        "kind": "book",
        "book": "war-of-immortals",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3514"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This object, made of silver light, takes the form of a small musical instrument, prop, or other tool associated with a specific art form. The holder of the "
          },
          {
            "type": "text",
            "text": "immaculate instrument",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " never suffers from creative blocks of any kind and their work is always insightful and skilled. A character who uses the "
          },
          {
            "type": "text",
            "text": "immaculate instrument",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to "
          },
          {
            "type": "ref",
            "id": "56d1e4d6-9708-5d3c-b2ac-5fe9f0cfb544"
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "ref",
            "id": "cffa6a55-a0d3-5be2-8169-ba9cf4745e57"
          },
          {
            "type": "text",
            "text": " can attempt the check at mythic proficiency once per month, and as long as they possess their "
          },
          {
            "type": "text",
            "text": "immaculate instrument",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", they treat any critical failures with these skills as failures."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Destruction",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " If the holder uses the "
          },
          {
            "type": "text",
            "text": "immaculate instrument",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " to intentionally produce a work that is not just mediocre or crass, but one that devalues the public opinion of the art form itself in a showing of at least 100 spectators, the instrument fades away in shame."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.LeKkgh335aJTQr8T"
    },
    "data": {
      "bulk": "light",
      "usage": {
        "type": "held",
        "hands": "one"
      }
    }
