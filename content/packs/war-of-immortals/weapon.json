        "page": 171,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3512"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+1 striking ogre hook",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " causes its owner to dream of past murders conducted with the weapon. "
          },
          {
            "type": "text",
            "text": "Gut-Ripper",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "'s mythic magic is tied to the bloodlust of the ogre boss who was holding it upon becoming mythic. If "
          },
          {
            "type": "text",
            "text": "Gut-Ripper",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " doesn't kill a creature each day by midnight, it becomes a non-magical ogre hook."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Rip Guts! Rip Guts!",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "text",
            "text": "Cost",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 Mythic Point"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You throw "
          },
          {
            "type": "text",
            "text": "Gut-Ripper",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " in a line of any length up to 60 feet, then it returns to your hands. Each creature in the line takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d10",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 25,
            "basic": true
          },
          {
            "type": "text",
            "text": " save. If there's a creature at the end of the line, you instead make a melee Strike against it with the hook that deals an additional "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d10",
                "damageType": "bleed",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage. Each time a creature takes this bleed damage, you regain that many HP; this is a healing vitality effect. This activation can't be used again for 1d4 rounds."
          }
        ]
      }
    ],
