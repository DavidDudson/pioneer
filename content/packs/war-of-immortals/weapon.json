  {
    "id": "c132ebb5-aa22-5f55-9aa4-7d2871836727",
    "pack": "war-of-immortals",
    "kind": "weapon",
    "slug": "weapon:shadowpiercer",
    "name": "Shadowpiercer",
    "level": 23,
    "rarity": "unique",
    "traits": ["artifact", "magical", "monk", "mythic", "thrown-20"],
    "sources": [
      {
        "kind": "book",
        "book": "war-of-immortals",
        "page": 152,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3510"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Muted, silvery moonlight gleams along the curved blade of this "
          },
          {
            "type": "text",
            "text": "+4 major striking ghost touch spear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". Braided tassels of horsehair dangle from its sturdy haft, and archaic runes in Nidalese script shimmer along the weapon in the presence of shadow magic."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Shadowpiercer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " ignores immunity and resistance to precision damage of creatures with the incorporeal or shadow trait, and deals an additional 2d6 precision damage to such creatures. While wielding "
          },
          {
            "type": "text",
            "text": "Shadowpiercer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", you gain a +2 status bonus to saving throws against darkness and shadow effects; this bonus also applies to allies within 60 feet of you while you wield the spear. If you are a worshipper of "
          },
          {
            "type": "ref",
            "id": "47aae0d3-181c-535a-9242-9625acd33814"
          },
          {
            "type": "text",
            "text": ", you are "
          },
          {
            "type": "ref",
            "id": "fa3d4a94-c2f9-519b-b0a3-82d2612e188b",
            "label": "Drained 4"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd",
            "label": "Enfeebled 4"
          },
          {
            "type": "text",
            "text": " while carrying or wielding "
          },
          {
            "type": "text",
            "text": "Shadowpiercer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". If you use a darkness or shadow effect while carrying or wielding "
          },
          {
            "type": "text",
            "text": "Shadowpiercer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", you become enfeebled 4; this condition's value reduces by 1 at the start of each day you do not have physical contact with "
          },
          {
            "type": "text",
            "text": "Shadowpiercer",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Absorb Shadows",
            "marks": ["strong"]
          },
          {
