    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These "
          },
          {
            "type": "ref",
            "id": "050458fd-ce2e-53a2-ac9d-e9a790d70513",
            "label": "healer's toolkits"
          },
          {
            "type": "text",
            "text": " are collections of crystalline scalpels and gritty salves made of cytillesh. They all glow the same sickly blue. While the toolkit is outside its opaque container, it sheds dim light in a 5-foot radius. Any non-dero using or wearing the toolkit is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": " until 1 hour after they've stopped, which cannot be reduced during that time."
          }
        ]
      }
    ],
    "rules": [],
