  {
    "id": "384908e2-5d73-5427-a5e4-666478fc6bf2",
    "pack": "monster-core",
    "kind": "ritual",
    "slug": "ritual:diabolic-pact",
    "name": "Diabolic Pact",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["unholy"],
    "sources": [
      {
        "kind": "book",
        "book": "monster-core",
        "page": 364,
        "aon": "https://2e.aonprd.com/Rituals.aspx?ID=143"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You make an appeal to a powerful devil, asking them to bind some of their subordinates to your service. If you succeed, the devil sends you their choice of one devil of level 2 or lower, two devils of level 0 or lower, or three devils of level –1 or lower."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The devils are sent to you and serve you for 1d4 weeks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The devils are sent to you and serve you for 1d4 days."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Your request is denied."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Not only is your request denied, but the powerful devil sends word of its displeasure to your master."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Increase the level of devil sent to you by 2 for each option."
          }
        ]
      }
    ],
