            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per minute"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Make a Strike against a living tree with Blackaxe. If it hits, the tree withers to ash and you heal 250 Hit Points and gain the benefit of a 6th-rank Restoration (6th) and "
          },
          {
            "type": "ref",
            "id": "674398f3-e121-59fe-a086-423c20002dd1"
          },
          {
            "type": "text",
            "text": " spell."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Destruction",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Chop a powerful magical tree with Blackaxe, and while the sap is still fresh, sever one of Cyth-V'sug's limbs. This makes Blackaxe explode violently."
          }
        ]
