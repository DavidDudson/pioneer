    "id": "0cad6e40-e714-5235-821b-8bc1eb84e606",
    "pack": "core-rules",
    "kind": "trait",
    "slug": "trait:finisher",
    "name": "Finisher",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "player-core-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Finishers are spectacular finishing moves. You can use a finisher only if you have panache, and you lose your panache immediately after performing a finisher. Once you use a finisher, you can't use actions that have the attack trait for the rest of your turn. Some finisher actions also grant an effect on a failure. If your finisher succeeds, you can choose to apply the failure effect instead."
          }
        ]
      }
    ],
    "rules": [],
    "data": {
      "appliesTo": ["action", "ancestry-feature", "class-feature", "feat"]
    }
  },
  {
    "id": "b4f5c7b3-bd93-53d6-8f9d-e73e0ff10ee2",
    "pack": "core-rules",
    "kind": "trait",
    "slug": "trait:hampering",
    "name": "Hampering",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "player-core-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "After you hit with the weapon, you can use an Interact action to give the target a –10-foot circumstance penalty to all Speeds. The penalty ends after the target takes a move action, at the start of your next turn, if you attack with the weapon, or if you move out of reach of the target, whichever comes first."
          }
        ]
      }
    ],
    "rules": [],
    "data": {
      "appliesTo": ["weapon"]
    }
  },
  {
