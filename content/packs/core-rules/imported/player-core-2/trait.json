  {
    "id": "6f04b7e1-6488-53a6-8737-2b6df866f379",
    "pack": "core-rules",
    "kind": "trait",
    "slug": "trait:cursebound",
    "name": "Cursebound",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "player-core-2"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Abilities with this trait tighten your oracular curse's grasp on your soul in exchange for divine insights, giving you the cursebound condition (see below). When you use a cursebound ability, you become cursebound 1, or if you were already cursebound, you increase the value of your cursebound condition by 1. As cursebound abilities are directly linked to your oracular curse, you can't use a cursebound ability if you don't have an oracular curse or if you are already at your maximum cursebound value. You can't mitigate or bypass the drawbacks of any cursebound ability with spells or other effects, and the effects of any cursebound ability end when you Refocus and remove the cursebound condition. A cursebound ability that allows a defense uses your spell attack modifier or spell DC unless noted otherwise."
          }
        ]
      }
    ],
    "rules": [],
    "data": {
      "appliesTo": [
        "action",
        "ancestry-feature",
        "class-feature",
        "condition",
