            "type": "text",
            "text": " "
          },
          {
            "type": "text",
            "text": "Key attribute: ",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": "Dexterity."
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "text",
            "text": "Actions: ",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": "Balance, Tumble Through, Maneuver in Flight, Squeeze, Escape."
          }
        ]
      }
    ],
