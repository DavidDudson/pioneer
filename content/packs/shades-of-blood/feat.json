  {
    "id": "1f859c89-bc4d-5278-86a9-a9e7db7e1f8d",
    "pack": "shades-of-blood",
    "kind": "feat",
    "slug": "feat:sanguimancer-dedication",
    "name": "Sanguimancer Dedication",
    "level": 2,
    "rarity": "rare",
    "traits": ["dedication"],
    "sources": [
      {
        "kind": "book",
        "book": "shades-of-blood",
        "page": 84,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7764"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The life essence in your blood recovers naturally over time. You gain a special type of temporary Hit Points called sanguimancy Hit Points that follow the normal rules for temporary Hit Points with two exceptions: you can spend them to power some sanguimancy feats, and you can never have a greater number of sanguimancy Hit Points than double your level."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "After a full 8-hour rest, you gain sanguimancy HP equal to your level that last for 8 hours. If someone successfully restores HP to you with "
          },
          {
            "type": "ref",
            "id": "18c1b923-595b-5203-a0be-010205e51c44"
          },
          {
            "type": "text",
            "text": ", you also gain 1 sanguimancy HP for every 10 Hit Points recovered (minimum 1 sanguimancy HP)."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Special",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Sanguimancer actions have the trait matching your spellcasting tradition; if you don't have one, choose divine or occult when you select the Sanguimancer Dedication."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sanguimancer"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.HASFgAZ7spYleeaq"
    },
    "data": {
      "category": "class"
    }
  },
  {
    "id": "474f351b-9601-523a-a352-714b5db84a07",
    "pack": "shades-of-blood",
    "kind": "feat",
    "slug": "feat:sanguine-tenacity",
    "name": "Sanguine Tenacity",
    "level": 11,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "shades-of-blood",
        "page": 84,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7762"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your blood carries permanent regenerative properties. The penalties from "
          },
          {
            "type": "ref",
            "id": "5aa15fa8-99a7-56a4-8237-f605177275dd"
          },
          {
            "type": "text",
            "text": " and the penalties and lost HP from "
          },
          {
            "type": "ref",
            "id": "fa3d4a94-c2f9-519b-b0a3-82d2612e188b"
          },
          {
            "type": "text",
            "text": " both affect you as if the condition values were 1 lower than they actually are. You also gain resistance 5 to persistent bleed damage and reduce the DC of checks to recover from persistent bleed damage to 11, or 6 if you have particularly effective assistance."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Resistance",
        "type": ["bleed"],
        "value": 5
      },
      {
        "key": "AdjustModifier",
        "selectors": ["con-based", "str-based", "str-damage"],
        "mode": "add",
        "value": 1,
        "predicate": [
          {
            "or": ["penalty:slug:drained", "penalty:slug:enfeebled"]
          }
        ]
      },
      {
        "key": "FlatModifier",
        "selectors": ["hp"],
        "type": "untyped",
        "value": "@level",
        "predicate": ["self:condition:drained"]
      }
    ],
    "externalIds": {
