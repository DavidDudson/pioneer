  {
    "id": "1ee311aa-55d2-5bf7-b6e9-e83ae3a22ba6",
    "pack": "shades-of-blood",
    "kind": "feat",
    "slug": "feat:bloodsense",
    "name": "Bloodsense",
    "level": 7,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "shades-of-blood",
        "page": 83,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7761"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're extraordinarily sensitive to the presence of blood. You gain bloodsense as an imprecise sense with a range of 15 feet. This allows you to sense the presence of creatures, living or dead, that have blood (this includes most creatures that aren't immune to bleed). You're similarly able to detect the presence of fresh blood in volumes of one pint or more, so long as it's no more than 24 hours old."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "Sense",
        "sense": "f14d179a-1584-59f0-a180-c4c668d3780c",
        "acuity": "imprecise",
        "range": 15
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.QRL79whClQDHljoi"
    },
    "data": {
      "category": "general",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "master in Perception"
            }
          ]
        }
      ]
    }
  },
  {
