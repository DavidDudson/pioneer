  {
    "id": "bfb5876c-18de-5dcf-a2d4-fad4814ec06b",
    "pack": "shades-of-blood",
    "kind": "feat",
    "slug": "feat:vasodilation",
    "name": "Vasodilation",
    "level": 2,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "shades-of-blood",
        "page": 84,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7763"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Using the power of your own blood, you encourage increased blood flow to nourish damaged tissue or stifle the flow to clot wounds or prevent the spread of poison and disease. You no longer require a healer's toolkit to "
          },
          {
            "type": "ref",
            "id": "e03baa02-2fea-552f-9996-c41bfa074713"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "07fc0cb2-53f2-5552-82e6-5e43003875eb"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "1a89ca53-58a9-5dc9-913e-3dfa46e5e1b0"
          },
          {
            "type": "text",
            "text": ", or "
          },
          {
            "type": "ref",
            "id": "18c1b923-595b-5203-a0be-010205e51c44"
          },
          {
            "type": "text",
            "text": ", though you take "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage each time you take one of these actions without the proper tools from the expenditure of your blood. You can't reduce or prevent this damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You gain a +1 item bonus when performing these actions using your blood, which increases to +2 if you're a master in Medicine and +3 if you're legendary."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:medicine"],
        "type": "item",
        "value": "ternary(gte(@rank.skill.medicine, 4), 3, ternary(gte(@rank.skill.medicine, 3), 2, 1))",
        "predicate": [
          {
            "or": ["action:administer-first-aid", "action:treat-disease", "action:treat-poison", "action:treat-wounds"]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.X4T7pO25YgW5lHWJ"
    },
    "data": {
      "category": "skill",
      "prerequisites": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "trained in Medicine"
            }
          ]
        }
      ]
    }
