  {
    "id": "3e2986bc-c771-50dc-9c20-0a15693e676a",
    "pack": "shades-of-blood",
    "kind": "feat",
    "slug": "feat:blood-shield",
    "name": "Blood Shield",
    "level": 4,
    "rarity": "common",
    "traits": ["archetype"],
    "sources": [
      {
        "kind": "book",
        "book": "shades-of-blood",
        "page": 84,
        "aon": "https://2e.aonprd.com/Feats.aspx?ID=7765"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cost",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 1 or more sanguimancy Hit Points"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You raise a defensive barrier of your own blood to protect you. You gain a +1 circumstance bonus to AC until the start of your next turn, increasing to a +2 bonus if you spend 10 or more sanguimancy Hit Points. While this bonus is in effect, you can use the Shield Block reaction with your blood shield. The blood shield has Hardness equal to four times the number of sanguimancy Hit Points you spent. After you use Shield Block, the blood shield dissipates, ending the circumstance bonus to AC early."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.feats-srd.Item.oTEidzP2UmYowhud"
    },
