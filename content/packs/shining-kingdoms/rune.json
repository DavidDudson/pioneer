[
  {
    "id": "f13e9206-f6b3-5aa5-9394-2153e9c615cc",
    "pack": "shining-kingdoms",
    "kind": "rune",
    "slug": "rune:bolkas-blessing",
    "name": "Bolka's Blessing",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["divine", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This filigree grants you a +1 item bonus to Diplomacy checks and to Perception checks to "
          },
          {
            "type": "ref",
            "id": "775b68f2-1542-5f47-bc0d-87d5884d7baa"
          },
          {
            "type": "text",
            "text": ". Additionally, once per day, the filigree symbol can be activated for a healing effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Gift of Life",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate, healing, vitality)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You regain "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "3d10",
                "damageType": "vitality"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.fqnjZzwBi9GH4CXO"
    },
