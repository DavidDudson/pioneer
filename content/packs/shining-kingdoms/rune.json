  {
    "id": "b3ba5fae-109e-57c0-a6cd-cb7079116dc2",
    "pack": "shining-kingdoms",
    "kind": "rune",
    "slug": "rune:trudds-strength",
    "name": "Trudd's Strength",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["divine", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This filigree depiction of a warhammer in front of a kite-shaped shield grants you a +1 item bonus to Athletics checks and to Intimidation checks to "
          },
          {
            "type": "ref",
            "id": "ed0f3425-17f0-51f3-bb5d-1ca7475499a5"
          },
          {
            "type": "text",
            "text": ". Additionally, once per day, the filigree symbol can be activated to protect your allies."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Protect the Clan!",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Protective energy releases in a "
          },
          {
            "type": "template",
            "shape": "emanation",
            "size": 10
          },
          {
            "type": "text",
            "text": ", granting a +1 status bonus to Armor Class to all allies within the area. The bonus lasts for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "be0b423d-11fb-5024-a422-8574dbfd16e7"
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.I8XecIUYhwagAnXv"
    },
