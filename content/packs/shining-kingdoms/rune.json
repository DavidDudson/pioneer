  {
    "id": "d338ed23-1c89-58a8-8c02-36db906da596",
    "pack": "shining-kingdoms",
    "kind": "rune",
    "slug": "rune:kolss-oath",
    "name": "Kols's Oath",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["divine", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This filigree grants you, as the clan dagger's owner, a +1 item bonus to Society checks and to Diplomacy checks to Request. Additionally, once per day, the filigree symbol can be activated to compel an enemy to act."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Vow Unbreakable",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (auditory, concentrate, linguistic, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You command a creature within 30 feet to Stride away from you, drop "
          },
          {
            "type": "ref",
            "id": "73c08daf-ef8e-5d9c-a2ac-dcdbfdafd759"
          },
          {
            "type": "text",
            "text": ", or release one item it's holding. The creature can choose to perform that action as the first action on its next turn; if it doesn't, it takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d6",
                "damageType": "mental"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 20,
            "basic": true
          },
          {
            "type": "text",
            "text": " save)."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.tvFMexALNZ70NVwh"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 160
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "vow-unbreakable",
          "name": "Vow Unbreakable",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "type": "property",
      "etchedOnto": {
        "item": "weapon",
        "restriction": "clan-dagger"
      }
    }
  },
