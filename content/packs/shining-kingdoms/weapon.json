    "slug": "weapon:lions-call",
    "name": "Lion's Call",
    "level": 10,
    "rarity": "uncommon",
    "traits": ["agile", "finesse", "versatile-s"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "page": 173,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3777"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Access",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're a member of the Lion Blades."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Given only to highly trusted agents by the grand princes back when Lion Blades protected the Primogen Crown, these historic "
          },
          {
            "type": "text",
            "text": "+1 striking authorized shortswords",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " allow a Lion Blade wielder to locate resources."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Find the Pride",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "three"
          },
          {
            "type": "text",
            "text": " (arcane, concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You cast "
          },
          {
            "type": "ref",
            "id": "d437e6ba-d367-5d77-b142-bace584873d7"
          },
          {
            "type": "text",
            "text": " at 5th rank to learn the location of one of the following of your choice: the nearest Lion Blade safe house, shadow school, Lion Blade agent, Lion Blade kith, or a person other than yourself who's in possession of a "
          },
          {
            "type": "text",
            "text": "lion's call",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Echo the Call",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " (arcane, concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A creature locates you using another "
          },
          {
            "type": "text",
            "text": "lion's call",
            "marks": ["emphasis"]
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You immediately learn the location and appearance of the triggering creature. You can communicate telepathically with the triggering creature while you remain within 1 mile of each other for the next hour"
          }
        ]
      }
    ],
