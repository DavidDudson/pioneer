  {
    "id": "aa44fd0a-f14d-56ca-8721-e22ed1291378",
    "pack": "shining-kingdoms",
    "kind": "consumable",
    "slug": "consumable:godrending-ammunition",
    "name": "Godrending Ammunition",
    "level": 13,
    "rarity": "rare",
    "traits": ["consumable", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "page": 52,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3763"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Embedded in this piece of ammunition is a shining sliver of a warshard. When an activated godrending ammunition hits a target, the body of the struck creature attempts to tear itself apart, causing nauseating pain. Instead of its normal damage, the ammunition deals "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "10d8",
                "damageType": "slashing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage. The target can attempt a "
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 30
          },
          {
            "type": "text",
            "text": " saving throw; it takes a –2 circumstance penalty to this save if the Strike was a critical hit."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The foe takes the normal damage from the ammunition, instead of the 10d8 slashing damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The foe takes half damage."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The foe takes full damage and is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 1"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The foe takes double damage and is "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": ". A creature reduced to 0 HP from this damage is ripped limb from limb, and it instantly dies; its gear remains."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.0PGauxNX76JaaREG"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 440
        }
      },
      "bulk": "negligible",
      "category": "ammunition"
    }
  },
