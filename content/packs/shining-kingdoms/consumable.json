    "level": 18,
    "rarity": "rare",
    "traits": ["consumable", "magical", "potion"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "page": 52,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3762"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Though it contains but a tiny drop of Gorum's blood, drinking this thick, swirling potion fills the user with divine wrath and resilience. While under the effect of the potion, you gain a +4 status bonus to physical damage rolls for 1 minute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "ref",
            "id": "c22e3ce4-515a-530e-966c-f4f97e8e7c84"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The first time during that minute you're reduced to 0 Hit Points but not immediately killed, you avoid being knocked out, regain "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d8+20"
              }
            ],
            "healing": true
          },
          {
            "type": "text",
            "text": " Hit Points, and become "
          },
          {
            "type": "ref",
            "id": "6f53a234-670f-5b02-a986-7cce57585fc8"
          },
          {
            "type": "text",
            "text": " for 1 round, and your "
          },
          {
            "type": "ref",
            "id": "6c4e09a7-469d-5668-8c1b-92f87de94d27"
          },
          {
            "type": "text",
            "text": " condition increases by 1."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.jkjqpRWXdi0rGWey"
    },
