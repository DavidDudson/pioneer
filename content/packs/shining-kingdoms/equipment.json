    "name": "Paws of the Grogrisant",
    "level": 17,
    "rarity": "unique",
    "traits": ["apex", "invested", "primal"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3781",
        "page": 173
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Princess Eutropia commissioned Taldor's Imperial College of Heralds to preserve the paws that fell off the Mantle of the Grogrisant. A few weeks later, the college presented this pair of boots. You gain a +3 item bonus to Athletics checks and saves against forced movement. When you invest in the boots, you either increase your Strength modifier by 1 or increase it to +4, whichever would give you a higher value."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Grogrisant Leap",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The Grogrisant's legendary strength and reflexes empower your movement. You Leap, doubling the vertical and horizontal distance of your Leap action. If you land adjacent to a creature, you can Strike that creature once as part of this action."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["athletics-check"],
        "type": "item",
        "value": 3
      },
      {
        "key": "FlatModifier",
