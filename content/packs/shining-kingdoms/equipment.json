  {
    "id": "9fdc2dee-97ab-564a-95cd-c1b4933d5b18",
    "pack": "shining-kingdoms",
    "kind": "equipment",
    "slug": "equipment:shawl-of-seasons",
    "name": "Shawl of Seasons",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3775",
        "page": 149
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This woven shawl changes its color, material, and abilities with the seasons. In its usual state, it reflects the current season of the environment the wearer is in. The handsome embroidery grants you a +2 item bonus to Diplomacy checks to "
          },
          {
            "type": "ref",
            "id": "722e5346-27c0-5157-b5a9-e6018df94150"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Change of Seasons",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " 10 minutes (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You arrange the shawl on your shoulders to gain the benefits of a season of your choice until your next daily preparations. If the season you choose is the current season, you also gain a +1 item bonus to Fortitude saving throws."
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Spring",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The shawl becomes smooth silk covered in delicate flowers. You gain a +5-foot item bonus to your Speed."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Summer",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The shawl becomes light cotton with the hues of fresh grass. You're protected from the effects of severe heat."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fall",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The shawl becomes thin leather with an ombre of red and orange leaves. You treat falls as 10 feet shorter."
                }
              ]
            }
          ],
          [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Winter",
                  "marks": ["strong"]
                },
                {
                  "type": "text",
                  "text": " The shawl becomes warm wool as white as snow. You're protected from the effects of severe cold."
                }
              ]
            }
          ]
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:diplomacy"],
        "type": "item",
        "value": 2,
        "predicate": ["action:make-an-impression"]
      },
      {
        "key": "RollOption",
        "option": "shawl-of-seasons:change-of-seasons",
        "toggleable": true,
        "suboptions": [
          {
            "value": "spring",
            "label": "Spring"
          },
          {
            "value": "summer",
            "label": "Summer"
          },
          {
            "value": "fall",
            "label": "Fall"
