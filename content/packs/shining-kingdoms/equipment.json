  {
    "id": "6d249878-e3f9-573b-9606-529918efcd08",
    "pack": "shining-kingdoms",
    "kind": "equipment",
    "slug": "equipment:keep-stone-amulet",
    "name": "Keep Stone Amulet",
    "level": 19,
    "rarity": "rare",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3767",
        "page": 101
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The superior adamantine-lead alloy known as keep stone is as highly prized as it is expensive, and for good reason: keep stone combines the Hardness and durability of the finest metal with inherent magical protection. Not only does the metal itself resist magical effects, but anyone in proximity to a large amount of it also enjoys a degree of protection from divination magic. Dwarven crafters have attempted to make this extra protection more portable and more affordable in the form of "
          },
          {
            "type": "text",
            "text": "keep stone amulets",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". Each amulet is unique in its exact shape, size, thickness, and decorations, but typically, a keep stone amulet is roughly palm-sized and engraved with clan symbols, holy aphorisms, or a favorite line of poetry."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "While wearing a "
          },
          {
            "type": "text",
            "text": "keep stone amulet",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ", if you're the target of a spell with the detection or scrying trait, the caster must succeed at a "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 5
          },
          {
            "type": "text",
            "text": " or lose the spell."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Rebuff Magic",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "reaction"
          },
          {
            "type": "text",
            "text": " (concentrate, misfortune)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trigger",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You're the target of a spell with a spell attack roll"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The caster must roll the spell attack roll twice and take the worse result."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.Jp6HZr9zJP5JMEBu"
    },
