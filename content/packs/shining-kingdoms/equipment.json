  {
    "id": "d7d585d5-ded8-508e-8b46-1fda5b6a97e4",
    "pack": "shining-kingdoms",
    "kind": "equipment",
    "slug": "equipment:jaws-of-the-grogrisant",
    "name": "Jaws of the Grogrisant",
    "level": 17,
    "rarity": "unique",
    "traits": ["apex", "invested", "primal"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3780",
        "page": 173
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The teeth that fell off the Mantle of the Grogrisant were given to the scholars of Houses Fahlspar, Lotheed, Nicodemius, and Zespire, who—after much heated discussion—created this regal circlet. You gain a +3 item bonus to Diplomacy and Intimidation skill checks and "
          },
          {
            "type": "ref",
            "id": "775b68f2-1542-5f47-bc0d-87d5884d7baa"
          },
          {
            "type": "text",
            "text": " checks against creatures that have the primal trait. When you invest in the headband, you either increase your Wisdom modifier by 1 or increase it to +4, whichever would give you a higher value."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Primal Empathy",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, mental)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per hour"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You gain the ability to communicate with nature as if you were a part of it. You cast "
          },
          {
            "type": "ref",
            "id": "b9c6ff5d-7757-5750-8536-1486fd82c8a7"
          },
          {
            "type": "text",
            "text": " at 6th rank, which can only be used to communicate with creatures that have the primal trait."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill-check", "perception-check"],
        "type": "item",
        "value": 3,
        "predicate": [
          "target:trait:primal",
          {
            "or": ["action:sense-motive", "check:statistic:diplomacy", "check:statistic:intimidation"]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.vg4p0cHrZf14VXGz"
    },
