[
  {
    "id": "a3703928-36f0-55cf-af52-9ab573b6079d",
    "pack": "shining-kingdoms",
    "kind": "equipment",
    "slug": "equipment:emperors-peak-quartz-bracelet",
    "name": "Emperor's Peak Quartz Bracelet",
    "level": 3,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3766",
        "page": 100
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "While most residents of—and travelers to—the Five Kings Mountains live underground, a significant number of people explore the regions' awe-inspiring peaks. Among their many discoveries on Emperor's Peak is a deposit of rainbow-colored rock crystal quartz with inherent magical properties that aid in survival, especially in the mountains. Dwarven artisans fashion chunks of this translucent quartz into fashionable bracelets."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Wearing such a bracelet grants you a +1 item bonus to Survival checks to "
          },
          {
            "type": "ref",
            "id": "d0498569-a787-5708-8a5f-39c521dd3df4"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "ref",
            "id": "897dec4f-1321-59a1-bb19-085290e409f0"
          },
          {
            "type": "text",
            "text": ". This bonus increases to +3 when in mountainous terrain. If you attempt a Survival check to Subsist after 8 hours or less of exploration, you take only a –2 penalty instead of a –5 penalty."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:survival"],
        "type": "item",
        "value": 1,
        "predicate": [
          {
            "or": ["action:subsist", "action:sense-direction"]
          }
        ]
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.um6HjOHNXNux6WQu"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 5
        }
      },
      "bulk": "negligible",
      "usage": {
        "type": "worn"
      }
    }
  },
