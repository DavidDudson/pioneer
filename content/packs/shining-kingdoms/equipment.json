  {
    "id": "c05f5aed-7ba5-5050-a79f-efca8ad90a49",
    "pack": "shining-kingdoms",
    "kind": "equipment",
    "slug": "equipment:resonating-crystal-boots",
    "name": "Resonating Crystal Boots",
    "level": 8,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=3774",
        "page": 149
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These supple leather boots are studded with tiny crystals."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Chiming Steps",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (auditory, concentrate, sonic)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Stride up to half your Speed. The crystals ring out with pleasant-sounding chimes that reverberate painfully in the ears of others. Each creature that you pass adjacent to during your Stride takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "4d8",
                "damageType": "sonic"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage ("
          },
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": 24,
            "basic": true
          },
          {
            "type": "text",
            "text": " save); a creature takes this damage only once. A creature who critically fails the save is also "
          },
          {
            "type": "ref",
            "id": "4271da2e-7225-5aa7-9807-c499d8af6a5a"
          },
          {
            "type": "text",
            "text": " for 1 minute."
          }
        ]
      }
    ],
