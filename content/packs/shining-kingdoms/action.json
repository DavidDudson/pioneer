[
  {
    "id": "54e25828-98ae-59ee-b321-6b906af7ad54",
    "pack": "shining-kingdoms",
    "kind": "action",
    "slug": "action:designate-ally",
    "name": "Designate Ally",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "shining-kingdoms"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose an ally you can see, who becomes your designated ally. For the next minute, whenever your designated ally is adjacent to you and you're conscious, they gain a +2 circumstance bonus to AC and Reflex saving throws. You can have only one designated ally at a time, and if you designate a new ally, the previous ally loses any benefits."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
