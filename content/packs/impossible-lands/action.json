[
  {
    "id": "dc324d1c-d5cd-50d3-95dd-d7c8efbb4d45",
    "pack": "impossible-lands",
    "kind": "action",
    "slug": "action:break-them-down",
    "name": "Break Them Down",
    "rarity": "common",
    "traits": ["gunslinger"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "page": 108,
        "aon": "https://2e.aonprd.com/Actions.aspx?ID=1457"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your foes are but dross from which you carve and shoot your legend. Make a melee Strike and then a ranged Strike with a combination weapon, both against the same enemy; you don't need to change modes to do so. If the melee Strike hits, you gain a +1 circumstance bonus to the attack roll with the ranged Strike. Each attack counts toward your multiple attack penalty, but your multiple attack penalty doesn't increase until you've made both attacks. If both Strikes hit, you deal an additional "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "damageType": "bleed"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the enemy, and they're "
          },
          {
            "type": "ref",
            "id": "943dfd55-ad09-5abf-9138-95a6149d3302"
          },
          {
            "type": "text",
            "text": " until this persistent bleed damage ends."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.NYR2IdfUiHevdt1V"
    },
    "data": {
      "cost": "two",
      "category": "offensive"
    }
  },
  {
