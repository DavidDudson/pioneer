    "kind": "action",
    "slug": "action:wind-them-up",
    "name": "Wind Them Up",
    "rarity": "common",
    "traits": ["gunslinger"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "page": 108,
        "aon": "https://2e.aonprd.com/Actions.aspx?ID=1456"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Should foes parry your blade or dodge your bullets? Neither—they should be watching their purse. Make a melee Strike with your combination weapon, and then attempt a Thievery check with a –5 penalty to "
          },
          {
            "type": "ref",
            "id": "4722e9b3-995d-5553-8034-087950993837"
          },
          {
            "type": "text",
            "text": " from your target; you can't Steal closely guarded objects or objects that would take a long time to pilfer. You don't need a free hand to attempt to Steal something in this manner. If your Thievery check succeeds, the target is "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " against your ranged attacks until the start of your next turn, and you don't trigger reactions that are normally triggered by movement or a ranged attack. These effects occur even if your target has no objects to Steal."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.actionspf2e.Item.UyMkWfVqdabLTgkH"
    },
    "data": {
