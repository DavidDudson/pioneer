            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Several of your thorns break off and hook into your attacker's body. You deal "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "ceil(@level/2)d8",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage to the triggering creature. It attempts a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " save against the higher of your class DC or spell DC. On a critical failure, the creature also takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d4+ceil(@level/2)-1",
                "damageType": "bleed"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage as your thorns embed in its flesh."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "At 3rd level, and every 2 levels thereafter, this damage increases by 1d8, and the persistent bleed damage increases by 1."
