  {
    "id": "6c693aed-2460-5916-a82f-2a49b2b662fb",
    "pack": "impossible-lands",
    "kind": "action",
    "slug": "action:mana-wastes-mutant-energy-blast",
    "name": "(Mana Wastes Mutant) Energy Blast",
    "rarity": "common",
    "traits": ["primal"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose an energy type; this ability gains that energy type as a trait. The mutant gains some sort of physical alteration to their shape that suggests how they trigger their energy blast, be it numerous pustules on their body, an extra limb, or an additional opening in their throat to exhale the blast as a breath weapon. Choose whether the mutant creates a "
          },
          {
            "type": "template",
            "shape": "line",
            "size": 60
          },
          {
            "type": "text",
            "text": " of energy or a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": " of energy when they activate this ability. The energy deals 1d6 damage per level with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "basic": true
          },
          {
            "type": "text",
            "text": " save. The mutant can't use Energy Blast again for 1d4 rounds."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.bestiary-family-ability-glossary.Item.Hy7bO4TSNoQNMzA6"
    },
    "data": {
      "cost": "two",
      "category": "offensive"
    }
  },
