    "kind": "heritage",
    "slug": "heritage:athamasi",
    "name": "Athamasi",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=211",
        "page": 42
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have a set of small secondary arms adapted for climbing and hanging from trees. You can't hold or retrieve objects with these limbs, but you can Climb or "
          },
          {
            "type": "ref",
            "id": "3e3e8499-292e-5d45-854b-f79ad765f6c0"
          },
          {
            "type": "text",
            "text": " even if one or both of your primary hands are full. You aren't "
          },
          {
            "type": "ref",
            "id": "071324e5-bb4c-5ed2-9e2f-28185b65ded7"
          },
          {
            "type": "text",
            "text": " while Climbing."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.CnCFZfuKzAYqy61e"
    },
    "data": {
