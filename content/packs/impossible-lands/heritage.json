    }
  },
  {
    "id": "1b9ede71-d4db-5a1c-886c-bdf4ddbdcef8",
    "pack": "impossible-lands",
    "kind": "heritage",
    "slug": "heritage:bandaagee-vanara",
    "name": "Bandaagee Vanara",
    "rarity": "common",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=221",
        "page": 54
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your family is one of many who claims to be descended from the regal vanara peacekeeping family called the Bandaagee. Bandaagee are the most common kind of vanaras. You're very familiar with the trappings of civilization and move easily through the most crowded communities. You ignore difficult terrain from crowds."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.heritages.Item.ClshvrjvBTMm3INX"
    },
