    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=1792"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " envision"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The vengeful wails of a revenant, barely contained in this rattling jar, infuse your magic with all of their spite and malice. If a target fails its saving throw against your "
          },
          {
            "type": "ref",
            "id": "bbe99dfe-9c98-5d6d-b637-abcffa6240e2"
          },
          {
            "type": "text",
            "text": " spell after you've added this catalyst, it takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d6",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " of the type chosen for the spell ("
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "2d6",
                "category": "persistent"
              }
            ]
          },
          {
            "type": "text",
            "text": " if it critically fails)."
          }
        ]
      }
    ],
    "rules": [],
