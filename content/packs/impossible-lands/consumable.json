    "slug": "consumable:alkenstar-ice-wine",
    "name": "Alkenstar Ice Wine",
    "level": 5,
    "rarity": "uncommon",
    "traits": ["alchemical", "consumable", "drug", "ingested", "poison", "vitality"],
    "sources": [
      {
        "kind": "book",
        "book": "impossible-lands",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=1788"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This bottle of delicately sweet ice wine has the properties of alcohol. Made exclusively from grapes frozen in the Mana Wastes' erratic surge storms, Alkenstar ice wine finds a ready market among Geb, though undead are still immune to the drug's listed effects."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The listed price is for a mediocre vintage, but finer vintages are higher level and commensurately more expensive."
          }
        ]
      }
    ],
    "rules": [],
