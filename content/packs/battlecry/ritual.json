  {
    "id": "8ebece9c-2c74-5c22-8c78-078b1826345b",
    "pack": "battlecry",
    "kind": "ritual",
    "slug": "ritual:secure-siege-weapons",
    "name": "Secure Siege Weapons",
    "level": 3,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "battlecry",
        "page": 95,
        "aon": "https://2e.aonprd.com/Rituals.aspx?ID=214"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You strengthen your army's siege weapons and prevent them from being commandeered by enemy hands. At the successful conclusion of the ritual, each allied siege weapon in the area gains an increase to its Hardness and Hit Points for the duration. In addition, enemies who try to operate or move an affected mounted siege weapon or pick up an affected portable siege weapon must succeed at a "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": 20
          },
          {
            "type": "text",
            "text": " saving throw or be forced to roll twice and take the worse result on any check to Load or Strike with the siege weapon; this is a misfortune effect. Finally, if an enemy Launches an affected siege weapon, their targets can roll twice and take the better result for any resulting saving throw; this is a fortune effect."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Each affected siege weapon's Hardness increases by 10, and its maximum Hit Points increase by an amount equal to three times the siege weapon's level."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Each affected siege weapon's Hardness increases by 5, and its maximum Hit Points increase by an amount equal to twice the siege weapon's level."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ritual has no effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " All allied siege weapons in the area gain the broken condition."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.a9og2ZYfr8kAeltU"
    },
    "data": {
      "rank": 3,
      "time": {
        "type": "time",
        "count": 2,
        "unit": "hour"
      },
      "area": {
        "shape": "burst",
        "size": 250
      },
