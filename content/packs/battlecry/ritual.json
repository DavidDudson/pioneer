  {
    "id": "cede0089-d915-52ed-a42d-5d12ae4ce386",
    "pack": "battlecry",
    "kind": "ritual",
    "slug": "ritual:reinforced-rations",
    "name": "Reinforced Rations",
    "level": 4,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "battlecry",
        "page": 94,
        "aon": "https://2e.aonprd.com/Rituals.aspx?ID=213"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An army marches on its stomach, and a city under siege is often cut off from its normal food supplies, so preserving comestibles is of utmost importance during a prolonged conflict. You enchant food and water in the area to not decay or spoil for the duration and grant better nourishment according to the success of the ritual. At the end of the duration, the food and water return to the state they were before the ritual."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A single meal of the affected food contains enough nourishment to sustain a typical human for 3 days."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " A single meal of the affected food contains enough nourishment to sustain a typical human for 1 day."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ritual has no effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The food and water in the area rots and spoils rapidly, releasing noxious fumes. Each living creature in the area becomes "
          },
          {
            "type": "ref",
            "id": "5cfa1065-86f1-5622-a7de-7c91351dcdb8",
            "label": "Sickened 2"
          },
          {
            "type": "text",
            "text": " and can't reduce the value of this condition for 24 hours."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.2LsiiZZIZEKD23VQ"
    },
