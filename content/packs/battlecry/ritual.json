  {
    "id": "0993de64-4f68-537f-bb33-e8b611bacf80",
    "pack": "battlecry",
    "kind": "ritual",
    "slug": "ritual:army-of-shadows",
    "name": "Army of Shadows",
    "level": 2,
    "rarity": "uncommon",
    "traits": ["darkness"],
    "sources": [
      {
        "kind": "book",
        "book": "battlecry",
        "page": 93,
        "aon": "https://2e.aonprd.com/Rituals.aspx?ID=208"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You conjure a squadron of shadows to surge forth and plunge your enemies into darkness. All non-magical light sources in the area are extinguished and can't be lit again during the duration. Any dim light from sources outside the area can't penetrate the area, and sources of bright light from outside the area shed only dim light into the area. The shadows also attempt to counteract any magical light in the area, with a counteract rank of 2 and a counteract modifier of +13. If a new magical light effect enters the area during the duration, the shadows immediately attempt to counteract it."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows are particularly powerful. Their counteract rank increases by 1, and they gain a +2 circumstance bonus to their counteract check."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows are of normal power."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The ritual has no effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows instead cling to you and obscure your vision, rendering you "
          },
          {
            "type": "ref",
            "id": "5d63458a-cde5-5d64-8fea-b920f04f36b7"
          },
          {
            "type": "text",
            "text": " for 24 hours."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (4th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows have a counteract rank of 4 and a counteract modifier of +18."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (6th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows have a counteract rank of 6 and a counteract modifier of +24."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (8th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The shadows have a counteract rank of 8 and a counteract modifier of +29."
          }
        ]
      }
    ],
