          {
            "type": "text",
            "text": "Strength",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " or "
          },
          {
            "type": "text",
            "text": "Dexterity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": ", and one is a free attribute boost."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You're trained in the Athletics skill and the Piloting Lore skill. You gain the "
