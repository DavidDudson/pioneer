    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Consisting of long steel spikes projecting from light barding, anti-dragon barding helps to protect vulnerable mounts and livestock from massive aerial predators, including dragons, griffons, and rocs."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An animal companion wearing anti-dragon barding gains a +2 item bonus to its Fortitude DC and Reflex DC against attempts to Grapple, Reposition, Shove, or Trip it, and a creature that successfully Grapples the animal companion takes "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "1d4",
                "damageType": "piercing"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage."
          }
        ]
      }
    ],
