            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You take 2 move actions, each of which can be a Fly or Stride. If you don't have a fly Speed, you gain a 20-foot fly Speed for Fly actions from this activation."
          }
        ]
      },
      {
        "type": "rule"
      },
