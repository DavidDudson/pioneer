[
  {
    "id": "d8a62247-9202-5c64-b2d2-e3abda8efaae",
    "pack": "draconic-codex",
    "kind": "weapon",
    "slug": "weapon:dragons-tongue",
    "name": "Dragon's Tongue",
    "level": 11,
    "rarity": "uncommon",
    "traits": [],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "page": 222,
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4012"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This "
          },
          {
            "type": "text",
            "text": "+2 striking longspear",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": " was crafted by a renowned monster hunter, who designed the prototype from the bones and scales of a diabolic dragon. The drathyrican folds of a young dragon, the organ that generates their magical breath, are crucial to the operation of the spear. The mechanics of the weapon are largely based on an injection spear: when the safety is disengaged and a secondary lever is squeezed, it produces a magical effect like a dragon's breath from the hollow tip of the spear."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Breath of the Spear",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "two"
          },
          {
            "type": "text",
            "text": " (concentrate, manipulate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The dragon's tongue releases a burst of energy that manifests as a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": " dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "6d6"
              }
            ]
          },
          {
            "type": "text",
            "text": " damage with a "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": 28,
            "basic": true
          },
          {
            "type": "text",
            "text": " save. You can't use this activation again for 1d4 rounds. The damage type matches the breath of the dragon the weapon was made from, and this activation has the corresponding trait."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Craft Requirements",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The initial raw materials must include the drathyrican folds of a dragon."
          }
        ]
      }
    ],
