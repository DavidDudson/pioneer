[
  {
    "id": "7a62abbb-853b-5071-847e-16e6eba41507",
    "pack": "draconic-codex",
    "kind": "equipment",
    "slug": "equipment:dragon-pearl-draconic-codex",
    "name": "Dragon Pearl (Draconic Codex)",
    "level": 16,
    "rarity": "uncommon",
    "traits": ["invested", "magical"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4011"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When an irritant is caught within a dragon's scales, the dragon's body protects itself by coating the object in layers of dragon scale. Over time, it can form an item called a "
          },
          {
            "type": "text",
            "text": "dragon pearl",
            "marks": ["emphasis"]
          },
          {
            "type": "text",
            "text": ". Such pearls, hard and iridescent, are infused with draconic magic and can be powerful tools in the right hands. They're usually placed in an ornate setting on a pin or necklace. Wearing the dragon pearl grants you a +2 item bonus to Intimidation checks."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Pearlescent Shell",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You call protective power from the pearl to form a defensive barrier around yourself. You're affected by an 8th-rank "
          },
          {
            "type": "ref",
            "id": "810878b5-e264-5dff-a417-e8ee5bbe60ea"
          },
          {
            "type": "text",
            "text": " spell, which takes on the appearance of shimmering translucent dragon scales. The field has resistance 15 to one damage type related to the dragon the pearl came from. When you activate the pearl, you choose the type from all types the dragon has immunity or resistance to plus a type based on their tradition: force for arcane, spirit for divine, mental for occult, or poison for primal."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "FlatModifier",
        "selectors": ["skill:intimidation"],
        "type": "item",
        "value": 2
      }
    ],
    "externalIds": {
      "foundry": "Compendium.pf2e.equipment-srd.Item.38O6OrDAFq8K6buR"
    },
    "data": {
      "price": {
        "coins": {
          "gp": 9000
        }
      },
      "bulk": "light",
      "activations": [
        {
          "slug": "pearlescent-shell",
          "name": "Pearlescent Shell",
          "frequency": {
            "max": 1,
            "per": "day"
          }
        }
      ],
      "usage": {
        "type": "worn"
      }
    }
