    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "aon": "https://2e.aonprd.com/Equipment.aspx?ID=4016"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have exchanged your voice for the authority and breath of your bound dragon. Your voice echoes with the dragon's idiosyncrasies. You can cast fear as an innate spell once per day, with the spell's tradition matching that of your bound dragon."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Once per day, from any distance, your bound dragon can choose to take control of your voice. They dictate everything you say (or don't say) for up to 10 minutes. They can choose to speak in any language you or they know, though they can't use your voice to cast spells or activate items."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Activate—Breath of the Dragon",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "action-cost",
            "cost": "one"
          },
          {
            "type": "text",
            "text": " (concentrate)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Frequency",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " once per day"
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Effect",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " You exhale a torrent of energy in a "
          },
          {
            "type": "template",
            "shape": "cone",
            "size": 30
          },
          {
            "type": "text",
            "text": " or a "
          },
          {
            "type": "template",
            "shape": "line",
            "size": 60
          },
          {
            "type": "text",
            "text": ", dealing "
          },
          {
            "type": "damage",
            "instances": [
              {
                "formula": "(@level)d6"
              }
            ],
            "label": "1d6 damage per level"
          },
          {
            "type": "text",
            "text": ". Each creature in the area must attempt a basic saving throw against the higher of your class DC or spell DC. You can't use this ability again for 1d4 rounds. The area, damage type, and type of saving throw match those of your Draconic Benefactor. This ability has the trait associated with the type of damage it deals."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "check",
            "statistic": "save:fortitude",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "check",
            "statistic": "save:reflex",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "check",
            "statistic": "save:will",
            "dc": {
              "against": "class-or-spell-dc"
            },
            "basic": true
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Oathbreaker's Calamity",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " Should either party break the oath, your throat and mouth become swollen and elongated, preventing you from speaking any language but Draconic and causing any use of the Dragon Breath ability granted by this pact to also damage you. The dragon becomes "
          },
          {
            "type": "ref",
            "id": "4271da2e-7225-5aa7-9807-c499d8af6a5a"
          },
          {
            "type": "text",
            "text": ", but call still hear your voice."
          }
        ]
      }
