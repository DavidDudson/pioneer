  {
    "id": "41dbab35-3606-5939-8954-5f3532c77def",
    "pack": "draconic-codex",
    "kind": "equipment",
    "slug": "equipment:pact-of-the-herald-and-host",
    "name": "Pact of the Herald and Host",
