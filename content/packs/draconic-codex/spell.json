    "name": "Armor of Thorn and Claw",
    "level": 1,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate", "morph"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "page": 224,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2524"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Razor-sharp thorns and claws erupt from your skin or scales. Whenever a creature touches you or hits you with a melee unarmed attack, it takes 1 piercing damage. Additionally, if you become "
          },
          {
            "type": "ref",
            "id": "cab530ff-ca20-5f0a-8a5e-b9fdb322b146"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "ref",
            "id": "b374c4c9-d230-5167-8878-38e08932a071"
          },
          {
            "type": "text",
            "text": ", or otherwise held "
          },
          {
            "type": "ref",
            "id": "64278392-4910-5a32-b819-56f6e54952dd"
          },
          {
            "type": "text",
            "text": " in a creature's grasp, such as by being engulfed or swallowed, the creature takes (ceil(@item.rank / 2))d4[persistent,bleed] damage."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+2)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The piercing damage increases by 2, and the persistent bleed damage increases by 1d4."
          }
        ]
      }
    ],
