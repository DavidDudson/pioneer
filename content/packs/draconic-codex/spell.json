  {
    "id": "f3e2575c-6f8d-5b5b-a8d4-1e30419dd8c4",
    "pack": "draconic-codex",
    "kind": "spell",
    "slug": "spell:cloud-current",
    "name": "Cloud Current",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["air", "concentrate", "manipulate", "water"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "page": 224,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2527"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Air and water vapor combine into a great cloud that funnels a powerful current within it. The eddies make the cloud appear from a distance to be a group of cloud dragons tumbling through the sky. The cloud is up to 30 feet wide, 30 feet tall, and 10 miles long. It runs parallel to the ground, and the nearest end of it must be within range and at least 100 feet above the ground. The current travels in a direction you choose when you Cast the Spell, and the travel Speed of creatures flying through the cloud in that direction is doubled. You can Dismiss the cloud."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (6th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The duration is 8 hours, and the cloud can be up to 50 feet wide and 100 miles long."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (8th)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As 6th, and travel speed is quadrupled."
          }
        ]
      }
    ],
    "rules": [],
    "externalIds": {
      "foundry": "Compendium.pf2e.spells-srd.Item.s7kVnr0EdljCamuR"
    },
