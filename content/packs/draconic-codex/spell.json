  {
    "id": "313c5466-8d35-5edd-bf7b-0cb01b8d0b9f",
    "pack": "draconic-codex",
    "kind": "spell",
    "slug": "spell:earth-and-sky",
    "name": "Earth and Sky",
    "level": 6,
    "rarity": "uncommon",
    "traits": ["air", "concentrate", "earth", "manipulate"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "page": 225,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2530"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You erupt into the air with the force of a dragon taking flight, launching nearby creatures into the sky with you. This spell has no effect unless you're on solid ground when you cast it. You fly directly upward, up to 100 feet into the air. When the spell ends, you safely float to the ground, as gentle landing. Every other creature in the area when you Cast this Spell must attempt a Fortitude saving throw."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is launched the same distance into the air as you, then falls."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is launched the same distance into the air as you, then falls and can't "
          },
          {
            "type": "ref",
            "id": "d2f5524b-be46-55b7-8b1d-12d0a9d1dbb2",
            "label": "Arrest its Fall"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but the creature takes twice as much damage from falling."
          }
        ]
      }
    ],
