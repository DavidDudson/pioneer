  {
    "id": "51c50f31-edfc-5884-9adb-9c3beaa94e77",
    "pack": "draconic-codex",
    "kind": "spell",
    "slug": "spell:channel-arrogance",
    "name": "Channel Arrogance",
    "level": 4,
    "rarity": "uncommon",
    "traits": ["concentrate", "manipulate", "mental"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "page": 224,
        "aon": "https://2e.aonprd.com/Spells.aspx?ID=2526"
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You channel your heightened sense of self-worth into a creature, forcing them to acknowledge your true worth. You can Cast this Spell using 1 action if you know the target isn't worthy of you spending your time to generate the full force of this spell, or using 3 actions if you can't possibly hold back the majesty of your presence and must flood the target with your full attention."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The target takes 5d10 mental damage and other effects depending on its Will saving throw. If you Cast the Spell using 1 action, the target gets a result one degree of success better than it rolled."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The creature is unaffected."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Success",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes half damage and is "
          },
          {
            "type": "ref",
            "id": "88ca1b7b-d5de-5978-9ff4-258c9aadef1a"
          },
          {
            "type": "text",
            "text": " with you for 1 round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The target takes full damage and is fascinated with you for 1 round. While fascinated with you, the target must succeed at a "
          },
          {
            "type": "check",
            "statistic": "flat",
            "dc": 5
          },
          {
            "type": "text",
            "text": " when attempting to Cast a Spell or use an action with the auditory trait. On a failure, the action is disrupted as the target blurts praise for you instead of saying what it intended."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Critical Failure",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " As failure, but double damage and the effect lasts for 1 minute."
          }
        ]
      },
      {
        "type": "rule"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heightened (+1)",
            "marks": ["strong"]
          },
          {
            "type": "text",
            "text": " The damage increases by 1d10."
          }
        ]
      }
    ],
