    "slug": "heritage:fey-dragonet",
    "name": "Fey Dragonet",
    "rarity": "common",
    "traits": ["fey"],
    "sources": [
      {
        "kind": "book",
        "book": "draconic-codex",
        "aon": "https://2e.aonprd.com/Heritages.aspx?ID=422",
        "page": 210
      }
    ],
    "description": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You have a brightly colored body with gleaming scales that become more lustrous as you age, and iridescent butterfly wings. You can change the coloration and pattern of your wings with a single action to let you blend into an area."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "When your wings match your environment, you gain a +2 circumstance bonus to Stealth checks until your surroundings shift in coloration or pattern. You gain the fey trait and add Fey to your list of known languages."
          }
        ]
      }
    ],
    "rules": [
      {
        "key": "RollOption",
        "option": "option:fey-dragonet-wing-color",
        "toggleable": true,
        "display": {
          "label": "Fey Dragonet — Wings match environment"
        }
      },
      {
        "key": "FlatModifier",
        "selectors": ["skill:stealth"],
