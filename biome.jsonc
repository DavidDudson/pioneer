{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Biome lints CSS only (frontier's stylesheets): oxlint owns TypeScript,
  // ESLint owns Angular templates, bun fmt owns formatting.
  "files": { "includes": ["libs/frontier/src/styles/**/*.css", "apps/web/src/**/*.css"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "javascript": { "linter": { "enabled": false } },
  "json": { "linter": { "enabled": false } },
  "css": {
    "parser": { "tailwindDirectives": true },
    "linter": { "enabled": true },
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" },
  },
}
