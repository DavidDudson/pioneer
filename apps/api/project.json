{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:api", "type:app", "platform:server"],
  "targets": {
    "serve": {
      "continuous": true,
      "command": "PORT=${API_PORT:-3000} bun --watch apps/api/src/main.dev.ts"
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "bun build apps/api/src/main.ts --compile --minify --sourcemap --target={args.target} --outfile dist/apps/api/pioneer-api",
        "target": "bun"
      },
      "configurations": {
        "linux-x64": {
          "target": "bun-linux-x64"
        },
        "linux-arm64": {
          "target": "bun-linux-arm64"
        }
      }
    },
    "db-generate": {
      "command": "drizzle-kit generate --config apps/api/drizzle.config.ts"
    },
    "db-migrate": {
      "command": "bun apps/api/src/main.ts migrate"
    },
    "verify-dev-free": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-dev-free.ts",
        "{workspaceRoot}/tools/dev-markers.ts",
        "{workspaceRoot}/libs/identity/dev-users/src/**/*"
      ],
      "command": "bun tools/check-dev-free.ts dist/apps/api"
    }
  }
}
