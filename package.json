{
  "name": "@pioneer/source",
  "version": "0.0.0",
  "private": true,
  "description": "Pathfinder 2e character manager",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nx serve web --port=${WEB_PORT:-4200}",
    "check": "nx run-many -t lint lint-templates typecheck test build verify-styles && bun run lint:workspace && bun run test:tools",
    "lint:workspace": "knip --treat-config-hints-as-errors && bun run check:messages && typos && rumdl check . && taplo check && taplo fmt --check && biome lint --error-on-warnings && oxlint tools && oxfmt --check .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "affected": "nx affected -t lint lint-templates typecheck test build verify-styles",
    "test:tools": "bun test tools",
    "check:messages": "bun tools/check-message-keys.ts"
  },
  "dependencies": {
    "@angular/aria": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-messageformat": "8.4.0",
    "@lucide/angular": "1.52.0",
    "@tanstack/angular-hotkeys": "0.13.0",
    "@tanstack/angular-pacer": "0.26.0",
    "@tanstack/angular-query-experimental": "5.104.1",
    "@tanstack/angular-table": "9.2.6",
    "@tanstack/angular-virtual": "6.0.6",
    "@tanstack/charts": "1.0.0",
    "arctic": "3.7.0",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.5",
    "tslib": "2.8.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "2.8.0",
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular/animations": "22.2.0",
    "@angular/build": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/language-service": "22.2.0",
    "@biomejs/biome": "2.5.14",
    "@faker-js/faker": "10.6.0",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@storybook/angular": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "angular-eslint": "22.5.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-security": "4.1.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "nx": "23.2.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.28",
    "randexp": "0.5.3",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.0",
    "vitest": "5.0.2",
    "zod-schema-faker": "2.1.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": []
}
