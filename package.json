{
  "name": "@pioneer/source",
  "version": "0.0.0",
  "private": true,
  "description": "Pathfinder 2e character manager",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "nx serve web --port=${WEB_PORT:-4200}",
    "check": "nx run-many -t lint lint-templates typecheck test test-storybook build verify-styles verify-dev-free && bun run lint:workspace && bun run typecheck:tools && bun run test:tools",
    "ci:lint": "nx run-many -t lint lint-templates && bun run lint:workspace && bun run typecheck:tools && bun run test:tools",
    "ci:build": "nx affected -t typecheck build verify-styles verify-dev-free",
    "ci:test": "nx run-many -t test",
    "ci:storybook": "nx run-many -t test-storybook",
    "lint:workspace": "hadolint Dockerfile && tofu fmt -check -recursive infra && knip --treat-config-hints-as-errors && bun run check:messages && bun run check:components && bun run check:contrast && typos && rumdl check . && taplo check && taplo fmt --check && biome lint --error-on-warnings && oxlint tools eslint.config.ts && bun fmt --check",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "affected": "nx affected -t lint lint-templates typecheck test test-storybook build verify-styles verify-dev-free",
    "test:tools": "bun test tools",
    "typecheck:tools": "tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p libs/frontier/scripts/tsconfig.json",
    "bench": "bun tools/bench.ts",
    "check:messages": "bun tools/check-message-keys.ts",
    "check:components": "bun tools/check-component-coverage.ts",
    "check:contrast": "bun tools/check-token-contrast.ts",
    "content:coverage": "bun tools/content-coverage.ts",
    "content:aon": "bun tools/aon-sources/main.ts",
    "content:aon-pages": "bun tools/aon-pages/main.ts",
    "content:pages-propose": "bun tools/propose-pages.ts",
    "content:aon-propose": "bun tools/propose-aon.ts",
    "content:creature-actions-propose": "bun tools/propose-creature-actions.ts",
    "content:granted-actions-propose": "bun tools/propose-granted-actions.ts",
    "content:remaster-audit": "bun tools/audit-remaster.ts",
    "content:seed": "bun apps/api/src/main.ts content-seed",
    "content:prerequisites": "bun tools/enrich-prerequisites.ts",
    "content:enrich": "bun tools/enrich-content.ts",
    "content:staves": "bun tools/enrich-staves.ts",
    "content:triggers": "bun tools/enrich-triggers.ts"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "@angular/aria": "22.2.5",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-messageformat": "8.4.0",
    "@lucide/angular": "1.63.0",
    "@tanstack/angular-hotkeys": "0.17.0",
    "@tanstack/angular-pacer": "0.27.0",
    "@tanstack/angular-query-experimental": "5.105.0",
    "@tanstack/angular-table": "9.3.1",
    "@tanstack/angular-virtual": "6.0.6",
    "@tanstack/charts": "1.1.0",
    "arctic": "3.7.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.6",
    "tslib": "2.8.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "2.9.2",
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular/animations": "22.2.4",
    "@angular/build": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@biomejs/biome": "2.6.4",
    "@faker-js/faker": "10.6.0",
    "@nx/angular": "24.0.2",
    "@nx/devkit": "24.0.2",
    "@nx/oxlint": "24.0.2",
    "@nx/storybook": "24.0.2",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/angular": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "angular-eslint": "22.6.0",
    "domhandler": "6.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "htmlparser2": "12.0.0",
    "jsdom": "30.1.3",
    "knip": "6.44.0",
    "nx": "24.0.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "randexp": "0.6.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.2",
    "zod-schema-faker": "3.0.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
