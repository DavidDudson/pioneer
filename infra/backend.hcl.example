# Copy to backend.hcl (gitignored) and fill in; then `tofu init -backend-config=backend.hcl`.
# R2's S3 endpoint for your Cloudflare account, and an AWS CLI profile holding an R2 API token's S3 keys
# (Object Read & Write on the pioneer-tofu-state bucket only).
endpoints = { s3 = "https://<cloudflare-account-id>.r2.cloudflarestorage.com" }
profile   = "pioneer-r2"
