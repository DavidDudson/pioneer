# Copy to .env (gitignored; Bun loads it). The dev shell sets DATABASE_URL and PUBLIC_ORIGIN.
#
# Sign in with GitHub: create an OAuth app at https://github.com/settings/developers with
# callback URL <PUBLIC_ORIGIN>/api/auth/github/callback, e.g. http://localhost:4202/api/auth/github/callback
# for workspace ws2. Leave unset to run without sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
