{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/web/src/main.ts",
    "apps/edge/src/main.ts",
    "apps/api/drizzle.config.ts",
    "libs/*/src/index.ts",
    "libs/*/*/src/index.ts",
    "libs/*/*/src/testing/index.ts",
    "libs/frontier/src/data.ts",
    "libs/frontier/scripts/*.ts",
    "tools/**/*.ts",
    "**/*.{test,spec}.ts",
    "apps/web/src/styles.css",
    "apps/web/src/app/environment.development.ts",
    "apps/api/src/main.dev.ts"
  ],
  "project": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "tools/**/*.ts",
    "libs/frontier/src/styles/*.css",
    "apps/web/src/*.css",
    "apps/storybook/src/*.mdx"
  ],
  "ignoreBinaries": ["typos", "rumdl", "taplo", "hadolint", "tofu"],
  "ignoreDependencies": ["@angular/language-service", "@socketsecurity/bun-security-scanner"],
  "nx": true,
  "angular": false,
  "storybook": {
    "config": ["libs/*/.storybook/main.ts", "libs/*/*/.storybook/main.ts", "apps/storybook/.storybook/main.ts"],
    "entry": ["libs/*/.storybook/preview.ts", "libs/*/*/.storybook/preview.ts", "libs/**/*.stories.ts"]
  }
}
