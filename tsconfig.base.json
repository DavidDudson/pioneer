{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "importHelpers": true,
    "useDefineForClassFields": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    "types": [],
    "paths": {
      "@pioneer/shared/kernel": ["./libs/shared/kernel/src/index.ts"],
      "@pioneer/shared/kernel/testing": ["./libs/shared/kernel/src/testing/index.ts"],
      "@pioneer/shared/server": ["./libs/shared/server/src/index.ts"],
      "@pioneer/shared/server/testing": ["./libs/shared/server/src/testing/index.ts"],
      "@pioneer/shared/web": ["./libs/shared/web/src/index.ts"],
      "@pioneer/rules/sdk": ["./libs/rules/sdk/src/index.ts"],
      "@pioneer/rules/sdk/testing": ["./libs/rules/sdk/src/testing/index.ts"],
      "@pioneer/rules/dice": ["./libs/rules/dice/src/index.ts"],
      "@pioneer/rules/dice/testing": ["./libs/rules/dice/src/testing/index.ts"],
      "@pioneer/rules/catalog": ["./libs/rules/catalog/src/index.ts"],
      "@pioneer/content/player-core": ["./libs/content/player-core/src/index.ts"],
      "@pioneer/content/monster-core": ["./libs/content/monster-core/src/index.ts"],
      "@pioneer/character/domain": ["./libs/character/domain/src/index.ts"],
      "@pioneer/character/domain/testing": ["./libs/character/domain/src/testing/index.ts"],
      "@pioneer/character/application": ["./libs/character/application/src/index.ts"],
      "@pioneer/character/infrastructure": ["./libs/character/infrastructure/src/index.ts"],
      "@pioneer/character/feature": ["./libs/character/feature/src/index.ts"],
      "@pioneer/legal/feature": ["./libs/legal/feature/src/index.ts"],
      "@pioneer/frontier": ["./libs/frontier/src/index.ts"],
      "@pioneer/frontier/data": ["./libs/frontier/src/data.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
