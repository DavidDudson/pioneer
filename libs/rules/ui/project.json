{
  "name": "rules-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/rules/ui/src",
  "prefix": "pio",
  "tags": ["scope:rules", "type:ui", "platform:web"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "web:build:development",
        "tsConfig": "libs/rules/ui/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["libs/rules/ui/src/test-setup.ts"]
      }
    },
    "storybook": {
      "options": {
        "port": 6008
      }
    },
    "test-storybook": {
      "cache": true,
      "parallelism": false,
      "inputs": [
        "default",
        "^production",
        {
          "env": "PLAYWRIGHT_BROWSERS_PATH"
        },
        {
          "env": "PLAYWRIGHT_DRIVER_VERSION"
        },
        "{workspaceRoot}/libs/frontier/.storybook/storybook-project.ts"
      ],
      "command": "vitest run --config libs/rules/ui/.storybook/vitest.config.ts",
      "configurations": {
        "shard-1": { "command": "vitest run --config libs/rules/ui/.storybook/vitest.config.ts --shard=1/3" },
        "shard-2": { "command": "vitest run --config libs/rules/ui/.storybook/vitest.config.ts --shard=2/3" },
        "shard-3": { "command": "vitest run --config libs/rules/ui/.storybook/vitest.config.ts --shard=3/3" }
      }
    }
  }
}
