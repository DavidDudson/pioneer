{
  "name": "play-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/play/ui/src",
  "prefix": "pio",
  "tags": ["scope:play", "type:ui", "platform:web"],
  "targets": {
    "storybook": {
      "options": {
        "port": 6009
      }
    },
    "test-storybook": {
      "cache": true,
      "parallelism": false,
      "inputs": [
        "default",
        "^production",
        {
          "env": "PLAYWRIGHT_BROWSERS_PATH"
        },
        {
          "env": "PLAYWRIGHT_DRIVER_VERSION"
        },
        "{workspaceRoot}/libs/frontier/.storybook/storybook-project.ts"
      ],
      "command": "vitest run --config libs/play/ui/.storybook/vitest.config.ts"
    }
  }
}
